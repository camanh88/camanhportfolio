---
import Photo from './Photo.astro';
import { cover } from '../lib/data';
// The floating pictures around the line. To swap them for new photos later, change `id`
// (any id from scripts/photos.mjs). x / y = position in the section (%), w = size, a = width / height,
// s = how far the picture drifts while scrolling (px, negative = moves the other way).
const pics = [
  { id: 'know-1', x: 5, y: 6, w: 1.35, a: 1.5, s: -170 },
  { id: 'skill-2', x: 25, y: 2, w: 0.85, a: 1, s: 120 },
  { id: 'know-2-1', x: 46, y: 4, w: 0.7, a: 0.625, s: -90 },
  { id: 'skill-4', x: 66, y: 7, w: 0.95, a: 0.667, s: 210 },
  { id: 'know-3', x: 85, y: 12, w: 1.05, a: 0.75, s: -150 },
  { id: 'skill-3', x: 10, y: 30, w: 0.8, a: 1.5, s: 260, mob: false },
  { id: 'know-4', x: 90, y: 36, w: 0.8, a: 0.6, s: -240, mob: false },
  { id: 'know-2-2', x: 3, y: 54, w: 1.25, a: 1.65, s: 150 },
  { id: 'skill-1', x: 83, y: 58, w: 1.0, a: 1, s: -120 },
  { id: 'skill-2', x: 20, y: 74, w: 0.8, a: 1, s: -210, mob: false },
  { id: 'know-1', x: 71, y: 77, w: 1.0, a: 1.5, s: 180 },
  { id: 'skill-3', x: 44, y: 88, w: 1.05, a: 1.5, s: -140 },
  { id: 'know-3', x: 6, y: 90, w: 0.85, a: 0.75, s: 230, mob: false },
  { id: 'skill-4', x: 91, y: 86, w: 0.75, a: 0.667, s: -170 },
  { id: 'know-4', x: 16, y: 61, w: 0.55, a: 0.6, s: 100, mob: false },
  { id: 'skill-1', x: 78, y: 22, w: 0.6, a: 1, s: 140, mob: false },
];
---
<section class="believe" aria-label={cover.quote} data-believe>
  <div class="field" aria-hidden="true">
    {pics.map((p, i) => (
      <div class={`pic${p.mob === false ? ' no-mob' : ''}`} style={`--x:${p.x}%;--y:${p.y}%;--w:${p.w};--a:${p.a};--s:${p.s};--d:${(i % 8) * 110}ms`}>
        <Photo id={p.id} alt="" sizes="160px" />
      </div>
    ))}
  </div>
  <div class="copy">
    <p class="line">{cover.quote}</p>
  </div>
  <p class="tag label">{cover.label}</p>
</section>

<style>
  .believe { position: relative; background: var(--paper); overflow: hidden; padding-bottom: clamp(5rem, 10vw, 9rem); }
  .field { position: absolute; inset: 0 0 clamp(5rem, 10vw, 9rem) 0; pointer-events: none; }
  .pic { --u: clamp(3.4rem, 8.2vw, 8.6rem); position: absolute; left: var(--x); top: var(--y); width: calc(var(--u) * var(--w)); aspect-ratio: var(--a);
    transform: translate3d(0, calc(var(--p, 0) * var(--s) * 1px), 0); will-change: transform; opacity: 0; transition: opacity 1.4s var(--ease) var(--d); }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(.92); }
  .believe.in .pic { opacity: 1; }
  .copy { position: sticky; top: 0; height: 100svh; display: grid; place-items: center; padding: 0 var(--gutter); pointer-events: none; z-index: 1; }
  /* the field is taller than the screen, so the line stays put while the pictures drift past it */
  .believe { min-height: 180svh; }
  .line { font-family: var(--script); font-size: clamp(3rem, 7.6vw, 6.4rem); line-height: 1.08; color: var(--tomato); text-align: center; max-width: 15ch; text-wrap: balance; }
  .tag { position: relative; z-index: 1; display: block; width: fit-content; margin: 0 auto; background: var(--oxblood); color: #fff; font-size: .8rem; letter-spacing: .18em; padding: 1rem 1.6rem; max-width: calc(100% - 2 * var(--gutter)); text-align: center; }
  .believe { display: flow-root; }
  .copy + .tag { margin-top: 2rem; }

  @media (max-width: 700px) {
    .no-mob { display: none; }
    .pic { --u: 4.2rem; }
    .believe { min-height: 170svh; }
  }
  @media (prefers-reduced-motion: reduce) { .pic { transform: none; transition: none; opacity: 1; } }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-believe]');
  if (el) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { el.classList.add('in'); io.disconnect(); } }), { threshold: 0.05 });
    io.observe(el);
    if (!reduce) {
      const pics = [...el.querySelectorAll<HTMLElement>('.pic')];
      const update = () => {
        const r = el.getBoundingClientRect();
        // 0 when the section enters at the bottom of the screen, 1 when it leaves at the top
        const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (r.height + innerHeight)));
        for (const pic of pics) pic.style.setProperty('--p', String(p - 0.5));
      };
      let raf = 0;
      addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
      addEventListener('resize', update);
      update();
    }
  }
</script>
