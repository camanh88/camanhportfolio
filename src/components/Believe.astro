---
import Photo from './Photo.astro';
import { cover } from '../lib/data';
import { imageMeta } from '../lib/data';

// A tight cloud of pictures around the line: a few bigger ones, some medium, many tiny.
// The pictures are existing photos for now; swap the ids in `source` (any id from scripts/photos.mjs) when new ones arrive.
// (Oct 27: the photo of the woman in yellow at the gate, ly-4-2, was taken out of the cloud.)
// Mostly food (Lam Yên, Mono, the kitchen), with people now and then (the gifting photos, the Lam Yên shoot, her own portraits).
const source = [
  'mono-1', 'ly-4-1', 'g-team', 'mono-12', 'ly-4-4', 'ly-7-1', 'mono-7', 'ly-5-pull', 'g-hug', 'ly-4-9',
  'mono-4', 'ly-4-3', 'know-2-1', 'mono-9', 'ly-4-8', 'mono-2', 'ly-71-b', 'mono-6', 'ly-5-balls', 'skill-2',
  'mono-11', 'ly-4-7', 'g-parcel', 'mono-8', 'ly-4-5', 'mono-3', 'ly-5-racks', 'g-choc', 'mono-10', 'ly-4-6',
  'mono-5', 'ly-73-d', 'know-3', 'mono-13', 'ly-5-still', 'g-book', 'skill-4', 'mono-1',
].filter((id) => imageMeta[id]);
const tiers = [
  { n: 5, w: [0.95, 1.25], r: [0.5, 0.78], speed: 150 },   // bigger
  { n: 13, w: [0.5, 0.7], r: [0.35, 1.0], speed: 100 },    // medium
  { n: 30, w: [0.17, 0.3], r: [0.3, 1.05], speed: 60 },    // tiny
];
// deterministic scatter (same on every build)
let seed = 26;
const rnd = () => { seed = (seed * 1664525 + 1013904223) % 4294967296; return seed / 4294967296; };
type Pic = { id: string; x: number; y: number; w: number; a: number; s: number; mob: boolean };
const pics: Pic[] = [];
let k = 0;
for (const t of tiers) {
  for (let i = 0; i < t.n; i++) {
    for (let tries = 0; tries < 80; tries++) {
      const ang = rnd() * Math.PI * 2;
      const r = t.r[0] + rnd() * (t.r[1] - t.r[0]);
      const x = 50 + Math.cos(ang) * r * 47;
      const y = 50 + Math.sin(ang) * r * 43;
      const w = t.w[0] + rnd() * (t.w[1] - t.w[0]);
      const gap = 2.2 + w * 7; // keep pictures apart, in % of the section
      const nearText = x > 22 && x < 74 && y > 38 && y < 60;
      const clash = pics.some((p) => Math.hypot(p.x - x, (p.y - y) * 0.9) < (gap + (2.2 + p.w * 7)) / 2);
      if (nearText || clash) continue;
      const id = source[k++ % source.length];
      const m = imageMeta[id];
      pics.push({ id, x, y, w, a: m ? m.width / m.height : 1, s: (rnd() < 0.5 ? -1 : 1) * (t.speed * (0.6 + rnd() * 0.8)), mob: t.n !== 30 || i % 2 === 0 });
      break;
    }
  }
}
---
<div class="wrap-believe">
  <section class="believe" aria-label={cover.quote} data-believe>
    <div class="copy">
      <div class="field" aria-hidden="true">
        {pics.map((p, i) => (
          <div class={`pic${p.mob ? '' : ' no-mob'}`} style={`--x:${p.x.toFixed(1)}%;--y:${p.y.toFixed(1)}%;--w:${p.w.toFixed(2)};--a:${p.a.toFixed(3)};--s:${Math.round(p.s)};--d:${(i % 12) * 90}ms`}>
            <Photo id={p.id} alt="" sizes="160px" />
          </div>
        ))}
      </div>
      <p class="line">{cover.quote}</p>
    </div>
  </section>
  <p class="tag label">{cover.label}</p>
</div>

<style>
  .wrap-believe { background: var(--paper); padding-bottom: clamp(5rem, 10vw, 9rem); }
  .believe { position: relative; min-height: 160svh; }
  .field { position: absolute; inset: 0; pointer-events: none; }
  .pic { --u: clamp(3.4rem, 8vw, 8.4rem); position: absolute; left: var(--x); top: var(--y); width: calc(var(--u) * var(--w)); aspect-ratio: var(--a);
    transform: translate3d(0, calc(var(--p, 0) * var(--s) * 1px), 0); will-change: transform; opacity: 0; transition: opacity 1.2s var(--ease) var(--d); }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .believe.in .pic { opacity: 1; }
  /* the line stays in the middle of the screen while the cloud drifts around it */
  .copy { position: sticky; top: 0; height: 100svh; display: grid; place-items: center; padding: 0 var(--gutter); pointer-events: none; overflow: hidden; }
  .line { position: relative; z-index: 1; }
  .line { font-family: var(--script); font-size: clamp(3rem, 7.2vw, 6.2rem); line-height: 1.08; color: var(--tomato); text-align: center; max-width: 15ch; text-wrap: balance; }
  .tag { display: block; width: fit-content; margin: clamp(2rem, 5vw, 4rem) auto 0; background: var(--oxblood); color: #fff; font-size: .8rem; letter-spacing: .18em; padding: 1rem 1.6rem; max-width: calc(100% - 2 * var(--gutter)); text-align: center; }

  @media (max-width: 700px) {
    .no-mob { display: none; }
    .pic { --u: 4rem; }
    .believe { min-height: 140svh; }
  }
  @media (prefers-reduced-motion: reduce) { .pic { transform: none; transition: none; opacity: 1; } }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-believe]');
  if (el) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { el.classList.add('in'); io.disconnect(); } }), { threshold: 0.05 });
    io.observe(el);
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const pics = [...el.querySelectorAll<HTMLElement>('.pic')];
      const update = () => {
        const r = el.getBoundingClientRect();
        // 0 when the section enters at the bottom of the screen, 1 when it leaves at the top
        const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (r.height + innerHeight)));
        for (const pic of pics) pic.style.setProperty('--p', String(p - 0.5));
      };
      let raf = 0;
      addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
      addEventListener('resize', update);
      update();
    }
  }
</script>
