---
import { inline } from '../lib/md';
import { ui, type Bar } from '../lib/data';
interface Group { heading?: string; level?: 3 | 4; intro?: string; bars: Bar[]; tone: 'forest' | 'mustard' | 'oxblood' }
interface Props { groups: Group[] }
const { groups } = Astro.props;

const mi = (s: string) => { const [y, m] = s.split('-').map(Number); return y * 12 + (m - 1); };
const all = groups.flatMap((g) => g.bars);
const min = Math.min(...all.map((b) => mi(b.start)));
const max = Math.max(...all.map((b) => mi(b.end)));
const total = max - min + 1;
const pos = (b: Bar) => ({ left: ((mi(b.start) - min) / total) * 100, width: ((mi(b.end) - mi(b.start) + 1) / total) * 100 });
const y0 = Math.floor(min / 12), y1 = Math.floor(max / 12);
const years = Array.from({ length: y1 - y0 + 1 }, (_, i) => y0 + i).map((y) => ({ y, left: Math.max(0, ((y * 12 - min) / total) * 100) }));
const lines = years.filter((y) => y.left > 0);
const parts = (label: string) => label.split(' · ');
---
<div class="tl" role="group" aria-label={ui.timeline}>
  <div class="row axis-row" aria-hidden="true">
    <div class="lab"></div>
    <div class="track axis">
      {years.map((y) => <span class="yr mono" style={`left:${y.left}%`}>{y.y}</span>)}
      {lines.map((y) => <i class="grid" style={`left:${y.left}%`}></i>)}
    </div>
  </div>
  {groups.map((g) => (
    <section class={`grp tone-${g.tone}`}>
      {g.heading && (g.level === 4 ? <h4 class="gh">{g.heading}</h4> : <h3 class="gh">{g.heading}</h3>)}
      {g.intro && <p class="gi" set:html={inline(g.intro)} />}
      <ul class="rows">
        {g.bars.map((b) => {
          const p = pos(b); const ps = parts(b.label);
          return (
            <li class="row reveal" data-type={b.type.toLowerCase()}>
              <p class="lab">
                <span class="role" set:html={inline(ps[0], { link: ['Full-stack Marketer'] })} />
                {ps.slice(1, -1).map((x) => <><span class="sep"> · </span><span class="mid" set:html={inline(x)} /></>)}
                {ps.length > 1 && <><span class="sep"> · </span><span class="when mono" set:html={inline(ps[ps.length - 1])} /></>}
              </p>
              <div class="track" aria-hidden="true">
                {lines.map((y) => <i class="grid" style={`left:${y.left}%`}></i>)}
                <span class="bar" style={`left:${p.left}%;width:${p.width}%`}></span>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>

<style>
  .tl { --grid: rgb(30 27 24 / .16); display: grid; gap: 2rem; }
  .grp { --bar: var(--forest); padding-left: .9rem; border-left: 3px solid var(--bar); }
  .tone-mustard { --bar: var(--mustard); }
  .tone-oxblood { --bar: var(--oxblood); }
  .gh { font-family: var(--display); font-weight: 600; font-size: 1.15rem; margin-bottom: .35rem; }
  .gi { margin-bottom: 1rem; max-width: 34rem; font-size: 1.02em; }
  .rows { display: grid; gap: 1.15rem; }
  .row { display: grid; gap: .45rem; }
  .lab { line-height: 1.35; font-size: 1.02rem; }
  .role { font-weight: 600; }
  .sep { color: var(--ink-soft); }
  .when { font-size: .74rem; white-space: nowrap; color: var(--ink-soft); }
  .track { position: relative; height: 1.1rem; }
  .grid { position: absolute; top: -.3rem; bottom: -.3rem; width: 1px; background: var(--grid); }
  .bar { position: absolute; top: 50%; height: 1.1rem; margin-top: -.55rem; background: var(--bar); border-radius: 2px; transform-origin: left center; transition: transform 1.1s var(--ease); }
  [data-type='part-time'] .bar { height: .8rem; margin-top: -.4rem; background: repeating-linear-gradient(135deg, var(--bar) 0 5px, color-mix(in srgb, var(--bar) 45%, var(--paper)) 5px 9px); }
  [data-type='contract'] .bar { height: .8rem; margin-top: -.4rem; border-radius: 99px; }
  .tone-mustard [data-type='contract'] .bar { box-shadow: inset 0 0 0 1.5px var(--ink); }
  :global(.js) .row.reveal:not(.in) .bar { transform: scaleX(0); }
  @media (prefers-reduced-motion: reduce) { :global(.js) .row.reveal:not(.in) .bar { transform: none; } }
  .axis-row { display: none; }

  @media (min-width: 900px) {
    .row { grid-template-columns: minmax(0, 21rem) 1fr; align-items: center; gap: 2rem; }
    .axis-row { display: grid; margin-bottom: -1rem; }
    .axis { height: 1.4rem; }
    .yr { position: absolute; top: 0; transform: translateX(-50%); font-size: .72rem; color: var(--ink-soft); }
    .yr:first-child { transform: none; }
    .axis .grid { top: 1.3rem; bottom: auto; height: .5rem; }
    .grp { padding-left: 1.25rem; }
  }
</style>
