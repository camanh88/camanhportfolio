---
import Photo from './Photo.astro';
import Torn from './Torn.astro';
import { cover, ui } from '../lib/data';
import { esc } from '../lib/md';
const quote = esc(cover.quote).replace(/&quot;(.+)&quot;/, '<em class="pull">&quot;$1&quot;</em>');
---
<header id="cover" class="cover">
  <div class="wrap cover-grid">
    <p class="stamp mono">{cover.label}</p>

    <div class="stage">
      <figure class="frame tape photo-main">
        <Photo id="cover-ca-1" sizes="(min-width: 960px) 52vw, 92vw" loading="eager" fetchpriority="high" />
      </figure>
      <figure class="frame tape blush photo-small">
        <Photo id="cover-ca-2" sizes="(min-width: 960px) 24vw, 40vw" loading="eager" />
      </figure>
      <h1 class="hero">{cover.hero}</h1>
    </div>

    <p class="quote" set:html={quote} />

    <a class="scroll" href="#contents">
      <span class="mono">{ui.scroll}</span>
      <svg viewBox="0 0 16 56" width="16" height="56" aria-hidden="true"><path d="M8 2v50M2 46l6 8 6-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
  <Torn color="var(--paper-deep)" seed={4} />
</header>

<style>
  .cover { position: relative; padding-top: clamp(1.5rem, 4vw, 3rem); background: var(--paper); }
  .cover-grid { display: grid; gap: 1.5rem; min-height: calc(100svh - 3rem); grid-template-rows: auto 1fr auto auto; align-content: start; padding-bottom: 1rem; }
  .stamp { justify-self: start; border: 1.5px solid var(--ink); padding: .45rem .8rem; transform: rotate(-2.5deg); font-size: .72rem; line-height: 1.3; background: var(--paper-light); }
  .stage { position: relative; padding-bottom: 8rem; }
  .photo-main { width: 90%; transform: rotate(-1.5deg); margin-left: 2%; }
  .photo-main img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .photo-small { position: absolute; right: 0; bottom: 5.5rem; width: 36%; transform: rotate(4deg); z-index: 1; }
  .photo-small img { aspect-ratio: 1; object-fit: cover; width: 100%; object-position: 70% 40%; }
  .hero { font-family: var(--script); font-weight: 400; color: var(--tomato); font-size: clamp(4.4rem, 21vw, 9rem); line-height: .78; letter-spacing: -.01em;
    position: absolute; left: 0; bottom: 0; z-index: 3; transform: rotate(-4deg); transform-origin: left bottom; max-width: 5.2em;
    -webkit-text-stroke: .1em var(--paper); paint-order: stroke fill; text-shadow: 0 .02em 0 rgb(30 27 24 / .12); }
  .quote { font-style: italic; font-size: clamp(1.35rem, 5.4vw, 1.9rem); line-height: 1.35; max-width: 30rem; }
  .quote :global(.pull) { font-style: normal; font-family: var(--display); font-weight: 300; color: var(--oxblood); }
  .scroll { display: inline-flex; flex-direction: column; align-items: center; gap: .4rem; justify-self: start; text-decoration: none; color: var(--ink-soft); min-height: 44px; padding: .25rem .5rem; margin-left: -.5rem; }
  .scroll svg { animation: nudge 2.4s var(--ease) infinite; }
  @keyframes nudge { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(8px); } }
  @media (prefers-reduced-motion: reduce) { .scroll svg { animation: none; } }

  @media (min-width: 960px) {
    .cover-grid { grid-template-columns: 5fr 7fr; grid-template-rows: auto 1fr auto; column-gap: 2rem; align-items: end; min-height: min(100svh, 62rem); padding-bottom: 2rem; }
    .stamp { grid-column: 1; grid-row: 1; align-self: start; }
    .stage { grid-column: 1 / -1; grid-row: 1 / 3; padding: 0; min-height: min(60svh, 36rem); margin-top: 1rem; }
    .photo-main { position: absolute; right: 0; top: 0; width: 62%; margin: 0; transform: rotate(1.4deg); }
    .photo-small { right: auto; left: 30%; bottom: 8%; width: 17%; transform: rotate(-5deg); }
    .hero { font-size: clamp(9rem, 16vw, 15rem); left: -1rem; bottom: 12%; transform: rotate(-5deg); max-width: none; white-space: nowrap; }
    .quote { grid-column: 1; grid-row: 3; align-self: end; font-size: 1.7rem; z-index: 4; position: relative; max-width: 28rem; }
    .scroll { grid-column: 2; grid-row: 3; justify-self: end; }
  }
</style>
