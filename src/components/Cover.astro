---
import Photo from './Photo.astro';
import { cover, ui } from '../lib/data';
// the "I believe" line is written letter by letter
const words = cover.quote.split(' ');
let n = 0;
const written = words.map((word) => [...word].map((ch) => ({ ch, i: n++ })));
---
<header id="cover" class="cover">
  <!-- row 1: full-width photo -->
  <div class="stage">
    <Photo id="cover-1" sizes="100vw" loading="eager" fetchpriority="high" />
    <a class="scroll label" href="#hello"><span>{ui.scroll}</span><i aria-hidden="true"></i></a>
  </div>

  <!-- row 2: the words -->
  <div id="hello" class="hello wrap">
    <h1 class="hero reveal">{cover.hero}</h1>
    <p class="sub reveal">{cover.sub}</p>
    <p class="write" data-write>
      <span class="sr-only">{cover.quote}</span>
      <span aria-hidden="true">
        {written.map((word, wi) => <><span class="w">{word.map((c) => <span class="c" style={`--i:${c.i}`}>{c.ch}</span>)}</span>{wi < written.length - 1 ? ' ' : ''}</>)}
      </span>
    </p>
    <p class="tag label reveal">{cover.label}</p>
  </div>
</header>

<style>
  .cover { background: var(--paper); }
  .stage { position: relative; background: var(--dark); height: 100svh; min-height: 28rem; overflow: hidden; }
  .stage :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 38%; }
  .stage::after { content: ''; position: absolute; inset: auto 0 0 0; height: 24%; background: linear-gradient(transparent, rgb(0 0 0 / .3)); pointer-events: none; }
  .scroll { position: absolute; z-index: 1; left: var(--gutter); bottom: 1.75rem; display: flex; align-items: center; gap: .9rem; color: #fff; text-decoration: none; }
  .scroll i { width: 3rem; height: 1px; background: currentColor; transition: width .4s var(--ease); }
  .scroll:hover i { width: 5rem; }

  .hello { text-align: center; padding: clamp(5rem, 14vw, 11rem) 0 var(--section); display: grid; justify-items: center; }
  .hero { font-size: clamp(3.4rem, 13vw, 11.5rem); line-height: .92; letter-spacing: -.035em; font-weight: 300; max-width: 12ch; text-wrap: balance; }
  .sub { font-family: var(--display); font-size: clamp(1.5rem, 3.4vw, 2.5rem); line-height: 1.25; margin-top: clamp(3rem, 7vw, 6rem); max-width: 26ch; text-wrap: balance; }
  /* handwritten line: each letter is drawn in from left to right, one after the other */
  .write { font-family: var(--script); font-size: clamp(3.1rem, 8.2vw, 6.6rem); line-height: 1.08; color: var(--tomato); margin-top: clamp(3rem, 7vw, 5.5rem); max-width: 18ch; text-wrap: balance; }
  .w { display: inline-block; white-space: nowrap; }
  .c { display: inline-block; clip-path: inset(-.3em 100% -.3em -.3em); }
  .write.in .c { animation: pen .55s cubic-bezier(.45, .05, .35, 1) forwards; animation-delay: calc(var(--i) * 85ms); }
  @keyframes pen { to { clip-path: inset(-.3em -.3em -.3em -.3em); } }
  :global(html:not(.js)) .c { clip-path: none; }
  @media (prefers-reduced-motion: reduce) { .c { clip-path: none; } .write.in .c { animation: none; } }
  .tag { margin-top: clamp(3.5rem, 8vw, 6rem); background: var(--oxblood); color: #fff; font-size: .8rem; letter-spacing: .18em; padding: 1rem 1.6rem; max-width: 100%; }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-write]');
  if (el) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { el.classList.add('in'); io.disconnect(); } }), { threshold: 0.35 });
    io.observe(el);
  }
</script>
