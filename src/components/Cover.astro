---
import { cover, ui } from '../lib/data';
import { inline } from '../lib/md';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// the "I believe" line is written letter by letter
const words = cover.quote.split(' ');
let n = 0;
const written = words.map((word) => [...word].map((ch) => ({ ch, i: n++ })));
---
<header id="cover" class="cover">
  <!-- row 1: the cover video (a looping collage on white). The poster shows while it loads, and when motion is reduced. -->
  <div class="stage">
    <video class="film" muted loop playsinline preload="metadata" poster={`${base}img/cover-poster-1600.webp`} aria-hidden="true" tabindex="-1"
      data-src-wide={`${base}video/cover-720.mp4`} data-src-narrow={`${base}video/cover-540.mp4`}></video>
    <a class="scroll label" href="#hello"><span>{ui.scroll}</span><i aria-hidden="true"></i></a>
  </div>

  <!-- row 2: the words -->
  <div id="hello" class="hello wrap">
    <h1 class="hero reveal">{cover.hero}</h1>
    <p class="sub reveal" set:html={inline(cover.sub)} />
    <p class="write" data-write>
      <span class="sr-only">{cover.quote}</span>
      <span aria-hidden="true">
        {written.map((word, wi) => <><span class="w">{word.map((c) => <span class="c" style={`--i:${c.i}`}>{c.ch}</span>)}</span>{wi < written.length - 1 ? ' ' : ''}</>)}
      </span>
    </p>
    <p class="tag label reveal">{cover.label}</p>
  </div>
</header>

<style>
  .cover { background: var(--paper); }
  .stage { position: relative; background: #fff; display: grid; justify-items: center; align-items: center; min-height: 14rem; }
  .film { display: block; width: min(100%, calc(100svh * 16 / 9)); aspect-ratio: 16 / 9; height: auto; background: #fff; object-fit: cover; }
  @media (min-width: 900px) { .stage { min-height: 100svh; } }
  .scroll { position: absolute; z-index: 1; left: var(--gutter); bottom: 1.5rem; display: none; align-items: center; gap: .9rem; color: var(--ink-soft); text-decoration: none; }
  .scroll i { width: 3rem; height: 1px; background: currentColor; transition: width .4s var(--ease); }
  .scroll:hover i { width: 5rem; color: var(--ink); }
  @media (min-width: 900px) { .scroll { display: flex; } }

  .hello { text-align: center; padding: clamp(4rem, 10vw, 8rem) 0 var(--section); display: grid; justify-items: center; }
  .hero { font-size: clamp(3.4rem, 13vw, 11.5rem); line-height: .92; letter-spacing: -.035em; font-weight: 300; max-width: 12ch; text-wrap: balance; }
  .sub { font-family: var(--display); font-size: clamp(1.5rem, 3.4vw, 2.5rem); line-height: 1.3; margin-top: clamp(3rem, 7vw, 6rem); max-width: 26ch; text-wrap: balance; }
  /* "a bigger kitchen" and "home": bold, with a highlighter stroke that sweeps in */
  .sub :global(strong) { font-weight: 600; padding: 0 .12em; margin: 0 -.12em; background: linear-gradient(transparent 58%, rgb(224 168 46 / .6) 58%, rgb(224 168 46 / .6) 92%, transparent 92%) no-repeat left / 0% 100%; transition: background-size 1.2s var(--ease) .6s; }
  .sub.in :global(strong) { background-size: 100% 100%; }
  :global(html:not(.js)) .sub :global(strong) { background-size: 100% 100%; }
  @media (prefers-reduced-motion: reduce) { .sub :global(strong) { background-size: 100% 100%; transition: none; } }
  /* handwritten line: each letter is drawn in from left to right, one after the other */
  .write { font-family: var(--script); font-size: clamp(3.1rem, 8.2vw, 6.6rem); line-height: 1.08; color: var(--tomato); margin-top: clamp(3rem, 7vw, 5.5rem); max-width: 18ch; text-wrap: balance; }
  .w { display: inline-block; white-space: nowrap; }
  .c { display: inline-block; clip-path: inset(-.3em 100% -.3em -.3em); }
  .write.in .c { animation: pen .55s cubic-bezier(.45, .05, .35, 1) forwards; animation-delay: calc(var(--i) * 85ms); }
  @keyframes pen { to { clip-path: inset(-.3em -.3em -.3em -.3em); } }
  :global(html:not(.js)) .c { clip-path: none; }
  @media (prefers-reduced-motion: reduce) { .c { clip-path: none; } .write.in .c { animation: none; } }
  .tag { margin-top: clamp(3.5rem, 8vw, 6rem); background: var(--oxblood); color: #fff; font-size: .8rem; letter-spacing: .18em; padding: 1rem 1.6rem; max-width: 100%; }
</style>

<script>
  // video: pick the size for this screen; stay still (poster only) when the visitor prefers reduced motion
  const v = document.querySelector<HTMLVideoElement>('.film');
  if (v) {
    v.src = (matchMedia('(min-width: 900px)').matches ? v.dataset.srcWide : v.dataset.srcNarrow) ?? '';
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) v.play().catch(() => {});
  }
  const el = document.querySelector<HTMLElement>('[data-write]');
  if (el) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { el.classList.add('in'); io.disconnect(); } }), { threshold: 0.35 });
    io.observe(el);
  }
</script>
