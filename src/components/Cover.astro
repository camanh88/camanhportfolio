---
import Photo from './Photo.astro';
import { cover, ui } from '../lib/data';
import { inline } from '../lib/md';
---
<header id="cover" class="cover">
  <!-- row 1: the cover photo, full width -->
  <div class="stage">
    <Photo id="cover-1" sizes="100vw" loading="eager" fetchpriority="high" />
    <a class="scroll label" href="#hello"><span>{ui.scroll}</span><i aria-hidden="true"></i></a>
  </div>

  <!-- row 2: the words -->
  <div id="hello" class="hello wrap">
    <h1 class="hero reveal">{cover.hero}</h1>
    <p class="sub reveal" set:html={inline(cover.sub)} />
  </div>
</header>

<style>
  .cover { background: var(--paper); }
  .stage { position: relative; background: var(--paper); }
  .stage :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: contain; }
  @media (min-width: 900px) { .stage { display: grid; place-items: center; min-height: calc(100svh - 6.6rem); } .stage :global(img) { width: min(100%, calc((100svh - 6.6rem) * 16 / 9)); } }
  .scroll { position: absolute; z-index: 1; left: var(--gutter); bottom: 1.75rem; display: none; align-items: center; gap: .9rem; color: var(--ink); text-decoration: none; }
  @media (min-width: 900px) { .scroll { display: flex; } }
  .scroll i { width: 3rem; height: 1px; background: currentColor; transition: width .4s var(--ease); }
  .scroll:hover i { width: 5rem; }

  .hello { text-align: center; padding: clamp(4rem, 10vw, 8rem) 0 clamp(4rem, 9vw, 8rem); display: grid; justify-items: center; }
  .hero { font-size: clamp(3.4rem, 13vw, 11.5rem); line-height: .92; letter-spacing: -.035em; font-weight: 300; max-width: 12ch; text-wrap: balance; }
  .sub { font-family: var(--display); font-size: clamp(1.5rem, 3.4vw, 2.5rem); line-height: 1.3; margin-top: clamp(3rem, 7vw, 6rem); max-width: 26ch; text-wrap: balance; }
  .sub :global(strong) { font-weight: 600; }
</style>
