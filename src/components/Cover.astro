---
import Photo from './Photo.astro';
import { cover, ui } from '../lib/data';
---
<header id="cover" class="cover">
  <!-- row 1: one photo, shown whole -->
  <div class="stage">
    <Photo id="cover-main" sizes="(min-width: 900px) 40vw, 100vw" loading="eager" fetchpriority="high" />
    <a class="scroll label" href="#hello"><span>{ui.scroll}</span><i aria-hidden="true"></i></a>
  </div>

  <!-- row 2: the words -->
  <div id="hello" class="hello wrap">
    <h1 class="hero reveal">{cover.hero}</h1>
    <p class="sub reveal">{cover.sub}</p>
    <p class="quote reveal">{cover.quote}</p>
    <p class="tag label reveal">{cover.label}</p>
    <a class="go label reveal" href="#contents">{cover.go}<span aria-hidden="true">→</span></a>
  </div>
</header>

<style>
  .cover { background: var(--paper); }
  .stage { position: relative; background: var(--dark); display: grid; justify-items: center; }
  .stage :global(img) { width: 100%; height: auto; }
  .scroll { display: none; }
  .hello { text-align: center; padding: clamp(5rem, 14vw, 11rem) 0 var(--section); display: grid; justify-items: center; }
  .hero { font-size: clamp(3.4rem, 13vw, 11.5rem); line-height: .92; letter-spacing: -.035em; font-weight: 300; max-width: 12ch; text-wrap: balance; }
  .sub { font-family: var(--display); font-size: clamp(1.5rem, 3.4vw, 2.5rem); line-height: 1.25; margin-top: clamp(3rem, 7vw, 6rem); max-width: 26ch; text-wrap: balance; }
  .quote { font-family: var(--display); font-style: italic; font-size: clamp(1.2rem, 2vw, 1.5rem); color: var(--ink-soft); margin-top: 1.5rem; max-width: 34ch; }
  .tag { margin-top: clamp(4rem, 9vw, 7rem); color: var(--ink-soft); }
  .go { margin-top: 1.25rem; display: inline-flex; gap: .9rem; align-items: center; text-decoration: none; padding: .9rem 0; border-bottom: 1px solid var(--ink); transition: color .3s, gap .3s var(--ease), border-color .3s; }
  .go:hover { color: var(--accent); border-color: var(--accent); gap: 1.5rem; }
  @media (min-width: 900px) {
    .stage { min-height: 100svh; align-items: center; }
    .stage :global(img) { width: auto; height: 100svh; max-width: 100%; object-fit: contain; }
    .scroll { display: flex; position: absolute; left: var(--gutter); bottom: 2rem; align-items: center; gap: .9rem; color: rgb(245 241 234 / .75); text-decoration: none; }
    .scroll i { width: 3.5rem; height: 1px; background: currentColor; transition: width .4s var(--ease); }
    .scroll:hover i { width: 5.5rem; }
  }
</style>
