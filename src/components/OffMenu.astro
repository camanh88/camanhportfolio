---
import Slot from './Slot.astro';
import Photo from './Photo.astro';
import { ch04, ui, pages } from '../lib/data';
import { inline, esc, phrases, sentences } from '../lib/md';

const gift = ch04.ps(ch04.giftTitle.toLowerCase());
const flor = ch04.ps(ch04.florTitle.toLowerCase());
// Display text is wrapped in <span class="u"> units (phrases() in md.ts); they flow as ordinary text (Cam Anh asked for the plain wrapping back).
// the first paragraph: "I give." becomes the giant word
const g1 = phrases(gift[0] ?? '', {}).replace('<span class="u">I give.</span>', '<span class="u give">I give.</span>');
// the box-of-cake paragraph: its last sentence is set smaller; "a box of cake" is marked
const g2s = sentences(gift[1] ?? '');
const mark = (h: string) => h.replace(/a box of\s+cake/, (m) => `<mark class="mk">${m}</mark>`);
const g2 = mark(phrases(g2s.slice(0, -1).join(' ')));
const g2sub = phrases(g2s.slice(-1)[0] ?? '');
// the book paragraph (the photo of the page now sits beside it)
const g3 = phrases(gift[2] ?? '');
// "I love gifting because ..." is split sentence by sentence for the typographic page
const sent = sentences(gift[3] ?? '');
const lovePre = sent[0] ?? '';
const loveWords = sent.slice(1, 3);        // "Sharing." "Caring."
const loveSay = sent[3] ?? '';             // Saying "I love you" without saying it.
const loveEnd = phrases(sent.slice(4).join(' '));
// "We don't just give a gift. We create a connection. And with food, ..."
const last = sentences(gift[4] ?? '');
const connect = last.slice(0, 2);
const stomach = phrases(last.slice(2).join(' '));
const sectionNum = (k: 'gift' | 'flor') => String(ch04.order.indexOf(k) + 1).padStart(2, '0');
---
<article id="off-menu" class="om" aria-labelledby="om-title">

  <!-- OPENER: a menu card -->
  <section class="card-sec">
    <div class="card">
      <h1 id="om-title" class="c-title">{ch04.title}</h1>
      <p class="c-hint">{ch04.hint}</p>
      <ol class="dishes">
        {ch04.order.map((k) => (
          <li class={k === 'gift' ? 'em' : ''}><a href={k === 'gift' ? '#gifting' : '#florist'}><span class="dn">{sectionNum(k)}</span><span class="dname">{k === 'gift' ? ch04.giftTitle : ch04.florTitle}</span><span class="lead" aria-hidden="true"></span><span class="dgo" aria-hidden="true">↓</span></a></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- THE FLORIST IN ME: lots of photos and videos -->
  <section id="florist" class="flor" aria-labelledby="flor-title">
    <div class="f-head wrap">
      <p class="gnum" aria-hidden="true">{sectionNum('flor')}</p>
      <h2 id="flor-title" class="f-title" >{ch04.florTitle}</h2>
      <p class="f-text" set:html={phrases(flor[0] ?? '')} />
    </div>

    <div class="f-hero"><Slot tag="F1" a="16 / 9" kind="video" tone="plum" /></div>

    <div class="bento wrap">
      <Slot tag="F2" a="3 / 4" tone="pink" class="b1" />
      <Slot tag="F3" a="1 / 1" tone="cream" class="b2" />
      <Slot tag="F4" a="4 / 3" tone="lime" class="b3" />
      <Slot tag="F5" a="9 / 16" kind="video" tone="blush" class="b4" />
      <Slot tag="F6" a="1 / 1" tone="plum" class="b5" />
      <Slot tag="F7" a="4 / 5" tone="cream" class="b6" />
      <Slot tag="F8" a="4 / 3" tone="pink" class="b7" />
    </div>

    <div class="reel" role="group" aria-label={ch04.florTitle}>
      <ul>
        {[1, 2, 3, 4, 5, 6].map((n) => <li><Slot tag={`F${n + 8}`} a="9 / 16" kind="video" tone={['blush', 'cream', 'lime', 'pink', 'cream', 'blush'][n - 1] as 'blush'} /></li>)}
      </ul>
    </div>

    <div class="f-end wrap">
      <Slot tag="F15" a="3 / 2" tone="cream" />
      <Slot tag="F16" a="3 / 2" tone="blush" />
    </div>
  </section>

  <!-- GIFTING (the one to emphasise) -->
  <section id="gifting" class="gift" aria-labelledby="gift-title">

    <!-- G1: I give -->
    <div class="g1">
      <p class="gnum" aria-hidden="true">{sectionNum('gift')}</p>
      <h2 id="gift-title" class="g-title" >{ch04.giftTitle}</h2>
      <p class="g1-text" set:html={g1} />
      <div class="g1-pic">
        <span class="ribbon-v" aria-hidden="true"></span><span class="ribbon-h" aria-hidden="true"></span>
        <div class="pic" style="--a: 4 / 5"><Photo id="g-parcel" sizes="(min-width: 900px) 30vw, 90vw" /></div>
      </div>
      <div class="pic g1-small" style="--a: 1 / 1"><Photo id="g-card" sizes="(min-width: 900px) 13rem, 12.8rem" /></div>
    </div>

    <!-- G2: a box of cake -->
    <div class="g2">
      <p class="g2-text"><span set:html={g2} /><span class="g2-sub" set:html={g2sub} /></p>
      <div class="g2-spread"><Photo id="g-honestly" sizes="(min-width: 1400px) 88rem, 100vw" /></div>
    </div>

    <!-- G3: the book -->
    <div class="g3">
      <div class="book">
        <button type="button" class="book-open" aria-haspopup="dialog" aria-label={ui.expand}>
          <div class="pic" style="--a: 16 / 9"><Photo id="g-book" sizes="(min-width: 900px) 55vw, 92vw" /></div>
          <span class="book-zoom" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15.5 15.5L21 21M10.5 7.5v6M7.5 10.5h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg></span>
        </button>
      </div>
      <p class="g3-text" set:html={g3} />
    </div>

    <dialog class="zoom" aria-label={ui.expand}>
      <button type="button" class="zoom-x" aria-label={ui.close}><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg></button>
      <Photo id="g-book" sizes="100vw" />
    </dialog>

    <!-- G4: sharing, caring, "I love you" -->
    <div class="g4">
      <p class="l-pre" set:html={phrases(lovePre)} />
      <p class="l-word w1">{loveWords[0]}</p>
      <p class="l-word w2">{loveWords[1]}</p>
      <p class="l-say" set:html={inline(loveSay)} />
      <p class="l-end" set:html={loveEnd} />
    </div>

    <!-- G5: a connection -->
    <div class="g5">
      <span class="g5-ribbon" aria-hidden="true"></span>
      <div class="g5-in">
        <p class="c1">{connect[0]}</p>
        <p class="c2">{connect[1]}</p>
        <p class="c3" set:html={stomach} />
      </div>
      <div class="g5-photos">
        <div class="pic" style="--a: 4 / 5"><Photo id="g-hug" sizes="(min-width: 900px) 18rem, 33vw" /></div>
        <div class="pic" style="--a: 4 / 5"><Photo id="g-choc" sizes="(min-width: 900px) 18rem, 33vw" /></div>
        <div class="pic" style="--a: 4 / 5"><Photo id="g-team" sizes="(min-width: 900px) 18rem, 33vw" /></div>
      </div>
    </div>
  </section>
</article>

<style>
  .om { background: var(--paper); --pad: clamp(1.25rem, 4vw, 4rem); overflow-x: clip; }
  .wrap { width: min(100% - 2 * var(--pad), 88rem); margin-inline: auto; }
  .label { font-family: var(--sans); }
  /* photo frame: the picture is already cropped to this ratio, cover only absorbs rounding */
  .pic { position: relative; width: 100%; aspect-ratio: var(--a); overflow: hidden; background: var(--blush); }
  .pic :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  :global(.ul) { text-decoration: underline; text-decoration-thickness: .08em; text-underline-offset: .22em; text-decoration-color: var(--pink); }
  .gnum { font-family: var(--display); font-weight: 300; font-size: clamp(5rem, 14vw, 12rem); line-height: .75; letter-spacing: -.04em; }

  /* ---------- opener: a menu card ---------- */
  .card-sec { padding: clamp(2.5rem, 6vw, 5rem) var(--pad); background: var(--cream); }
  .card { max-width: 62rem; margin: 0 auto; background: #fff; padding: clamp(2rem, 6vw, 5rem) clamp(1.5rem, 5vw, 5rem); text-align: center; position: relative; box-shadow: 0 0 0 1px var(--ink), inset 0 0 0 .5rem #fff, inset 0 0 0 calc(.5rem + 1px) var(--ink); }
  .c-num { color: var(--pink); }
  .c-title { font-size: clamp(3.4rem, 12vw, 10rem); line-height: .86; letter-spacing: -.05em; font-weight: 300; margin: .5rem 0 0 -.03em; }
  .c-hint { font-family: var(--display); font-style: italic; font-size: clamp(1.2rem, 2vw, 1.7rem); color: var(--ink-soft); margin: 1.2rem auto 0; max-width: 24em; }
  .dishes { margin: clamp(2rem, 5vw, 4rem) auto 0; max-width: 44rem; text-align: left; display: grid; gap: 1.2rem; }
  .dishes a { display: flex; align-items: baseline; gap: .8rem; text-decoration: none; padding: .5rem 0; }
  .dn { font-size: .75rem; font-weight: 600; letter-spacing: .1em; color: var(--pink); }
  .dname { font-family: var(--display); font-size: clamp(1.5rem, 3vw, 2.5rem); line-height: 1.1; letter-spacing: -.01em; }
  .lead { flex: 1; border-bottom: 2px dotted var(--ink); transform: translateY(-.3em); min-width: 1rem; }
  .dgo { transition: transform .3s var(--ease); }
  .dishes a:hover .dgo { transform: translateY(5px); }
  .dishes li.em .dname { font-style: italic; color: var(--pink); }

  /* ---------- gifting ---------- */
  .gift { background: var(--pink); color: #fff; }
  .g1 { padding: clamp(3rem, 7vw, 7rem) var(--pad); display: grid; gap: 1.6rem; position: relative; }
  .g1 .gnum { color: var(--cream); }
  .g-title { font-size: clamp(3rem, 10.5vw, 10rem); line-height: .88; letter-spacing: -.045em; font-weight: 300; max-width: 9ch; }
  .g1-text { font-family: var(--display); font-size: clamp(1.4rem, 2.6vw, 2.3rem); line-height: 1.22; max-width: 24em; }
  .g1-text :global(.give) { display: block; font-style: italic; font-size: 2.6em; line-height: .9; letter-spacing: -.04em; color: var(--cream); margin: .15em 0; }
  /* collages: pictures placed by percentages of one frame, overlapping like a pasted spread; cut-outs have transparent edges */
  .collage { position: relative; width: 100%; aspect-ratio: var(--ar); }
  .cl { position: absolute; }
  .cl :global(img) { display: block; width: 100%; height: auto; }
  .g1-pic { position: relative; max-width: 26rem; }
    /* faded blue ribbon cross laid over the parcel photo, placed to follow the real ribbon (Cam Anh's marked-up screenshot) */
  .ribbon-v, .ribbon-h { position: absolute; background: #2B5FE0; z-index: 2; pointer-events: none; opacity: .42; }
  .ribbon-v { left: 30%; width: 2.2rem; top: -9.2%; bottom: -9.4%; transform: translateX(-50%) rotate(-1.2deg); }
  .ribbon-h { top: 36%; height: 2.2rem; left: -15.6%; right: -10.2%; transform: translateY(-50%); }
  .pic.g1-small { max-width: 12.8rem; }
  @media (min-width: 900px) {
    .g1 { grid-template-columns: repeat(12, 1fr); column-gap: 2rem; row-gap: 1.5rem; min-height: 100svh; align-content: start; }
    .g1 .gnum { grid-column: 1 / 4; grid-row: 1; }
    .g-title { grid-column: 1 / 9; grid-row: 2; }
    .g1-text { grid-column: 1 / 7; grid-row: 3; margin-top: 1rem; }
    .g1-pic { grid-column: 7 / 11; grid-row: 1 / 4; align-self: center; max-width: none; margin: 2.5rem 0; }
    .pic.g1-small { grid-column: 11 / 13; grid-row: 3; align-self: end; justify-self: end; max-width: 12.8rem; }
  }

  .g2 { background: var(--cream); color: var(--ink); padding: var(--section) var(--pad); display: grid; gap: 3rem; }
  .g2-text { font-family: var(--display); font-weight: 300; font-size: clamp(1.8rem, 4.2vw, 4rem); line-height: 1.08; letter-spacing: -.02em; max-width: 24em; }
  .g2-sub { display: block; margin-top: 1.8rem; font-family: var(--sans); font-size: clamp(1.05rem, 1.45vw, 1.35rem); line-height: 1.5; color: var(--ink); max-width: 34em; }
  .g2-spread { width: 100%; max-width: 88rem; margin-inline: auto; }
  .g2-spread :global(img) { display: block; width: 100%; height: auto; }
  .g2-text :global(.mk) { background: linear-gradient(transparent 70%, var(--pink) 70% 96%, transparent 96%); color: inherit; padding: 0 .08em; font-style: italic; white-space: nowrap; }

  .g3 { background: var(--plum); color: var(--cream); padding: var(--section) var(--pad); display: grid; gap: 2.5rem; align-items: center; }
  .book { position: relative; display: block; box-shadow: 0 30px 60px -30px rgb(0 0 0 / .6); background: #fff; padding: .4rem; }
  .book-open { appearance: none; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; position: relative; color: inherit; }
  .book-open :global(img) { transition: transform 1.2s var(--ease); }
  .book-open:hover :global(img), .book-open:focus-visible :global(img) { transform: scale(1.03); }
  .book-zoom { position: absolute; right: .8rem; bottom: .8rem; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; background: var(--paper); color: var(--ink); }
  .zoom { border: 0; padding: 0; margin: 0; max-width: none; max-height: none; position: fixed; inset: 0; width: 100vw; height: 100vh; height: 100dvh; background: rgb(20 19 18 / 0); transition: background .45s var(--ease); cursor: zoom-out; }
  .zoom[open] { display: grid; place-items: center; }
  .zoom::backdrop { background: transparent; }
  .zoom.is-open { background: rgb(20 19 18 / .95); }
  .zoom :global(img) { max-width: 96vw; max-height: 88svh; width: auto; height: auto; transform: scale(.92); opacity: 0; transition: transform .55s var(--ease), opacity .45s var(--ease); }
  .zoom.is-open :global(img) { transform: none; opacity: 1; }
  .zoom-x { position: absolute; top: 1rem; right: 1rem; width: 3rem; height: 3rem; display: grid; place-items: center; background: transparent; border: 0; color: #fff; cursor: pointer; }
  .zoom-x:hover { opacity: .65; }
  .g3-text { font-family: var(--display); font-size: clamp(1.7rem, 3.6vw, 3.4rem); line-height: 1.12; letter-spacing: -.02em; max-width: 14em; }
  .g3-text :global(em) { color: var(--lime); }
  @media (min-width: 900px) { .g3 { grid-template-columns: 7fr 5fr; column-gap: clamp(3rem, 7vw, 8rem); } }

  .g4 { background: #fff; color: var(--ink); padding: var(--section) var(--pad); max-width: 100%; }
  .g4 > * { max-width: 70rem; margin-inline: auto; }
  .l-pre { font-size: clamp(1.05rem, 1.5vw, 1.3rem); max-width: 30rem; margin-left: 0; }
  .l-word { font-family: var(--display); font-weight: 300; font-size: clamp(4.4rem, 17vw, 16rem); line-height: .84; letter-spacing: -.05em; }
  .l-word.w1 { color: var(--pink); } .l-word.w2 { color: var(--plum); padding-left: 1.2em; }
  .l-say { font-family: var(--display); font-style: italic; font-size: clamp(2rem, 6vw, 5.4rem); line-height: 1; letter-spacing: -.03em; margin-top: .4em; padding-left: 0; }
  .l-say :global(em) { font-style: normal; }
  .l-end { margin-top: 1.5rem; font-size: clamp(1.05rem, 1.5vw, 1.3rem); max-width: 30rem; margin-left: auto; margin-right: 0; }

  .g5 { position: relative; background: var(--pink); color: #fff; padding: var(--section) var(--pad) clamp(3rem, 6vw, 5rem); overflow: hidden; }
  .g5-ribbon { position: absolute; left: 50%; top: 0; bottom: 0; width: clamp(3rem, 8vw, 7rem); transform: translateX(-50%); background: rgb(252 239 219 / .22); }
  .g5-in { position: relative; max-width: 66rem; margin: 0 auto; font-family: var(--display); }
  .g5 .c1, .g5 .c2 { font-weight: 300; font-size: clamp(2.8rem, 9.4vw, 9rem); line-height: .94; letter-spacing: -.045em; }
  .g5 .c2 { font-style: italic; color: var(--cream); padding-left: 1em; }
  .g5 .c3 { font-family: var(--sans); font-size: clamp(1.05rem, 1.6vw, 1.4rem); line-height: 1.55; max-width: 26rem; margin: 2.5rem 0 0 auto; background: var(--pink); padding: .4rem 0; }
  .g5-photos { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(.5rem, 1.6vw, 1rem); max-width: 56rem; margin: clamp(3rem, 6vw, 5rem) auto 0; }

  /* ---------- florist ---------- */
  .flor { background: var(--lime); color: var(--ink); padding: var(--section) 0 clamp(2rem, 4vw, 4rem); }
  .f-head { display: grid; gap: 1.2rem; }
  .flor .gnum { color: var(--plum); }
  .f-title { font-size: clamp(3rem, 11vw, 11rem); line-height: .86; letter-spacing: -.05em; font-weight: 300; max-width: 8ch; }
  .f-title { font-style: italic; }
  .f-text { font-family: var(--display); font-size: clamp(1.5rem, 2.6vw, 2.4rem); line-height: 1.18; max-width: 20em; }
  .f-hero { margin: clamp(2.5rem, 6vw, 5rem) 0 0; }
  .f-hero :global(.slot) { aspect-ratio: 16 / 9; }
  .bento { display: grid; grid-template-columns: repeat(2, 1fr); gap: .6rem; margin-top: .6rem; align-items: start; }
  .bento :global(.b3) { grid-column: 1 / -1; }
  .reel { margin-top: clamp(2rem, 5vw, 4rem); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; padding: 0 var(--pad) 1rem; }
  .reel ul { display: flex; gap: .6rem; width: max-content; }
  .reel li { width: min(58vw, 15rem); scroll-snap-align: start; }
  .f-end { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; margin-top: 1.5rem; }
  @media (min-width: 900px) {
    .f-head { grid-template-columns: repeat(12, 1fr); column-gap: 2rem; align-items: start; }
    .f-head .gnum { grid-column: 1 / 3; grid-row: 1 / 3; }
    .f-title { grid-column: 3 / 10; grid-row: 1; }
    .f-text { grid-column: 8 / 13; grid-row: 2; }
    .f-hero { margin-top: clamp(3rem, 6vw, 5rem); }
    .bento { grid-template-columns: repeat(12, 1fr); gap: 1rem; }
    .bento :global(.b1) { grid-column: 1 / 5; grid-row: 1 / 4; }
    .bento :global(.b2) { grid-column: 5 / 8; grid-row: 1; }
    .bento :global(.b3) { grid-column: 8 / 13; grid-row: 1; }
    .bento :global(.b4) { grid-column: 5 / 7; grid-row: 2 / 4; }
    .bento :global(.b5) { grid-column: 7 / 10; grid-row: 2; }
    .bento :global(.b6) { grid-column: 10 / 13; grid-row: 2 / 4; }
    .bento :global(.b7) { grid-column: 7 / 10; grid-row: 3; }
    .bento :global(.b5) { align-self: stretch; }
    .reel li { width: 14rem; }
    .f-end { gap: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .dgo, .zoom, .zoom :global(img), .book-open :global(img) { transition: none; } .zoom :global(img) { transform: none; } }
</style>

<script>
  // The book photo opens large in a native <dialog> (focus trap, Esc, backdrop click to close).
  const zoom = document.querySelector<HTMLDialogElement>('.zoom');
  const opener = document.querySelector<HTMLButtonElement>('.book-open');
  if (zoom && opener) {
    const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const close = () => {
      zoom.classList.remove('is-open');
      const done = () => { zoom.close(); opener.focus(); };
      reduce() ? done() : setTimeout(done, 350);
    };
    opener.addEventListener('click', () => { zoom.showModal(); requestAnimationFrame(() => zoom.classList.add('is-open')); });
    zoom.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    zoom.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.zoom-x') && (e.target as HTMLElement).closest('img') === null) close(); else if ((e.target as HTMLElement).closest('.zoom-x')) close(); });
  }
</script>

