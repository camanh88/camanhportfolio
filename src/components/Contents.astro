---
import Photo from './Photo.astro';
import { contents, imageMeta } from '../lib/data';
import { inline } from '../lib/md';
// each photo's width as a share of its half of the page (proportions come from the crops themselves)
const size: Record<string, string> = { 'know-1': '88%', 'know-2-1': '52%', 'know-2-2': '92%', 'know-3': '58%', 'know-4': '44%' };
// theme colour per entry: [dot / year colour, is it dark enough to colour the year text]
const theme: [string, boolean][] = [['--teal', true], ['--tomato', true], ['--forest', true], ['--mustard', false], ['--oxblood', true], ['--teal', true]];
// Photos alternate right, left, right, left, right. A title without photo sits on the same side as the entry after it.
const base = contents.nodes;
let k = 0;
const photoSide = base.map((n) => (n.photo ? (k++ % 2 === 0 ? 'pr' : 'pl') : ''));
const nodes = base.map((n, i) => {
  let side = photoSide[i];
  if (!side) { const next = photoSide.slice(i + 1).find(Boolean); side = next ?? 'pr'; }
  return { ...n, side, pw: size[n.photo] ?? '60%', c: theme[i % theme.length] };
});
---
<section id="contents" class="know" aria-labelledby="know-title">
  <div class="wrap">
    <h2 id="know-title" class="title reveal">{contents.title}</h2>
    <svg class="down" viewBox="0 0 16 64" width="16" height="64" aria-hidden="true"><path d="M8 2v56M2 51l6 9 6-9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>

    <ol class="tl" data-tl>
      {nodes.map((n) => (
        <li class={`node ${n.side} ${n.kind}`} data-node style={`--c:var(${n.c[0]});--y:${n.c[1] ? `var(${n.c[0]})` : 'var(--ink-soft)'}`}>
          <i class="dot" aria-hidden="true"></i>
          {n.photo && imageMeta[n.photo] && (
            <figure class="pic" style={`--pw:${n.pw}`}>
              <Photo id={n.photo} sizes="(min-width: 900px) 40vw, 80vw" />
            </figure>
          )}
          <div class="txt">
            {n.years && <p class="year">{n.years}</p>}
            <h3 class="ct"><a class="link" href={`#${n.anchor}`}>{n.title}</a></h3>
            {n.hint && <p class="hint">{n.hint}</p>}
            {n.roles.length > 0 && (
              <ul class="roles">
                {n.roles.map((r) => (
                  <li>{r.date && <span class="rd">{r.date}</span>}<span class="rt" set:html={inline(r.text)} /></li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .know { padding: var(--section) 0; background: var(--paper); }
  .title { text-align: center; font-size: clamp(1.9rem, 3.8vw, 3rem); line-height: 1; letter-spacing: -.02em; }
  .down { display: block; margin: 1.75rem auto clamp(3rem, 7vw, 6rem); color: var(--ink); animation: nudge 2.6s var(--ease) infinite; }
  @keyframes nudge { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(8px); } }
  @media (prefers-reduced-motion: reduce) { .down { animation: none; } }

  /* one continuous line through every entry */
  .tl { --p: 0; position: relative; padding: 1.5rem 0 3rem; }
  .tl::before, .tl::after { content: ''; position: absolute; top: 0; left: .5rem; width: 1px; }
  .tl::before { bottom: 0; background: var(--hair); }
  .tl::after { height: calc(var(--p) * 100%); background: var(--ink); max-height: 100%; }
  .node { position: relative; display: grid; gap: 1.5rem; padding: 0 0 clamp(4rem, 9vw, 7rem) 2.75rem; }
  .dot { position: absolute; left: .5rem; top: .55rem; width: 12px; height: 12px; margin-left: -6px; border-radius: 50%; background: var(--paper); border: 1.5px solid var(--c); transition: background .6s; z-index: 1; }
  .node.in .dot { background: var(--c); }
  .sub .dot { width: 8px; height: 8px; margin-left: -4px; top: .7rem; }
  .pic { margin: 0; width: var(--pw); max-width: 100%; }
  .pic :global(img) { width: 100%; height: auto; }

  .year { display: inline-block; font-family: var(--sans); font-weight: 500; font-size: .95rem; letter-spacing: .1em; color: var(--y); margin-bottom: .7rem; text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: .4em; }
  .ct { font-family: var(--display); font-weight: 300; font-size: clamp(2.3rem, 6.4vw, 4.2rem); line-height: 1.02; letter-spacing: -.02em; }
  .sub .ct { font-size: clamp(1.9rem, 5vw, 3.4rem); }
  .link { text-decoration: none; transition: color .3s; }
  .link:hover { color: var(--c); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .14em; }
  .hint { font-family: var(--display); font-style: italic; font-size: clamp(1.2rem, 1.9vw, 1.45rem); line-height: 1.4; color: var(--ink-soft); margin-top: 1.1rem; max-width: 34rem; }
  .roles { margin-top: 1.5rem; display: grid; gap: 1.1rem; max-width: 36rem; }
  .rd { display: block; font-size: .82rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--oxblood); margin-bottom: .15rem; }
  .rt { display: block; font-size: 1.05rem; line-height: 1.5; }

  /* reveal one by one */
  :global(.js) .node:not(.in) .pic, :global(.js) .node:not(.in) .txt { opacity: 0; transform: translateY(14px); }
  .pic, .txt { transition: opacity 1s var(--ease), transform 1s var(--ease); }
  .txt { transition-delay: .12s; }
  @media (prefers-reduced-motion: reduce) { .pic, .txt { transition: none; } :global(.js) .node:not(.in) .pic, :global(.js) .node:not(.in) .txt { opacity: 1; transform: none; } }

  @media (min-width: 900px) {
    .tl::before, .tl::after { left: 50%; }
    .node { grid-template-columns: 1fr 1fr; column-gap: clamp(3rem, 8vw, 8rem); padding: 0 0 clamp(5rem, 11vw, 9rem); align-items: start; }
    .dot { left: 50%; }
    /* pr = photo right, words left;  pl = photo left, words right */
    .node.pl .pic { grid-column: 1; grid-row: 1; justify-self: end; margin-top: 2.5rem; }
    .node.pl .txt { grid-column: 2; grid-row: 1; }
    .node.pr .pic { grid-column: 2; grid-row: 1; justify-self: start; margin-top: 2.5rem; }
    .node.pr .txt { grid-column: 1; grid-row: 1; text-align: right; justify-self: end; }
    .node.pr .roles, .node.pr .hint { margin-left: auto; }
    .node.pr .roles { text-align: right; }
  }
</style>

<script>
  const tl = document.querySelector<HTMLElement>('[data-tl]');
  if (tl) {
    const nodes = [...tl.querySelectorAll<HTMLElement>('[data-node]')];
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -18% 0px', threshold: 0.05 });
    nodes.forEach((n) => io.observe(n));
    const update = () => {
      const r = tl.getBoundingClientRect();
      tl.style.setProperty('--p', String(Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height))));
    };
    let raf = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
