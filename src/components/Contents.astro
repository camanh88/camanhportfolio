---
import Photo from './Photo.astro';
import Torn from './Torn.astro';
import { contents, BUILT, ui } from '../lib/data';
import { inline } from '../lib/md';

const colors: Record<string, [string, string]> = {
  '01': ['var(--teal)', 'var(--paper-light)'],
  '02': ['var(--oxblood)', 'var(--paper-light)'],
  '03': ['var(--mustard)', 'var(--ink)'],
  '04': ['var(--blush)', 'var(--ink)'],
  '05': ['var(--forest)', 'var(--paper-light)'],
  '06': ['var(--tomato)', 'var(--paper-light)'],
};
const chapters = contents.rows.filter((r) => !r.sub).map((r, i) => ({
  ...r,
  subs: contents.rows.filter((s) => s.sub && s.num === r.num),
  built: BUILT.has(r.num),
  tx: ['8%', '38%', '66%'][i % 3],
  c: colors[r.num]?.[0] ?? 'var(--ink)',
  t: colors[r.num]?.[1] ?? 'var(--paper)',
}));
const strip = ['ch02-studio-8', 'ch02-moodboard-1', 'ch02-gallery-2', 'ch02-villa-1', 'ch02-apartment-1', 'ch02-shoot-3', 'ch02-catalogue-3'];
---
<section id="contents" class="contents" aria-labelledby="contents-title">
  <div class="wrap">
    <div class="strip" aria-hidden="true">
      {strip.map((id) => <Photo id={id} alt="" sizes="160px" />)}
    </div>
    <h2 id="contents-title" class="big">{contents.title}</h2>
    <p class="intro reveal" set:html={inline(contents.intro)} />

    <nav aria-label={ui['chapter nav']}>
      <ol class="toc">
        {chapters.map((c) => (
          <li class={`chap reveal${c.built ? '' : ' soon'}`} style={`--c:${c.c};--t:${c.t};--tx:${c.tx}`}>
            <a class="chap-link" href={`#ch-${c.num}`}>
              <span class="num">{c.num}</span>
              <span class="meta">
                <span class="ct" set:html={inline(c.title)} />
                {c.teaser && <span class="cx">{c.teaser}</span>}
              </span>
              <span class="end">
                {c.built
                  ? <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  : <span class="tag mono">{ui['coming soon']}</span>}
              </span>
            </a>
            {c.subs.length > 0 && (
              <ul class="subs">
                {c.subs.map((s) => (
                  <li><a href={`#ch-${c.num}`}><span aria-hidden="true">↳</span> <span>{s.title}</span>{s.teaser && <small>{s.teaser}</small>}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </nav>
  </div>
  <div class="edge"><Torn color="var(--paper)" seed={9} /></div>
</section>

<style>
  .contents { background: var(--paper-deep); position: relative; padding: clamp(3rem, 8vw, 6rem) 0 0; scroll-margin-top: 0; }
  .strip { display: flex; gap: .5rem; background: var(--ink); padding: 1.15rem .5rem; overflow: hidden; transform: rotate(-.8deg); margin: 0 -.5rem 2rem; position: relative;
    background-image: radial-gradient(circle, var(--paper-deep) 2.5px, transparent 3px), radial-gradient(circle, var(--paper-deep) 2.5px, transparent 3px);
    background-size: 18px 10px, 18px 10px; background-position: 4px 4px, 4px calc(100% - 4px); background-repeat: repeat-x; }
  .strip :global(img) { flex: 0 0 auto; width: 7.5rem; height: 5.5rem; object-fit: cover; filter: sepia(.15) contrast(1.02); }
  .big { font-family: var(--display); font-weight: 300; text-transform: uppercase; font-size: clamp(3.2rem, 18vw, 15rem); line-height: .9; letter-spacing: -.045em; margin: 0 0 1rem -.04em; color: var(--ink); white-space: nowrap; overflow-wrap: normal; }
  .intro { font-family: var(--hand); font-size: clamp(1.25rem, 3.5vw, 1.75rem); color: var(--oxblood); transform: rotate(-1.5deg); margin: 0 0 2.5rem; max-width: 28rem; line-height: 1.3; }
  .toc { display: block; padding-bottom: 5rem; }
  .chap { position: relative; margin-top: 1.1rem; break-inside: avoid; background: var(--c); color: var(--t); border-radius: 2px 2px 3px 3px; box-shadow: var(--shadow-paper); }
  .chap::before { content: ''; position: absolute; top: -.85rem; left: var(--tx); width: 5.5rem; height: 1rem; background: var(--c); clip-path: polygon(0 100%, 7% 0, 93% 0, 100% 100%); }
  .chap.soon { filter: saturate(.55) brightness(1.04); }
  .chap-link { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 1.1rem 1.15rem; text-decoration: none; min-height: 44px; }
  .chap-link:hover .end svg { transform: translateX(5px); }
  .chap-link:focus-visible { outline-color: var(--ink); outline-offset: -4px; }
  .end svg { transition: transform .3s var(--ease); display: block; }
  .num { font-family: var(--display); font-weight: 300; font-size: clamp(2.6rem, 9vw, 3.8rem); line-height: 1; letter-spacing: -.03em; min-width: 2ch; }
  .meta { display: grid; gap: .15rem; min-width: 0; }
  .ct { font-family: var(--display); font-weight: 600; font-size: clamp(1.15rem, 4.2vw, 1.5rem); line-height: 1.15; overflow-wrap: anywhere; }
  .cx { font-size: .95rem; line-height: 1.35; opacity: .94; }
  .tag { border: 1px solid currentColor; border-radius: 99px; padding: .2rem .6rem; font-size: .66rem; white-space: nowrap; }
  .subs { border-top: 1px dashed color-mix(in srgb, var(--t) 45%, transparent); padding: .4rem 1.15rem .7rem 3.9rem; display: grid; gap: .1rem; background: color-mix(in srgb, var(--c) 82%, var(--paper-light)); }
  .subs a { display: flex; flex-wrap: wrap; align-items: baseline; gap: .15rem .55rem; text-decoration: none; padding: .35rem 0; min-height: 44px; align-content: center; }
  .subs a:hover span:not([aria-hidden]) { text-decoration: underline; }
  .subs small { font-size: .85rem; opacity: .85; flex-basis: 100%; padding-left: 1.4rem; line-height: 1.3; }
  .edge { margin-top: -1px; position: relative; z-index: 1; background: var(--paper-deep); }
  @media (min-width: 960px) {
    .toc { columns: 2; column-gap: 2.5rem; }
    .strip :global(img) { width: 10.5rem; height: 7.5rem; }
    .strip { gap: .75rem; }
    .chap { margin-top: 1.4rem; }
    .intro { margin-top: -1.5rem; margin-left: 18%; transform: rotate(-2.5deg); }
  }
</style>
