---
import Photo from './Photo.astro';
import { contents, ui } from '../lib/data';
import { inline } from '../lib/md';
---
<section id="contents" class="know" aria-labelledby="know-title">
  <div class="wrap">
    <h2 id="know-title" class="title reveal">{contents.title}</h2>

    <nav aria-label={ui['chapter nav']}>
      <ol class="list">
        {contents.chapters.map((c, i) => (
          <li class={`chap ${i % 2 ? 'odd' : 'even'}`}>
            <figure class="pic reveal"><Photo id={c.photo} sizes="(min-width: 900px) 28vw, 80vw" /></figure>
            <div class="txt reveal">
              <p class="num" aria-hidden="true">{c.num}</p>
              <h3 class="ct"><a class="link" href={`#ch-${c.num}`}>{c.title}</a></h3>
              {c.hint && <p class="hint">{c.hint}</p>}
              {c.roles.length > 0 && <ul class="roles">{c.roles.map((r) => <li set:html={inline(r)} />)}</ul>}
              {c.subs.map((s) => (
                <div class="sub">
                  <h4 class="sh"><span aria-hidden="true">↳</span> {s.title}</h4>
                  {s.hint && <p class="hint">{s.hint}</p>}
                  {s.roles.length > 0 && <ul class="roles">{s.roles.map((r) => <li set:html={inline(r)} />)}</ul>}
                </div>
              ))}
              <p class="soon label">{ui['coming soon']}</p>
            </div>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style>
  .know { padding: var(--section) 0; }
  .title { font-size: clamp(3.4rem, 11vw, 10rem); line-height: .92; letter-spacing: -.035em; max-width: 9ch; margin-bottom: clamp(4rem, 10vw, 9rem); }
  .chap { position: relative; display: grid; gap: 1.75rem; padding: clamp(2.5rem, 6vw, 4.5rem) 0; border-top: 1px solid var(--hair); }
  .chap:last-child { border-bottom: 1px solid var(--hair); }
  .pic { overflow: hidden; width: min(100%, 24rem); }
  .pic :global(img) { width: 100%; height: auto; transition: transform 1.4s var(--ease); }
  .chap:hover .pic :global(img) { transform: scale(1.03); }
  .num { font-family: var(--display); font-weight: 300; font-size: clamp(2.8rem, 6vw, 4.5rem); line-height: 1; color: var(--accent); letter-spacing: -.02em; margin-bottom: .75rem; }
  .ct { font-size: clamp(2rem, 4.4vw, 3.6rem); line-height: 1.04; letter-spacing: -.02em; font-weight: 400; max-width: 16ch; text-wrap: balance; }
  .link { text-decoration: none; }
  .link::after { content: ''; position: absolute; inset: 0; }
  .link:focus-visible { outline: none; }
  .link:focus-visible::after { outline: 2px solid var(--accent); outline-offset: -2px; }
  .chap:hover .link { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .12em; text-decoration-color: var(--accent); }
  .hint { font-family: var(--display); font-style: italic; font-size: clamp(1.2rem, 1.9vw, 1.5rem); line-height: 1.35; color: var(--ink-soft); margin-top: 1.25rem; max-width: 36rem; }
  .roles { margin-top: 1.25rem; display: grid; gap: .35rem; font-size: .88rem; line-height: 1.5; color: var(--ink); }
  .roles li { padding-left: 0; }
  .sub { margin-top: 2.25rem; padding-top: 1.5rem; border-top: 1px solid var(--hair); max-width: 36rem; }
  .sh { font-family: var(--display); font-weight: 400; font-size: clamp(1.4rem, 2.2vw, 1.8rem); line-height: 1.1; }
  .sh span { color: var(--accent); margin-right: .4rem; }
  .soon { margin-top: 2.25rem; color: var(--ink-soft); }

  @media (min-width: 900px) {
    .chap { grid-template-columns: repeat(12, 1fr); column-gap: 2rem; align-items: start; }
    .pic { width: 100%; }
    .chap.even .pic { grid-column: 1 / span 4; grid-row: 1; }
    .chap.even .txt { grid-column: 6 / span 7; grid-row: 1; }
    .chap.odd .pic { grid-column: 9 / span 4; grid-row: 1; }
    .chap.odd .txt { grid-column: 2 / span 6; grid-row: 1; }
  }
</style>
