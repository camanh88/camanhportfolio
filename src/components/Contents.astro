---
import Photo from './Photo.astro';
import { contents, imageMeta } from '../lib/data';
import { inline } from '../lib/md';
// width of each photo as a share of its half of the timeline (the proportions come from the crops themselves)
const size: Record<string, string> = { 'know-01': '86%', 'know-02': '52%', 'know-03': '90%', 'know-04': '62%', 'know-05': '38%' };
const nodes = contents.nodes.map((n, i) => ({ ...n, side: i % 2 ? 'r' : 'l', pw: size[n.photo] ?? '60%' }));
---
<section id="contents" class="know" aria-labelledby="know-title">
  <div class="wrap">
    <h2 id="know-title" class="title reveal">{contents.title}</h2>

    <ol class="tl" data-tl>
      {nodes.map((n) => (
        <li class={`node ${n.side} ${n.kind}`} data-node>
          <i class="dot" aria-hidden="true"></i>
          {n.photo && imageMeta[n.photo] && (
            <figure class="pic" style={`--pw:${n.pw}`}>
              <Photo id={n.photo} sizes="(min-width: 900px) 40vw, 80vw" />
            </figure>
          )}
          <div class="txt">
            {n.date && <p class="date">{n.date}</p>}
            <h3 class={`ct${n.date ? ' has-date' : ''}`}><a class="link" href={`#${n.anchor}`}>{n.title}</a></h3>
            {n.hint && <p class="hint">{n.hint}</p>}
            {n.roles.length > 0 && (
              <ul class="roles">
                {n.roles.map((r) => (
                  <li>{r.date && <span class="rd">{r.date}</span>}<span set:html={inline(r.text)} /></li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .know { padding: var(--section) 0; background: var(--paper); }
  .title { text-align: center; font-size: clamp(2.6rem, 6vw, 5rem); line-height: 1; letter-spacing: -.03em; margin-bottom: clamp(4rem, 9vw, 8rem); }

  /* one continuous line through every entry */
  .tl { --p: 0; position: relative; padding: 1.5rem 0 3rem; }
  .tl::before, .tl::after { content: ''; position: absolute; top: 0; left: .5rem; width: 1px; }
  .tl::before { bottom: 0; background: var(--hair); }
  .tl::after { height: calc(var(--p) * 100%); background: var(--ink); max-height: 100%; }
  .node { position: relative; display: grid; gap: 1.5rem; padding: 0 0 clamp(4rem, 9vw, 7rem) 2.75rem; }
  .dot { position: absolute; left: .5rem; top: .6rem; width: 11px; height: 11px; margin-left: -5px; border-radius: 50%; background: var(--paper); border: 1px solid var(--ink); transition: background .6s, border-color .6s; z-index: 1; }
  .node.in .dot { background: var(--accent); border-color: var(--accent); }
  .sub .dot { width: 7px; height: 7px; margin-left: -3px; top: .8rem; }
  .pic { margin: 0; width: var(--pw); max-width: 100%; }
  .pic :global(img) { width: 100%; height: auto; }

  .date { font-family: var(--display); font-weight: 300; font-size: clamp(2.2rem, 7vw, 3.8rem); line-height: 1; letter-spacing: -.025em; }
  .ct { font-family: var(--sans); font-weight: 500; font-size: 1rem; line-height: 1.4; margin-top: .75rem; }
  .ct:not(.has-date) { font-family: var(--display); font-weight: 300; font-size: clamp(2rem, 6vw, 3.4rem); line-height: 1.04; letter-spacing: -.02em; margin-top: 0; }
  .sub .ct:not(.has-date) { font-size: clamp(1.6rem, 4vw, 2.2rem); }
  .link { text-decoration: none; }
  .link:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; text-decoration-color: var(--accent); }
  .hint { font-family: var(--display); font-style: italic; font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.4; color: var(--ink-soft); margin-top: 1rem; max-width: 34rem; }
  .roles { margin-top: 1.25rem; display: grid; gap: .6rem; font-size: .88rem; line-height: 1.5; max-width: 34rem; }
  .rd { display: block; font-size: .7rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: .1rem; }

  /* reveal one by one */
  :global(.js) .node:not(.in) .pic, :global(.js) .node:not(.in) .txt { opacity: 0; transform: translateY(14px); }
  .pic, .txt { transition: opacity 1s var(--ease), transform 1s var(--ease); }
  .txt { transition-delay: .12s; }
  @media (prefers-reduced-motion: reduce) { .pic, .txt { transition: none; } :global(.js) .node:not(.in) .pic, :global(.js) .node:not(.in) .txt { opacity: 1; transform: none; } }

  @media (min-width: 900px) {
    .tl::before, .tl::after { left: 50%; }
    .node { grid-template-columns: 1fr 1fr; column-gap: clamp(3rem, 8vw, 8rem); padding: 0 0 clamp(5rem, 11vw, 9rem); align-items: start; }
    .dot { left: 50%; }
    /* photo on one side, words on the other; they swap sides entry by entry */
    .node.l .pic { grid-column: 1; justify-self: end; grid-row: 1; }
    .node.l .txt { grid-column: 2; grid-row: 1; padding-top: .1rem; }
    .node.r .pic { grid-column: 2; justify-self: start; grid-row: 1; }
    .node.r .txt { grid-column: 1; grid-row: 1; text-align: right; justify-self: end; }
    .node.r .roles, .node.r .hint { margin-left: auto; }
    .node.l .pic { margin-top: 1.5rem; } .node.r .pic { margin-top: 3rem; }
    .node:not(:has(.pic)) .txt { grid-row: 1; }
  }
</style>

<script>
  const tl = document.querySelector<HTMLElement>('[data-tl]');
  if (tl) {
    const nodes = [...tl.querySelectorAll<HTMLElement>('[data-node]')];
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -18% 0px', threshold: 0.05 });
    nodes.forEach((n) => io.observe(n));
    const update = () => {
      const r = tl.getBoundingClientRect();
      const p = (innerHeight * 0.6 - r.top) / r.height;
      tl.style.setProperty('--p', String(Math.min(1, Math.max(0, p))));
    };
    let raf = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
