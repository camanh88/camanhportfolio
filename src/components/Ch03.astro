</style>

<script>
  // Mono photos and guest opinion cards open large (native <dialog>: Esc closes); arrows and the arrow keys move through the same group
  const lb = document.getElementById('mono-lb') as HTMLDialogElement | null;
  if (lb) {
    const img = lb.querySelector<HTMLImageElement>('.lb-img')!;
    let group: HTMLButtonElement[] = [], at = 0, opener: HTMLElement | null = null;
    const show = (i: number) => {
      at = (i + group.length) % group.length;
      const src = group[at].querySelector('img')!;
      img.src = src.currentSrc || src.src; img.alt = src.alt;
    };
    const close = () => { lb.close(); document.documentElement.classList.remove('sp-open'); opener?.focus(); };
    document.querySelectorAll<HTMLButtonElement>('#ch-02-kitchens .mp').forEach((b) => b.addEventListener('click', () => {
      group = [...document.querySelectorAll<HTMLButtonElement>(`#ch-02-kitchens .mp[data-group="${b.dataset.group}"]`)];
      opener = b; show(group.indexOf(b));
      lb.showModal(); document.documentElement.classList.add('sp-open');
    }));
    lb.querySelector('.lb-p')!.addEventListener('click', () => show(at - 1));
    lb.querySelector('.lb-n')!.addEventListener('click', () => show(at + 1));
    lb.querySelector('.lb-x')!.addEventListener('click', close);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    lb.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(at - 1); if (e.key === 'ArrowRight') show(at + 1); });
  }
</script>
