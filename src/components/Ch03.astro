---
import Slot from './Slot.astro';
import { ch03, ui, splitDate, contents, type Block, pages } from '../lib/data';
import { inline, leadSplit, slug, textOf, esc, externalLink, sidepathButton, sentences } from '../lib/md';

const ptxt = (bs: Block[]) => bs.filter((b): b is Extract<Block, { t: 'p' }> => b.t === 'p').map((b) => b.text);
const lists = (bs: Block[]) => bs.filter((b): b is Extract<Block, { t: 'ul' }> => b.t === 'ul').map((b) => b.items);
const find = (re: RegExp) => ch03.projects.find((p) => re.test(p.name))!;

const gg = find(/golden/i), ly = find(/lam y/i), mono = find(/mono/i);
const urlIn = (t: string) => /\]\((https?:\/\/[^)\s]+)\)/.exec(t)?.[1] ?? '';
const ggName = textOf(gg.name), ggUrl = urlIn(gg.name);      // the heading links to the company site
const monoName = textOf(mono.name);
// "Job title · Contract": only the job title is bold
const roleParts = (t: string) => { const i = t.indexOf(' · '); return i > -1 ? { title: t.slice(0, i), kind: t.slice(i) } : { title: t, kind: '' }; };
const parentTitle = contents.nodes.find((n) => n.kind === 'chapter' && n.anchor === 'ch-02')?.title ?? '';
const words = ch03.title.split(' ');            // "Different" / "kitchens"

// Golden Gate
const ggP = ptxt(gg.blocks);
const ggRole = splitDate(ggP[0]);
const ggItems = lists(gg.blocks)[0] ?? [];
// Lam Yên & 123
const lyP = ptxt(ly.blocks);
const lyRole = splitDate(lyP[0]);
const lyItems = (lists(ly.blocks)[0] ?? []).map(leadSplit);
const lyName = ly.name.split('&').map((x) => x.trim());      // "Lam Yên", "123 Restaurant"
// the 123 text: two sentences in the same style; only the video slot L3 links to TikTok (address kept in a BUILD NOTE)
const r123 = sentences(lyItems[1]?.rest ?? '');
const t123a = r123[0] ?? '';
const t123b = r123.slice(1).join(' ');
const tiktok = /https?:\/\/\S*tiktok\.com\S*/.exec(ch03.note)?.[0] ?? '';
// Mono
const mP = ptxt(mono.blocks);
const mRole = splitDate(mP[0]);
const heart = mP[1] ?? '';
const briefAt = Math.max(2, mP.findIndex((t) => /^the brief:/i.test(t)));
const intro = mP.slice(2, briefAt);                            // two paragraphs after the heart line: main, then secondary
const brief = mP[briefAt] ?? '';
const mItems = (lists(mono.blocks)[0] ?? []).map(leadSplit);
const gallery = mP[briefAt + 1] ?? '';                                   // "[Gallery link]" until Cam Anh gives the address
const galleryUrl = urlIn(gallery);
const mClose = mP.slice(briefAt + 2);                                    // the two closing paragraphs
const heartHtml = inline(heart).replace('service', '<em class="svc">service</em>');
// "In the café": three short points, one per comma-separated part
const cafeParts = (mItems[1]?.rest ?? '').split(/,\s+/);
const index = [
  { n: '01', name: ggName, role: ggRole, id: 'k-gg' },
  { n: '02', name: ly.name, role: lyRole, id: 'k-ly' },
  { n: '03', name: monoName, role: mRole, id: 'k-mono', star: true },
];
---
<article id="ch-02-kitchens" class="c3" aria-labelledby="c3-title">
  <a class="back label" href={`${pages.home}#contents`}>{ui.back}</a>

  <!-- OPENER: the title, big and stacked, and an index of the three kitchens -->
  <section class="open">
    <p class="open-from label">{parentTitle}</p>
    <h2 id="c3-title" class="open-title"><span>{words[0]}</span><span class="b">{words.slice(1).join(' ')}</span></h2>
    <p class="open-hint">{ch03.hint}</p>
    <ol class="idx">
      {index.map((i) => (
        <li class={i.star ? 'star' : ''}>
          <a href={`#${i.id}`}>
            <span class="in">{i.n}</span>
            <span class="iname">{i.name}</span>
            <span class="irole">{i.role.text}</span>
            <span class="idate">{i.role.date}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- 01 GOLDEN GATE: a vertical title down the left edge, two photos, the list -->
  <section id="k-gg" class="gg" aria-labelledby="gg-title">
    <p class="vert" aria-hidden="true">{ggName}</p>
    <div class="gg-head">
      <p class="num" aria-hidden="true">01</p>
      <h3 id="gg-title" class="pname" set:html={ggUrl ? externalLink(ggName, ggUrl) : esc(ggName)} />
    </div>
    <div class="gg-main">
      <p class="role"><span class="d">{ggRole.date}</span><span class="rt"><strong>{roleParts(ggRole.text).title}</strong>{roleParts(ggRole.text).kind}</span></p>
      <p class="gg-camp" set:html={inline(ggP[1] ?? '')} />
    </div>
    <figure class="gg-a"><Slot tag="G1" a="4 / 5" tone="lime" /></figure>
    <figure class="gg-b"><Slot tag="G2" a="1 / 1" tone="cream" /></figure>
    <ul class="gg-list">
      {ggItems.map((t, i) => <li><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span set:html={inline(t)} /></li>)}
    </ul>
    <p class="gg-close" set:html={inline(ggP[2] ?? '')} />
  </section>

  <!-- 02 LAM YÊN & 123: two halves split by a line -->
  <section id="k-ly" class="ly" aria-labelledby="ly-title">
    <header class="ly-head">
      <p class="num" aria-hidden="true">02</p>
      <h3 id="ly-title" class="pname">{lyName[0]} <span class="amp" aria-hidden="true">&amp;</span><span class="sr-only">and</span> {lyName[1]}</h3>
      <p class="role"><span class="d">{lyRole.date}</span><span class="rt"><strong>{roleParts(lyRole.text).title}</strong>{roleParts(lyRole.text).kind}</span></p>
    </header>
    <div class="halves">
      <article class="half h-a">
        <Slot tag="L1" a="4 / 3" tone="blush" />
        <h4 class="hn" set:html={inline((lyItems[0]?.lead ?? '').replace(/:$/, ''))} />
        <p set:html={inline(lyItems[0]?.rest ?? '')} />
      </article>
      <article class="half h-b">
        <p class="big123" aria-hidden="true">123</p>
        <Slot tag="L2" a="4 / 3" tone="cream" />
        <h4 class="hn" set:html={inline((lyItems[1]?.lead ?? '').replace(/:$/, ''))} />
        <p set:html={inline(t123a)} />
        {t123b && <p set:html={inline(t123b)} />}
        {tiktok
          ? <a class="vid vid-link" href={tiktok} target="_blank" rel="noopener noreferrer" aria-label={`${t123b} (${ui['new tab']})`}><Slot tag="L3" a="9 / 16" kind="video" tone="pink" /><span class="vid-go" aria-hidden="true">↗</span></a>
          : <div class="vid"><Slot tag="L3" a="9 / 16" kind="video" tone="pink" /></div>}
      </article>
    </div>
    <p class="ly-close" set:html={inline(lyP[1] ?? '')} />
  </section>

  <!-- 03 MONO COFFEE LAB: the one to show off -->
  <section id="k-mono" class="mono" aria-labelledby="mono-title">
    <div class="m-hero">
      <Slot tag="M1" a="16 / 9" kind="video" tone="plum" class="m-herobg" />
      <div class="m-herotext">
        <p class="num" aria-hidden="true">03</p>
        <h3 id="mono-title" class="m-name" set:html={sidepathButton(monoName)} />
        <p class="role"><span class="d">{mRole.date}</span><span class="rt"><strong>{roleParts(mRole.text).title}</strong>{roleParts(mRole.text).kind}</span></p>
      </div>
    </div>

    <div class="m-heart">
      <p class="heart" set:html={heartHtml} />
    </div>

    {intro.length > 0 && (
      <div class="m-intro wrap">
        <p class="mi-main" set:html={inline(intro[0])} />
        {intro[1] && <p class="mi-sub" set:html={inline(intro[1])} />}
      </div>
    )}

    <div class="m-briefband">
    <div class="m-brief wrap">
      <p class="m-bl label">{brief.split(':')[0]}</p>
      <p class="m-bt" set:html={inline(brief.slice(brief.indexOf(':') + 1).trim())} />
    </div>
    </div>

    <!-- three groups of photos, one for each thing Mono needed -->
    <div class="m-social">
    <div class="m-group g-social wrap">
      <div class="gt"><p class="gk">01</p><h4>{mItems[0]?.lead.replace(/:$/, '')}</h4><p set:html={inline(mItems[0]?.rest ?? '')} /></div>
      <div class="ba-wrap">
        {galleryUrl
          ? <a class="ba ba-link" href={galleryUrl} target="_blank" rel="noopener noreferrer" aria-label={`${textOf(gallery)} (${ui['new tab']})`}>
              <figure><Slot tag="M2" a="4 / 5" tone="pink" /><figcaption class="label">{ui.before}</figcaption></figure>
              <span class="ba-arrow" aria-hidden="true">→</span>
              <figure><Slot tag="M3" a="4 / 5" tone="blush" /><figcaption class="label">{ui.after}</figcaption></figure>
            </a>
          : <div class="ba">
              <figure><Slot tag="M2" a="4 / 5" tone="pink" /><figcaption class="label">{ui.before}</figcaption></figure>
              <span class="ba-arrow" aria-hidden="true">→</span>
              <figure><Slot tag="M3" a="4 / 5" tone="blush" /><figcaption class="label">{ui.after}</figcaption></figure>
            </div>}
        <p class="ba-cap" set:html={inline(gallery)} />
      </div>
    </div>

    </div>
    <div class="g-cafe">
      <div class="cafe-in wrap">
        <div class="gt"><p class="gk">02</p><h4>{mItems[1]?.lead.replace(/:$/, '')}</h4>
          {cafeParts.length === 3
            ? <ul class="pts">{cafeParts.map((t) => <li set:html={inline(t)} />)}</ul>
            : <p set:html={inline(mItems[1]?.rest ?? '')} />}
        </div>
        <div class="cafe-pics">
          <Slot tag="M6" a="3 / 2" tone="cream" class="c1" />
          <Slot tag="M7" a="1 / 1" tone="pink" class="c2" />
          <Slot tag="M8" a="3 / 4" tone="lime" class="c3" />
        </div>
      </div>
    </div>

    <div class="m-group g-brunch wrap">
      <div class="gt"><p class="gk">03</p><h4>{mItems[2]?.lead.replace(/:$/, '')}</h4><p set:html={inline(mItems[2]?.rest ?? '')} /></div>
      <div class="brunch-pics">
        <Slot tag="M9" a="1 / 1" tone="plum" class="b1" />
        <Slot tag="M10" a="4 / 5" tone="blush" class="b2" />
        <Slot tag="M11" a="1 / 1" tone="cream" class="b3" />
      </div>
    </div>

    <div class="m-close">
      <div class="close-in wrap">
        <p class="c-mid" set:html={inline(mClose[1] ?? '')} />
        <p class="c-first" set:html={inline(mClose[0] ?? '')} />
      </div>
    </div>
  </section>

  <a class="next" href={pages.menu} aria-label={ui['chapter nav']}><span class="line" aria-hidden="true"></span></a>
</article>

<style>
  .c3 { background: var(--paper); position: relative; overflow-x: clip; --pad: clamp(1.25rem, 4vw, 4rem); }
  .c3 figure { margin: 0; }
  .wrap { width: min(100% - 2 * var(--pad), 88rem); margin-inline: auto; }
  .back { position: sticky; top: var(--back-top, .75rem); z-index: 30; width: fit-content; margin: 0 var(--gutter) 0 auto; padding: .7rem 1rem; min-height: 44px; display: flex; align-items: center; text-decoration: none; background: var(--paper); border: 1px solid var(--ink); color: var(--ink); transition: background .3s, color .3s; }
  .back:hover { background: var(--ink); color: var(--paper); }
  strong { font-weight: 600; }
  .num { font-family: var(--display); font-weight: 300; font-size: clamp(5rem, 14vw, 12rem); line-height: .75; letter-spacing: -.04em; }
  .pname { font-size: clamp(2.6rem, 7vw, 6.4rem); line-height: .94; letter-spacing: -.035em; font-weight: 300; }
  .gg .pname { white-space: nowrap; }
  .role { display: grid; gap: .25rem; margin-top: 1.3rem; }
  .role .d { font-size: .74rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .role .rt { font-size: 1.02rem; } .role .rt strong { font-weight: 600; }
  .pname :global(.xl) { text-decoration: none; }
  .pname :global(.xl-arrow) { font-size: .3em; vertical-align: 1.1em; }
  .m-name :global(.sp) { color: inherit; text-decoration: none; }
  .m-name :global(.sp:hover) { color: var(--lime); }
  .m-name :global(.sp-arrow) { font-size: .17em; margin-left: .25em; vertical-align: 2.3em; }

  /* ---------- opener ---------- */
  .open { margin-top: -2.75rem; padding: 7rem var(--pad) clamp(4rem, 8vw, 7rem); display: grid; gap: 1.5rem; }
  .open-from { color: var(--pink); }
  .open-title { display: grid; font-size: clamp(4.4rem, 20vw, 17rem); line-height: .82; letter-spacing: -.05em; font-weight: 300; margin-left: -.04em; }
  .open-title .b { font-style: italic; font-weight: 300; color: var(--plum); padding-left: .5em; }
  .open-hint { font-family: var(--display); font-style: italic; font-size: clamp(1.3rem, 2.2vw, 1.9rem); max-width: 22em; color: var(--ink-soft); }
  .idx { margin-top: clamp(2rem, 5vw, 4rem); display: grid; }
  .idx a { display: grid; grid-template-columns: 3rem 1fr; gap: .2rem 1rem; padding: 1.3rem 0; border-top: 1px solid var(--ink); text-decoration: none; transition: background .3s, padding .3s var(--ease); }
  .idx li:last-child a { border-bottom: 1px solid var(--ink); }
  .idx .in { font-size: .75rem; font-weight: 600; letter-spacing: .1em; color: var(--pink); padding-top: .5em; }
  .idx .iname { font-family: var(--display); font-size: clamp(1.8rem, 3.4vw, 3.2rem); line-height: 1; letter-spacing: -.02em; }
  .idx .irole, .idx .idate { grid-column: 2; font-size: .92rem; }
  .idx .idate { font-size: .72rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--plum); }
  .idx a:hover { padding-left: .8rem; }
  .idx .star .iname { color: var(--pink); font-style: italic; }
  @media (min-width: 900px) {
    .open { grid-template-columns: repeat(12, 1fr); column-gap: 2rem; align-content: start; min-height: 100svh; }
    .open-from, .open-title, .open-hint { grid-column: 1 / -1; }
    .open-hint { max-width: 26em; }
    .idx { grid-column: 1 / -1; }
    .idx a { grid-template-columns: 4rem 1.4fr 1.6fr 1fr; align-items: baseline; }
    .idx .irole, .idx .idate { grid-column: auto; }
    .idx .idate { text-align: right; }
  }

  /* ---------- 01 Golden Gate ---------- */
  .gg { position: relative; background: var(--lime); padding: clamp(3rem, 6vw, 6rem) var(--pad) clamp(3rem, 6vw, 6rem) clamp(4rem, 9vw, 9rem); display: grid; gap: 2rem; }
  .vert { position: absolute; left: .6rem; top: clamp(3rem, 6vw, 6rem); writing-mode: vertical-rl; transform: rotate(180deg); font-family: var(--display); font-size: clamp(2.6rem, 6vw, 5rem); line-height: 1; font-weight: 300; letter-spacing: -.02em; white-space: nowrap; opacity: .3; }
  .gg .num { color: var(--plum); }
  .gg-camp { margin-top: 1.4rem; font-family: var(--display); font-size: clamp(1.5rem, 2.4vw, 2.1rem); line-height: 1.15; }
  .gg-camp :global(.xl:hover) { color: var(--plum); }
  .gg-list { display: grid; gap: 1.2rem; }
  .gg-list li { display: grid; grid-template-columns: 2.6rem 1fr; padding-top: 1rem; border-top: 1px solid var(--ink); font-family: var(--display); font-size: clamp(1.3rem, 2vw, 1.8rem); line-height: 1.22; }
  .gg-list .n { font-family: var(--sans); font-size: .72rem; font-weight: 600; letter-spacing: .1em; padding-top: .5em; }
  .gg-close { font-family: var(--display); font-style: italic; font-size: clamp(1.7rem, 3.4vw, 3.2rem); line-height: 1.12; letter-spacing: -.02em; color: var(--plum); max-width: 22em; }
  @media (min-width: 900px) {
    .gg { grid-template-columns: repeat(12, 1fr); column-gap: 2rem; row-gap: 3rem; align-items: start; min-height: 100svh; }
    .gg-head { grid-column: 1 / -1; grid-row: 1; display: flex; align-items: flex-end; gap: clamp(1rem, 3vw, 3rem); }
    .gg-main { grid-column: 1 / 6; grid-row: 2; }
    .gg-a { grid-column: 7 / 10; grid-row: 2 / 4; }
    .gg-b { grid-column: 10 / 13; grid-row: 2; margin-top: 6rem; }
    .gg-list { grid-column: 1 / 6; grid-row: 3; align-self: end; }
    .gg-close { grid-column: 4 / 13; grid-row: 4; }
  }

  /* ---------- 02 Lam Yên & 123 ---------- */
  .ly { background: var(--blush); padding: clamp(3rem, 6vw, 6rem) var(--pad); display: grid; gap: 3rem; }
  .ly .num { color: var(--pink); }
  .amp { font-family: var(--display); font-style: italic; color: var(--pink); }
  .halves { display: grid; gap: 3rem; }
  .half { display: grid; gap: 1rem; align-content: start; position: relative; }
  .hn { font-family: var(--display); font-weight: 600; font-size: clamp(1.7rem, 2.8vw, 2.6rem); line-height: 1.05; }
  .half p { max-width: 28rem; }
  .vid-link { display: block; position: relative; text-decoration: none; color: inherit; }
  .vid-go { position: absolute; right: .6rem; bottom: .5rem; display: grid; place-items: center; width: 2.2rem; height: 2.2rem; background: var(--paper); color: var(--ink); font-size: 1.1rem; }
  .vid-link:hover .vid-go { background: var(--ink); color: var(--paper); }
  .big123 { position: absolute; right: 0; top: -.2em; font-family: var(--display); font-weight: 300; font-size: clamp(6rem, 16vw, 15rem); line-height: .8; letter-spacing: -.05em; color: var(--cream); z-index: 0; max-width: none !important; }
  .h-b > :not(.big123) { position: relative; z-index: 1; }
  .vid { width: min(46%, 12rem); justify-self: end; }
  .ly-close { font-style: italic; font-family: var(--display); font-size: clamp(1.6rem, 3.2vw, 3rem); line-height: 1.16; letter-spacing: -.015em; max-width: 30em; }
  @media (min-width: 900px) {
    .ly { min-height: 100svh; grid-template-rows: auto 1fr auto; }
    .ly-head { display: grid; grid-template-columns: 4fr 8fr; column-gap: 2rem; align-items: end; }
    .ly-head .num { grid-row: 1 / 3; }
    .halves { grid-template-columns: 1fr 1fr; gap: 0; align-items: start; }
    .h-a { padding-right: clamp(2rem, 5vw, 6rem); }
    .h-b { padding-left: clamp(2rem, 5vw, 6rem); border-left: 1px solid var(--ink); padding-top: 4rem; }
    .vid { position: absolute; right: 0; bottom: -2rem; }
    .ly-close { margin-left: 33%; }
  }

  /* ---------- 03 Mono ---------- */
  .mono { background: var(--dark); color: var(--cream); }
  .m-hero { position: relative; min-height: 100svh; display: grid; align-items: end; }
  .m-hero :global(.m-herobg) { position: absolute; inset: 0; height: 100%; aspect-ratio: auto !important; }
  .m-hero :global(.m-herobg)::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 35%, rgb(20 8 24 / .85)); }
  .m-herotext { position: relative; z-index: 1; padding: var(--pad); padding-top: 8rem; display: grid; }
  .m-herotext .num { color: var(--lime); margin-bottom: 1rem; }
  @media (min-width: 900px) { .m-herotext .num { position: absolute; right: var(--pad); top: 5.5rem; margin: 0; } }
  .m-name { font-size: clamp(3.4rem, 13vw, 13rem); line-height: .84; letter-spacing: -.05em; font-weight: 300; color: #fff; max-width: 6.5em; }
  .m-herotext .role { color: #fff; }
  .m-heart { padding: clamp(5rem, 11vw, 10rem) var(--pad); }
  .heart { max-width: 15em; margin: 0 auto; font-family: var(--display); font-weight: 300; font-size: clamp(2.2rem, 6vw, 5.8rem); line-height: 1; letter-spacing: -.03em; }
  .heart :global(.svc) { font-style: italic; color: var(--pink); }
  .heart :global(strong) { font-weight: 300; }
  /* the two paragraphs after the heart line: the first is the main one (large), the second is secondary (small, quieter) */
  .m-intro { display: grid; gap: clamp(1.4rem, 3vw, 2.4rem); padding-bottom: clamp(2.4rem, 4.5vw, 4rem); }
  .mi-main { font-family: var(--sans); font-weight: 400; font-size: clamp(1.35rem, 2.5vw, 2.3rem); line-height: 1.32; letter-spacing: -.012em; max-width: 26em; }
  .mi-main :global(em) { color: var(--pink); }
  .mi-sub { font-size: clamp(1rem, 1.3vw, 1.15rem); line-height: 1.6; max-width: 30rem; color: var(--blush); padding-left: 1.1rem; border-left: 1px solid rgb(235 219 215 / .45); }
  /* the mission stays joined to the intro above it: same dark ground, with a soft light rising from the foot of the block */
  .m-briefband { background: radial-gradient(ellipse 85% 100% at 72% 106%, rgb(243 63 113 / .8), transparent 100%), radial-gradient(ellipse 70% 100% at 18% 106%, rgb(139 42 110 / .9), transparent 100%); color: #fff; padding: clamp(.5rem, 1.5vw, 1.2rem) 0 clamp(4rem, 9vw, 8rem); box-shadow: 0 -2px 0 var(--dark); position: relative; }
  .m-briefband .m-bl { color: var(--lime); }
  .m-brief { display: grid; gap: .8rem; }
  /* 01 On social starts on its own colour */
  .m-social { background: var(--cream); color: var(--ink); }
  .m-social .gt h4 { color: var(--ink); }
  .m-social .ba .label { color: var(--ink-soft); }
  .m-social .ba-cap :global(.xl) { color: var(--plum); }
  .m-social :global(.ph) { background: var(--ph-bg); color: var(--ph-ink); box-shadow: inset 0 0 0 1px rgb(138 75 42 / .25); }
  .m-bl { color: var(--lime); font-size: .79rem; }
  .m-bt { font-family: var(--display); font-size: clamp(1.5rem, 2.6vw, 2.3rem); line-height: 1.2; max-width: 28em; }
  .mono .ph { background: rgb(246 237 230 / .12); color: var(--blush); box-shadow: inset 0 0 0 1px rgb(235 219 215 / .35); }
  .m-group { padding-top: clamp(3rem, 6vw, 6rem); padding-bottom: clamp(3rem, 6vw, 6rem); display: grid; gap: 2rem; }
  .gt .gk { font-family: var(--display); font-weight: 300; font-size: clamp(3rem, 6vw, 5.4rem); line-height: .8; color: var(--pink); }
  .gt h4 { font-family: var(--display); font-weight: 400; font-size: clamp(1.9rem, 3.6vw, 3.4rem); line-height: 1; letter-spacing: -.02em; margin: .6rem 0 .9rem; color: #fff; }
