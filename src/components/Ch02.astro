  /* 04 and 05 are the how lines after the results: indented, small sans-serif; 06 is back in line, italic serif */
  .it4, .it5 { padding-left: clamp(1.5rem, 5vw, 4.5rem); }
  .it4 p, .it5 p { font-family: var(--sans); font-size: clamp(.95rem, 1.2vw, 1.05rem); line-height: 1.5; max-width: 36em; }
  .it6 p { font-style: italic; }
  @media (min-width: 900px) { .p8-in { grid-template-columns: 4fr 8fr; column-gap: clamp(3rem, 6vw, 7rem); align-items: start; } .p8-head { position: sticky; top: 5rem; } }

  /* ---------- P9 ---------- */
  .p9 { position: relative; overflow: hidden; background: var(--dark); color: var(--cream); padding: clamp(5rem, 10vw, 9rem) 0 0; }
  /* the page sits on a soft, darkened photo (Cam Anh's layout, Oct 22): hands folding leaves, out of focus behind the text */
  :global(.p9-bg) { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 50% 38%; filter: brightness(.72) saturate(.95); z-index: 0; }
  .p9-in, .next { position: relative; z-index: 1; }
  .p9-in { display: grid; gap: 2.5rem; align-items: center; }
  :global(.p9-slot) { display: block; width: 100%; max-width: 24rem; height: auto; }
  .qm { display: block; font-family: var(--display); font-size: clamp(6rem, 14vw, 12rem); line-height: .6; color: var(--pink); margin-bottom: 1rem; }
  .p9-text { display: grid; gap: 1.4rem; max-width: 40rem; font-family: var(--display); font-weight: 300; font-size: clamp(1.25rem, 1.9vw, 1.6rem); line-height: 1.4; }
  .p9-text .a { font-size: clamp(1.7rem, 3vw, 2.6rem); line-height: 1.2; }
  /* the three paragraphs turn up one after another when the page is reached (script below) */
  :global(.js) .p9-text .p9-in-p { opacity: 0; transform: translateY(1.4rem); transition: opacity 1.2s var(--ease), transform 1.2s var(--ease); }
  :global(.js) .p9-text .p9-in-p.on { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { :global(.js) .p9-text .p9-in-p { opacity: 1; transform: none; transition: none; } }
  .p9-text .aside { font-style: italic; color: var(--blush); font-size: 1.05em; }
  .p9-text .end { font-style: italic; font-size: clamp(2rem, 4.4vw, 4rem); line-height: 1; letter-spacing: -.02em; color: var(--lime); margin-top: 1rem; }
  .next { display: block; width: 3rem; height: clamp(6rem, 14vw, 10rem); margin: 3rem auto 0; position: relative; }
  .line { position: absolute; left: 50%; top: 0; width: 1px; height: 100%; background: var(--cream); transform-origin: top; animation: draw 2.8s var(--ease) infinite; }
  @keyframes draw { 0% { transform: scaleY(0); } 60%, 100% { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) { .line { animation: none; } }
  @media (min-width: 900px) { .p9-in { grid-template-columns: 7fr 4fr; column-gap: clamp(3rem, 7vw, 8rem); } :global(.p9-slot) { justify-self: end; } }
</style>

<script>
  // P5 hero: how far the visitor has scrolled through the sticky stage (0..1) drives the mooncake splitting apart
  const track = document.querySelector<HTMLElement>('.pull-track');
  if (track && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const update = () => {
      const r = track.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / ((r.height - innerHeight) * 0.8))); // the last fifth of the scroll holds the opened state
      track.style.setProperty('--p', p.toFixed(4));
    };
    let raf = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<script>
  // "Shaping the brand's image": the photos of the wall turn up one after another
  const wallPics = [...document.querySelectorAll<HTMLElement>('#ch-02 .wall .rvl')];
  if (wallPics.length) {
    const quick = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wio = new IntersectionObserver((es) => {
      const hit = es.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement).sort((a, b) => wallPics.indexOf(a) - wallPics.indexOf(b));
      hit.forEach((el, i) => { wio.unobserve(el); setTimeout(() => el.classList.add('on'), quick ? 0 : i * 260); });
    }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
    wallPics.forEach((el) => wio.observe(el));
  }
</script>

<script>
  // "Day by day…": the three paragraphs turn up one after another once the page comes into view
  const p9ps = [...document.querySelectorAll<HTMLElement>('#ch-02 .p9-in-p')];
  if (p9ps.length) {
    const quick = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const p9io = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      p9io.disconnect();
      p9ps.forEach((el, i) => setTimeout(() => el.classList.add('on'), quick ? 0 : i * 2200));
    }, { threshold: 0.35 });
    p9io.observe(document.querySelector('#ch-02 .p9-text')!);
  }
</script>

<script>
  // The pull-apart video: loads when it scrolls into view (light copy on phones), plays muted and looped, pauses when away.
  // With "reduce motion" it stays on the poster and shows controls instead.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phone = () => matchMedia('(max-width: 700px)').matches;
  const vio = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target as HTMLVideoElement;
    if (e.isIntersecting) {
      if (!v.getAttribute('src')) v.src = (phone() ? v.dataset.sd : v.dataset.hd) ?? '';
      if (!reduce) v.play().catch(() => {});
    } else v.pause();
  }), { rootMargin: '200px 0px', threshold: 0.15 });
  document.querySelectorAll<HTMLVideoElement>('.lyv').forEach((v) => {
    if (reduce) { v.controls = true; v.removeAttribute('loop'); }
    vio.observe(v);
  });

  // "The challenge": the red ring is drawn when the words come into view
  const rio = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('drawn'); rio.unobserve(e.target); } }), { threshold: 0.8 });
  document.querySelectorAll('.circled').forEach((el) => rio.observe(el));

  // Galleries opened by the three Mid-Autumn covers (native <dialog>: Esc closes, focus returns to the cover)
  document.querySelectorAll<HTMLButtonElement>('.cover[data-gal]').forEach((btn) => {
    const dlg = document.getElementById(btn.dataset.gal!) as HTMLDialogElement | null;
    if (!dlg) return;
    const close = () => { dlg.close(); document.documentElement.classList.remove('sp-open'); btn.focus(); };
    btn.addEventListener('click', () => { dlg.showModal(); document.documentElement.classList.add('sp-open'); dlg.querySelector('.gal-sheet')?.scrollTo(0, 0); });
    dlg.querySelector('.gal-x')?.addEventListener('click', close);
    dlg.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.gal-sheet')) close(); });
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
  });

  // The green arrow: from "Summer, our quiet season" down to "We have led the way…" (the distance depends on the screen)
  const p6 = document.querySelector<HTMLElement>('#ch-02 .p6');
  const arrow = p6?.querySelector<HTMLElement>('.p6-arrow');
  const from = p6?.querySelector<HTMLElement>('.sc1 h4');
  const to = p6?.querySelector<HTMLElement>('.p6-lead');
  const place = () => {
    if (!p6 || !arrow || !from || !to) return;
    const pr = p6.getBoundingClientRect(), fr = from.getBoundingClientRect(), tr = to.getBoundingClientRect();
    const gap = Math.max(10, Math.min(24, (tr.left - pr.left) * 0.7));
    const lh = parseFloat(getComputedStyle(to).lineHeight) || 30;
    const top = fr.top - pr.top + fr.height / 2, bottom = tr.top - pr.top + lh / 2;
    Object.assign(arrow.style, { left: `${tr.left - pr.left - gap - 4}px`, top: `${top}px`, height: `${Math.max(0, bottom - top)}px`, width: `${gap - 2}px` });
    arrow.classList.add('on');
  };
  if (p6) {
    new ResizeObserver(place).observe(p6);
    addEventListener('resize', place);
    addEventListener('load', place);
    document.fonts?.ready.then(place);
    place();
  }
</script>
