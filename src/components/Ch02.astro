  /* The challenge: a thin red ring drawn round the words, like a pen stroke */
  .mo-p :global(.circled) { position: relative; display: inline-block; padding: .05em .32em; margin: 0 -.3em 0 -.2em; }
  .mo-p :global(.ring) { position: absolute; left: -.15em; right: -.15em; top: -.3em; bottom: -.3em; width: calc(100% + .3em); height: calc(100% + .6em); overflow: visible; pointer-events: none; }
  .mo-p :global(.ring path) { fill: none; stroke: #D93025; stroke-width: 1.5px; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.2s var(--ease) .15s; }
