---
import Slot from './Slot.astro';
import { ch02, ui, splitDate, type Block, pages } from '../lib/data';
import { inline, leadSplit, esc } from '../lib/md';

type Sec = { h: string; lvl: 3 | 4; body: Block[] };
const P = ch02.pages;
// split a page into headed sections (h3 / h4); `pre` = blocks before the first heading
function sections(key: string) {
  const pre: Block[] = [], out: Sec[] = [];
  for (const b of P[key] ?? []) {
    if (b.t === 'h3' || b.t === 'h4') out.push({ h: b.text, lvl: b.t === 'h3' ? 3 : 4, body: [] });
    else (out.length ? out[out.length - 1].body : pre).push(b);
  }
  return { pre, secs: out };
}
const ptxt = (bs: Block[]) => bs.filter((b): b is Extract<Block, { t: 'p' }> => b.t === 'p').map((b) => b.text);
const lists = (bs: Block[]) => bs.filter((b): b is Extract<Block, { t: 'ul' }> => b.t === 'ul').map((b) => b.items);
const numTitle = (h: string) => { const m = /^(\d+)\s*[·.]\s*(.*)$/.exec(h); return m ? { n: m[1], t: m[2] } : { n: '', t: h }; };
const colonSplit = (h: string) => { const i = h.indexOf(':'); return i > 0 ? { label: h.slice(0, i).trim(), title: h.slice(i + 1).trim() } : { label: '', title: h }; };

// ---- P1 ----
const p1 = sections('p1');
const p1Name = p1.secs[0]?.h ?? '';
const p1Lead = ptxt(p1.secs[0]?.body ?? [])[0] ?? '';
const p1Roles = (lists(p1.secs[0]?.body ?? [])[0] ?? []).map(splitDate);
const p1p = ptxt(p1.secs[0]?.body ?? []);
const p1Quote = [p1p[1], p1p[2]];
const p1Foot = p1p[3];

// ---- P2 ----
const p2 = sections('p2');
const p2About = p2.secs[0]?.h ?? '';
const p2BriefH = p2.secs[1]?.h ?? '';
const p2Intro = ptxt(p2.secs[1]?.body ?? [])[0] ?? '';
const p2Items = (lists(p2.secs[1]?.body ?? [])[0] ?? []).map((t) => { const { lead, rest } = leadSplit(t); const m = /^(\d+)\.\s*(.*)$/.exec(lead); return { n: m?.[1] ?? '', lead: m?.[2] ?? lead, rest }; });

// ---- P3 ----
const p3 = sections('p3');
const p3Head = numTitle(p3.secs[0]?.h ?? '');
const p3PackH = p3.secs[1]?.h ?? '';
const p3PackP = ptxt(p3.secs[1]?.body ?? []);
const p3Pillars = (lists(p3.secs[1]?.body ?? [])[0] ?? []).map(leadSplit);
const wrap = p3.secs.find((s) => /wrap/i.test(s.h));
const bag = p3.secs.find((s) => /bag/i.test(s.h));
const splitDash = (h: string) => { const i = h.indexOf(' - '); return i > 0 ? { t: h.slice(0, i), sub: h.slice(i + 3) } : { t: h, sub: '' }; };

// ---- P4 ----
const p4 = sections('p4');
const p4Head = colonSplit(p4.secs[0]?.h ?? '');
const p4Items = lists(p4.secs[0]?.body ?? [])[0] ?? [];

// ---- P5 ----
const p5 = sections('p5');
const p5Head = numTitle(p5.secs[0]?.h ?? '');
const p5p = ptxt(p5.secs[0]?.body ?? []);
const p5Image = colonSplit(p5.secs[1]?.h ?? '');
const p5ImageP = ptxt(p5.secs[1]?.body ?? [])[0] ?? '';
const p5Voice = colonSplit(p5.secs[2]?.h ?? '');
const p5VoiceP = ptxt(p5.secs[2]?.body ?? []);
// "That small gesture became our signature. Customers ... said, “…” “…”" -> sentence + the two quotes
const gesture = p5p[3] ?? '';
const gQuotes = [...gesture.matchAll(/“[^”]+”/g)].map((m) => m[0]);
const gSentence = gesture.replace(/\s*“[^”]+”/g, '').replace(/\s+$/, '');
const pullPhrase = 'break it, and pull it apart';
const kitchenHtml = inline(p5p[1] ?? '').replace(esc(pullPhrase), `<mark class="pull">${esc(pullPhrase)}</mark>`);
const voiceShop = 'a cordial, welcoming and confident shopkeeper';
const voiceHtml = inline(p5VoiceP[1] ?? '').replace(esc(voiceShop), `<mark class="pull">${esc(voiceShop)}</mark>`);

// ---- P6 ----
const p6 = sections('p6');
const p6Head = numTitle(p6.secs[0]?.h ?? '');
const p6Seasons = (lists(p6.secs[0]?.body ?? [])[0] ?? []).map(leadSplit);
const p6Small = p6.secs[1]?.h ?? '';
const mochi = p6.secs[2];
const mochiHead = (() => { const i = (mochi?.h ?? '').indexOf(' · '); return i > 0 ? { y: mochi!.h.slice(0, i), t: mochi!.h.slice(i + 3) } : { y: '', t: mochi?.h ?? '' }; })();
const mochiP = ptxt(mochi?.body ?? []);
const mochiResults = lists(mochi?.body ?? [])[0] ?? [];
const gia = p6.secs[3];
const giaHead = splitDash(gia?.h ?? '');
const giaItems = lists(gia?.body ?? [])[0] ?? [];
const giaP = ptxt(gia?.body ?? []);

// ---- P7 ----
const p7 = sections('p7');
const p7Head = numTitle(p7.secs[0]?.h ?? '');
const p7Body = p7.secs[0]?.body ?? [];
const years: { y: string; name: string; items: string[] }[] = [];
for (let i = 0; i < p7Body.length; i++) {
  const b = p7Body[i];
  if (b.t === 'p') {
    const t = b.text.replace(/^\*\*|\*\*$/g, '');
    const j = t.indexOf(' · ');
    const nx = p7Body[i + 1];
    years.push({ y: j > 0 ? t.slice(0, j) : t, name: j > 0 ? t.slice(j + 3) : '', items: nx && nx.t === 'ul' ? nx.items : [] });
  }
}

// ---- P8 ----
const p8 = sections('p8');
const p8Raw = p8.secs[0]?.h ?? '';
const p8Num = numTitle(p8Raw);
const p8Parts = p8Num.t.split('/').map((x) => x.trim());
const p8Title = p8Parts[p8Parts.length - 1];            // the big words: "What changed"
const p8Pre = p8Parts.slice(0, -1).join(' / ');          // the small words before it, kept as written
const p8Items = lists(p8.secs[0]?.body ?? [])[0] ?? [];

// ---- P9 ----
const p9 = ptxt(P['p9'] ?? []);
---
<article id="ch-02" class="c2" aria-labelledby="c2-title">
  <a class="back label" href={`${pages.home}#contents`}>{ui.back}</a>

  <!-- P1: opening spread -->
  <section class="p1">
    <header class="p1-head">
      <p class="p1-num label">{ch02.num}</p>
      <h2 id="c2-title" class="p1-title">{ch02.title}</h2>
      <p class="p1-hint">{ch02.hint}</p>
    </header>
    <h3 class="p1-giant">{p1Name}</h3>
    <figure class="p1-slot"><Slot tag="1.1" a="3 / 4" tone="pink" /></figure>
    <div class="p1-side">
      <p class="p1-lead" set:html={inline(p1Lead)} />
      <ul class="p1-roles">
        {p1Roles.map((r) => <li><span class="d">{r.date}</span><span class="r">{r.text}</span></li>)}
      </ul>
    </div>
    <blockquote class="p1-quote">
      <p set:html={inline(p1Quote[0] ?? '')} />
      <p set:html={inline(p1Quote[1] ?? '')} />
    </blockquote>
    <p class="p1-foot" set:html={inline(p1Foot ?? '')} />
  </section>

  <!-- P2: about + the brief -->
  <section class="p2">
    <div class="p2-about">
      <h3 class="k">{p2About}</h3>
      <Slot tag="2.1" a="1 / 1" tone="cream" />
    </div>
    <div class="p2-brief">
      <h3 class="p2-h">{p2BriefH}</h3>
      <p class="p2-intro" set:html={inline(p2Intro)} />
      <ol class="p2-items">
        {p2Items.map((it) => (
          <li><span class="n" aria-hidden="true">{it.n}</span><div><h4 class="il">{it.lead}</h4><p set:html={inline(it.rest)} /></div></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- P3: gift worth owning: packaging, the wrap, the signature bag -->
  <section class="p3">
    <header class="p3-head">
      <p class="p3-num" aria-hidden="true">{p3Head.n}</p>
      <h3 class="p3-title">{p3Head.t}</h3>
    </header>

    <div class="p3-pack">
      <div class="p3-packtext">
        <h4 class="k">{p3PackH}</h4>
        <p class="p3-want">{p3PackP[0]}</p>
        <ul class="pillars">
          {p3Pillars.map((p, i) => <li class={`pl pl${i + 1}`}><h5>{p.lead}</h5><p set:html={inline(p.rest)} /></li>)}
        </ul>
      </div>
      <div class="p3-ba">
        <Slot tag="3.1" a="3 / 4" tone="cream" />
        <span class="arrow" aria-hidden="true">→</span>
        <Slot tag="3.2" a="3 / 4" tone="pink" />
      </div>
      <p class="p3-renewed" set:html={inline(p3PackP[1] ?? '')} />
    </div>

    {wrap && (
      <div class="p3-wrap">
        <h4 class="h4i">{splitDash(wrap.h).t}<span class="sub">{splitDash(wrap.h).sub}</span></h4>
        <div class="stages">
          <div class="stage s1"><span class="no label">1</span><p set:html={inline(ptxt(wrap.body)[0] ?? '')} /><Slot tag="3.3" a="4 / 3" /></div>
          <div class="stage s2"><span class="no label">2</span><p set:html={inline(ptxt(wrap.body)[1] ?? '')} /><Slot tag="3.4" a="4 / 3" tone="lime" /></div>
        </div>
      </div>
    )}

    {bag && (
      <div class="p3-bag">
        <div class="bagtext">
          <h4 class="h4i">{splitDash(bag.h).t}<span class="sub">{splitDash(bag.h).sub}</span></h4>
          <p set:html={inline(ptxt(bag.body)[0] ?? '')} />
          <p class="big" set:html={inline(ptxt(bag.body)[1] ?? '')} />
          <p set:html={inline(ptxt(bag.body)[2] ?? '')} />
        </div>
        <div class="bagpics">
          <Slot tag="3.5" a="1 / 1" tone="cream" class="b1" />
          <Slot tag="3.6" a="3 / 4" tone="pink" class="b2" />
          <Slot tag="3.7" a="1 / 1" tone="lime" class="b3" />
        </div>
      </div>
    )}
  </section>

  <!-- P4: brand's image, a wall of photos -->
  <section class="p4">
    <div class="wall">
      <Slot tag="4.1" a="4 / 5" class="w1" tone="cream" />
      <Slot tag="4.2" a="1 / 1" class="w2" tone="pink" />
      <Slot tag="4.3" a="3 / 4" class="w3" tone="blush" />
      <Slot tag="4.4" a="4 / 3" class="w4" tone="lime" />
      <Slot tag="4.5" a="3 / 4" class="w5" tone="cream" />
      <Slot tag="4.6" a="1 / 1" class="w6" tone="blush" />
      <div class="p4-text">
        <p class="k">{p4Head.label}</p>
        <h3 class="p4-title">{p4Head.title}</h3>
        <ul class="p4-items">
          {p4Items.map((t, i) => <li class={`i${i + 1}`}><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span set:html={inline(t)} /></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- P5: THE HERO. "Show it the way it's meant to be enjoyed": a mooncake that breaks apart as you scroll -->
  <section class="p5" data-pull>
    <div class="pull-track">
      <div class="stick">
        <p class="h5-num" aria-hidden="true">{p5Head.n}</p>
        <h3 class="h5-title">{p5Head.t}</h3>
        <span class="filling" aria-hidden="true"></span>
        <div class="moon" aria-hidden="true">
          <div class="half hl"><div class="disc"><Slot tag="5.1" a="1 / 1" round tone="cream" /></div></div>
          <div class="half hr"><div class="disc"><Slot tag="5.1" a="1 / 1" round tone="cream" /></div></div>
        </div>
      </div>
    </div>

    <div class="p5-kitchen wrap">
      <p class="owner" set:html={inline(p5p[0] ?? '')} />
      <Slot tag="5.2" a="4 / 5" class="k1" />
      <div class="kt">
        <p set:html={kitchenHtml} />
        <p class="shot" set:html={inline(p5p[2] ?? '')} />
      </div>
      <Slot tag="5.3" a="3 / 4" class="k2" tone="pink" />
      <Slot tag="5.4" a="3 / 4" class="k3" tone="lime" />
    </div>

    <div class="p5-signature">
      <div class="sig-in">
        <p class="gs">{gSentence}</p>
        {gQuotes.map((q, i) => <p class={`gq gq${i + 1}`}>{q}</p>)}
      </div>
    </div>

    <div class="p5-library wrap">
      <p class="lib-text" set:html={inline(p5p[4] ?? '')} />
      <div class="reels">
        {[1, 2, 3, 4, 5].map((n) => <Slot tag={`5.${n + 4}`} a="9 / 16" kind="video" class={`r${n}`} tone={n % 2 ? 'blush' : 'cream'} />)}
      </div>
    </div>

    <div class="p5-two wrap">
      <div class="reg">
        <p class="k">{p5Image.label}</p>
        <h4 class="reg-t">{p5Image.title}</h4>
        <p class="reg-p" set:html={inline(p5ImageP)} />
      </div>
      <Slot tag="5.10" a="4 / 5" tone="cream" class="reg-a" />
      <Slot tag="5.11" a="4 / 5" tone="plum" class="reg-b" />
    </div>

    <div class="p5-voice">
      <div class="voice-in wrap">
        <div class="vt">
          <p class="k">{p5Voice.label}</p>
          <h4 class="vh">{p5Voice.title}</h4>
          <p set:html={inline(p5VoiceP[0] ?? '')} />
          <p class="vsecond" set:html={voiceHtml} />
        </div>
        <p class="vnote" set:html={inline(p5VoiceP[2] ?? '')} />
        <Slot tag="5.12" a="4 / 5" class="vslot" tone="blush" />
      </div>
    </div>
  </section>

  <!-- P6: keep the season going -->
  <section class="p6">
    <header class="p6-head wrap">
      <p class="p6-num" aria-hidden="true">{p6Head.n}</p>
      <h3 class="p6-title">{p6Head.t}</h3>
    </header>
    <div class="p6-cards wrap">
      {p6Seasons.map((s, i) => <article class={`sc sc${i + 1}`}><h4>{s.lead}</h4><p set:html={inline(s.rest)} /></article>)}
    </div>
    <p class="p6-strip label">{p6Small}</p>

    <div class="mochi wrap">
      <div class="mo-head"><p class="mo-y">{mochiHead.y}</p><h4 class="mo-t">{mochiHead.t}</h4></div>
      <div class="mo-p">
        <p set:html={inline(mochiP[0] ?? '')} />
        <p set:html={inline(mochiP[1] ?? '')} />
      </div>
      <div class="phones">
        <Slot tag="6.1" a="9 / 16" kind="video" tone="pink" />
        <Slot tag="6.2" a="9 / 16" kind="video" tone="cream" />
        <Slot tag="6.3" a="9 / 16" kind="video" tone="lime" />
      </div>
      <aside class="results">
        <p class="rl label" set:html={inline(mochiP[2] ?? '')} />
        <ul>{mochiResults.map((t) => <li set:html={inline(t)} />)}</ul>
      </aside>
    </div>

    <div class="gia wrap">
      <Slot tag="6.4" a="4 / 3" class="g1" tone="cream" />
      <Slot tag="6.5" a="3 / 4" class="g2" tone="pink" />
      <div class="gt">
        <h4 class="gh">{giaHead.t}</h4>
        <p class="gsub">{giaHead.sub}</p>
        <ul class="gl">{giaItems.map((t) => <li set:html={inline(t)} />)}</ul>
        <p class="gp" set:html={inline(giaP[0] ?? '')} />
      </div>
    </div>
  </section>

  <!-- P7: the Mid-Autumn seasons, three panels -->
  <section class="p7" aria-labelledby="p7-title">
    <header class="p7-head wrap">
      <p class="p7-num" aria-hidden="true">{p7Head.n}</p>
      <h3 id="p7-title" class="p7-title">{p7Head.t}</h3>
    </header>
    <div class="panels">
      {years.map((y, i) => (
        <article class={`panel y${i + 1}`}>
          <p class="yr">{y.y}</p>
          <h4 class="yn">{y.name}</h4>
          <ul class="yl">{y.items.map((t) => <li set:html={inline(t)} />)}</ul>
          <Slot tag={`7.${i + 1}`} a="3 / 4" tone={i === 1 ? 'cream' : 'blush'} />
        </article>
      ))}
    </div>
  </section>

  <!-- P8: what changed -->
  <section class="p8">
    <div class="p8-in wrap">
      <header class="p8-head">
        <p class="p8-num" aria-hidden="true">{p8Num.n}</p>
        {p8Pre && <p class="k p8-pre">{p8Pre}</p>}
        <h3 class="p8-title">{p8Title}</h3>
      </header>
      <ol class="p8-list">
        {p8Items.map((t, i) => <li class={`it it${i + 1}`}><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><p set:html={inline(t)} /></li>)}
      </ol>
    </div>
    <div class="p8-slots wrap">
      <Slot tag="8.1" a="1 / 1" tone="cream" />
      <Slot tag="8.2" a="1 / 1" tone="pink" />
      <Slot tag="8.3" a="1 / 1" tone="lime" />
    </div>
  </section>

  <!-- P9: rooted -->
  <footer class="p9">
    <div class="p9-in wrap">
      <Slot tag="9.1" a="4 / 5" tone="plum" class="p9-slot" />
      <div class="p9-text">
        <span class="qm" aria-hidden="true">“</span>
        <p class="a" set:html={inline((p9[0] ?? '').replace(/^“/, ''))} />
        <p set:html={inline(p9[1] ?? '')} />
        <p class="aside" set:html={inline(p9[2] ?? '')} />
        <p class="end" set:html={inline((p9[3] ?? '').replace(/”$/, ''))} />
      </div>
    </div>
    <a class="next" href="#ch-02-kitchens" aria-label={ui['chapter nav']}><span class="line" aria-hidden="true"></span></a>
  </footer>
</article>

<style>
  .c2 { background: var(--paper); position: relative; overflow-x: clip; --pad: clamp(1.25rem, 4vw, 4rem); }
  .c2 figure { margin: 0; }
  .back { position: sticky; top: var(--back-top, .75rem); z-index: 30; width: fit-content; margin: 0 var(--gutter) 0 auto; padding: .7rem 1rem; min-height: 44px; display: flex; align-items: center; text-decoration: none; background: var(--paper); border: 1px solid var(--ink); color: var(--ink); transition: background .3s, color .3s; }
  .back:hover { background: var(--ink); color: var(--paper); }
  .k { font-family: var(--sans); font-weight: 600; font-size: .75rem; letter-spacing: .18em; text-transform: uppercase; }
  .wrap { width: min(100% - 2 * var(--pad), 88rem); margin-inline: auto; }
  strong { font-weight: 600; }

  /* ---------- P1 ---------- */
  .p1 { margin-top: -2.75rem; background: var(--cream); padding: 6.5rem var(--pad) clamp(3rem, 6vw, 5rem); display: grid; gap: 1.75rem; position: relative; }
  .p1-num { color: var(--pink); }
  .p1-title { font-size: clamp(1.6rem, 3vw, 2.8rem); line-height: 1.05; font-weight: 400; max-width: 14ch; margin-top: .6rem; }
  .p1-hint { font-family: var(--display); font-style: italic; font-size: clamp(1.1rem, 1.5vw, 1.4rem); margin-top: .9rem; color: var(--ink-soft); max-width: 22ch; }
  .p1-giant { font-size: clamp(5.4rem, 24vw, 19rem); line-height: .8; letter-spacing: -.05em; font-weight: 300; color: var(--pink); margin: .2em 0 0 -.04em; position: relative; z-index: 2; }
  .p1-slot { width: min(78%, 22rem); justify-self: end; margin-top: -4rem; }
  .p1-lead { font-weight: 400; font-size: clamp(1.4rem, 2.4vw, 2.1rem); font-family: var(--display); line-height: 1.12; }
  .p1-lead :global(strong) { font-weight: 600; }
  .p1-roles { margin-top: 1.4rem; display: grid; gap: .9rem; }
  .p1-roles .d { display: block; font-size: .72rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--plum); }
  .p1-roles .r { display: block; font-size: 1rem; line-height: 1.4; }
  .p1-quote { margin: 0; font-family: var(--display); font-style: italic; font-size: clamp(1.4rem, 2.6vw, 2.3rem); line-height: 1.22; display: grid; gap: .8rem; max-width: 28ch; color: var(--plum); }
  .p1-foot { font-size: .98rem; line-height: 1.55; max-width: 26rem; border-top: 1px solid var(--ink); padding-top: .9rem; }
  .p1-foot :global(strong) { background: linear-gradient(transparent 62%, var(--lime) 62% 92%, transparent 92%); padding: 0 .1em; font-weight: 600; }
  @media (min-width: 900px) {
    .p1 { grid-template-columns: repeat(12, 1fr); column-gap: 2rem; row-gap: 0; min-height: 100svh; align-content: start; }
    .p1-head { grid-column: 1 / 6; grid-row: 1; }
    .p1-giant { grid-column: 1 / 10; grid-row: 2; align-self: start; margin-top: clamp(1.5rem, 5vw, 5rem); font-size: clamp(8rem, 17vw, 17rem); }
    .p1-slot { grid-column: 9 / 13; grid-row: 1 / 4; width: 100%; margin: 0; z-index: 1; }
    .p1-side { grid-column: 1 / 5; grid-row: 3; margin-top: clamp(2rem, 4vw, 4rem); }
    .p1-quote { grid-column: 5 / 9; grid-row: 3; margin-top: clamp(2rem, 4vw, 4rem); }
    .p1-foot { grid-column: 9 / 13; grid-row: 4; margin-top: 2rem; }
  }

  /* ---------- P2 ---------- */
  .p2 { display: grid; }
  .p2-about { background: var(--pink); color: #fff; padding: clamp(3rem, 6vw, 6rem) var(--pad); display: grid; gap: 2rem; align-content: start; }
  .p2-about .k { font-size: .85rem; }
  .p2-brief { padding: clamp(3rem, 6vw, 6rem) var(--pad); }
  .p2-h { font-size: clamp(3rem, 8vw, 7rem); line-height: .92; letter-spacing: -.035em; font-weight: 300; }
  .p2-intro { margin-top: 1.6rem; max-width: 30rem; font-size: 1.05rem; }
  .p2-items { margin-top: 2.5rem; display: grid; }
