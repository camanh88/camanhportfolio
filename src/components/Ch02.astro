---
import ChapterHead from './ChapterHead.astro';
import Photo from './Photo.astro';
import Catalogue from './Catalogue.astro';
import { ch02, sidePage } from '../lib/data';
import { inline, leadSplit } from '../lib/md';

const def = sidePage('Acculturation')?.body[0];
const hi = ch02.highlights.map((p) => ({ ...leadSplit(p), key: leadSplit(p).lead.toLowerCase() }));
const find = (k: string) => hi.find((h) => h.key.startsWith(k));
const studio = find('studio'), spaces = find('two living'), cat = find('catalogue'), gallery = find('in the gallery');
const spaceChips = [...(spaces?.rest.matchAll(/\[([^\]]+)\]/g) ?? [])].map((m) => m[0]);
const catButton = cat?.rest.match(/\[([^\]]+)\]/)?.[1];
const catText = cat?.rest.replace(/\[[^\]]+\]/, '').trim();
const range = (p: string, a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => `${p}-${a + i}`);
---
<section id="ch-02" class="c02" aria-labelledby="ch-02-title">
  <ChapterHead id="ch-02" num={ch02.num} title={ch02.title} teaser={ch02.teaser} />

  <!-- opening: role, place, story + moodboard collage -->
  <div class="wrap open">
    <div class="otext">
      <p class="role reveal">{ch02.role}</p>
      <p class="where reveal" set:html={inline(ch02.where)} />
      {ch02.story.map((t) => <p class="story reveal" set:html={inline(t)} />)}
    </div>
    <div class="mood" role="group">
      {range('ch02-moodboard', 1, 4).map((id, i) => (
        <figure class={`frame tape m${i + 1} reveal`}><Photo id={id} sizes="(min-width: 960px) 20vw, 44vw" /></figure>
      ))}
    </div>
  </div>

  <!-- ACCULTURATION -->
  <div class="acc">
    <div class="wrap acc-in">
      <h3 class="acc-title">{ch02.accTitle}</h3>
      <p class="acc-sub">{ch02.accSub}</p>
      <figure class="frame deep tape teal acc-photo"><Photo id="ch02-gallery-3" sizes="(min-width: 960px) 34vw, 80vw" /></figure>
      <aside class="defn">
        <p class="term" set:html={inline(ch02.accTerm)} />
        {def && <blockquote set:html={inline(def)} />}
      </aside>
    </div>
  </div>

  <!-- the mission + my part -->
  <div class="wrap mission-wrap">
    <h4 class="h4">{ch02.catTitle}</h4>
    <p class="mission reveal" set:html={inline(ch02.mission)} />
    <div class="part">
      <p class="part-lead" set:html={inline(ch02.partLead)} />
      <ol class="part-list">
        {ch02.part.map((t) => <li class="reveal" set:html={inline(t)} />)}
      </ol>
    </div>
  </div>

  <div class="film wrap-wide" role="group">
    <ul class="film-row">
      {range('ch02-shoot', 1, 5).map((id, i) => <li class={`reveal s${i + 1}`}><Photo id={id} sizes="(min-width: 960px) 22vw, 60vw" /></li>)}
    </ul>
  </div>

  <!-- highlights -->
  <div class="wrap hl">
    <h4 class="h4">{ch02.hiTitle}</h4>

    {studio && (
      <article class="item">
        <div class="itext reveal"><h5 class="lead">{studio.lead}</h5><p set:html={inline(studio.rest)} /></div>
        <ul class="polas">
          {range('ch02-studio', 1, 8).map((id, i) => <li class={`pola p${i + 1} reveal`}><Photo id={id} sizes="(min-width: 960px) 16vw, 44vw" /></li>)}
        </ul>
      </article>
    )}

    {spaces && (
      <article class="item spaces">
        <div class="itext reveal"><h5 class="lead">{spaces.lead}</h5><p set:html={inline(spaces.rest)} /></div>
        <div class="duo">
          <div class="side villa reveal">
            {spaceChips[0] && <p class="cap" set:html={inline(spaceChips[0])} />}
            <div class="two">
              <Photo id="ch02-villa-1" sizes="(min-width: 960px) 20vw, 44vw" />
              <Photo id="ch02-villa-2" sizes="(min-width: 960px) 20vw, 44vw" />
              <Photo id="ch02-villa-3" class="wide" sizes="(min-width: 960px) 40vw, 90vw" />
            </div>
          </div>
          <div class="side apt reveal">
            {spaceChips[1] && <p class="cap" set:html={inline(spaceChips[1])} />}
            <div class="two">
              <Photo id="ch02-apartment-1" sizes="(min-width: 960px) 20vw, 44vw" />
              <Photo id="ch02-apartment-4" sizes="(min-width: 960px) 20vw, 44vw" />
              <Photo id="ch02-apartment-3" class="wide" sizes="(min-width: 960px) 40vw, 90vw" />
            </div>
          </div>
        </div>
      </article>
    )}

    {cat && (
      <article class="item catitem">
        <div class="itext reveal">
          <h5 class="lead">{cat.lead}</h5>
          {catText && <p set:html={inline(catText)} />}
          {catButton && <p><button type="button" class="flip ph" data-open-catalogue>[{catButton}]</button></p>}
        </div>
        <div class="catwrap"><Catalogue /></div>
      </article>
    )}

    {gallery && (
      <article class="item gal">
        <div class="itext reveal"><h5 class="lead">{gallery.lead}</h5><p set:html={inline(gallery.rest)} /></div>
        <div class="masonry">
          {[1, 6, 3, 2, 5].map((n, i) => <Photo id={`ch02-gallery-${n}`} class={`reveal g${i + 1}`} sizes="(min-width: 960px) 30vw, 46vw" />)}
        </div>
      </article>
    )}
  </div>

  <!-- closing: the cliffhanger -->
  <div class="closing">
    <div class="wrap">
      {ch02.closingParas.slice(0, -1).map((t) => <p class="cl reveal" set:html={inline(t, { accent: ['exquisite', 'tranquil'] })} />)}
      <p class="dream reveal" set:html={inline(ch02.closingParas[ch02.closingParas.length - 1])} />
      <span class="pull-line" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .c02 { background: var(--paper); position: relative; }
  .h4 { font-family: var(--mono); font-weight: 400; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--oxblood); margin-bottom: 1.2rem; display: flex; align-items: center; gap: .8rem; }
  .h4::after { content: ''; height: 1px; background: currentColor; flex: 1; opacity: .5; }

  /* opening */
  .open { display: grid; gap: 2.5rem; padding-bottom: clamp(3rem, 8vw, 6rem); }
  .role { font-family: var(--display); font-weight: 600; font-size: 1.2rem; }
  .where { font-family: var(--mono); font-size: .8rem; letter-spacing: .05em; margin: .3rem 0 1.5rem; color: var(--ink-soft); }
  .story { font-size: clamp(1.2rem, 2.2vw, 1.55rem); line-height: 1.5; max-width: 34rem; }
  .story::first-letter { font-family: var(--display); font-weight: 300; font-size: 3.4em; float: left; line-height: .8; padding: .08em .1em 0 0; color: var(--oxblood); }
  .mood { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: start; padding: .5rem; }
  .mood figure { margin: 0; }
  .mood :global(img) { width: 100%; height: auto; }
  .m1 { transform: rotate(-2.2deg); } .m2 { transform: rotate(1.8deg) translateY(1.5rem); } .m3 { transform: rotate(2.4deg); } .m4 { transform: rotate(-1.6deg) translateY(1rem); }
  .m3 :global(img), .m4 :global(img) { aspect-ratio: 4 / 3; object-fit: cover; }

  /* ACCULTURATION band */
  .acc { background: var(--navy); color: var(--paper-light); padding: clamp(3rem, 8vw, 6rem) 0 clamp(3rem, 8vw, 6rem); position: relative; overflow: clip; }
  .acc-in { display: grid; gap: 1.5rem; }
  .acc-title { font-family: var(--display); font-weight: 300; font-size: clamp(2rem, 8.4vw, 8rem); letter-spacing: .01em; line-height: .95; grid-column: 1 / -1; overflow-wrap: normal; }
  .acc-sub { font-family: var(--script); font-size: clamp(2.6rem, 9vw, 5.5rem); line-height: .9; color: var(--mustard); transform: rotate(-3deg); margin-top: -.2rem; position: relative; z-index: 2; }
  .acc-photo { width: min(100%, 26rem); transform: rotate(1.6deg); justify-self: center; background: var(--paper-light); color: var(--ink); }
  .acc-photo :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .defn { border-left: 2px solid var(--mustard); padding-left: 1.2rem; max-width: 26rem; }
  .term { font-family: var(--mono); font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; margin-bottom: .6rem; color: var(--mustard); }
  .defn blockquote { font-style: italic; font-size: clamp(1.3rem, 2.6vw, 1.75rem); line-height: 1.35; margin: 0; }
  .acc :global(.sp:focus-visible) { outline-color: var(--mustard); }

  /* mission + my part */
  .mission-wrap { padding-top: clamp(3rem, 8vw, 6rem); }
  .mission { font-family: var(--display); font-weight: 300; font-size: clamp(1.6rem, 4.4vw, 2.8rem); line-height: 1.2; letter-spacing: -.01em; max-width: 46rem; margin-bottom: 2.5rem; }
  .part { display: grid; gap: 1rem; }
  .part-lead { font-family: var(--display); font-style: italic; font-weight: 300; font-size: 1.5rem; color: var(--oxblood); }
  .part-lead :global(strong) { font-weight: 300; }
  .part-list { counter-reset: n; display: grid; gap: .1rem; }
  .part-list li { counter-increment: n; display: grid; grid-template-columns: 2.6rem 1fr; align-items: baseline; padding: .7rem 0; border-bottom: 1px solid rgb(30 27 24 / .18); }
  .part-list li::before { content: counter(n, decimal-leading-zero); font-family: var(--mono); font-size: .75rem; color: var(--oxblood); }
  .film { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .film-row { display: flex; gap: .9rem; overflow-x: auto; padding: 1.4rem var(--gutter); scroll-snap-type: x mandatory; scrollbar-width: none; background: var(--ink);
    background-image: radial-gradient(circle, var(--paper) 2.5px, transparent 3px), radial-gradient(circle, var(--paper) 2.5px, transparent 3px); background-size: 20px 12px; background-position: 4px 5px, 4px calc(100% - 5px); background-repeat: repeat-x; }
  .film-row li { flex: 0 0 auto; width: min(62vw, 15rem); scroll-snap-align: center; }
  .film-row :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .wrap-wide { width: 100%; }

  /* highlights */
  .hl { padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 6vw, 4rem); display: grid; gap: clamp(3.5rem, 9vw, 7rem); }
  .item { display: grid; gap: 1.8rem; }
  .lead { font-family: var(--display); font-weight: 600; font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.05; margin-bottom: .6rem; }
  .itext p { max-width: 32rem; }
  .polas { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem .9rem; padding: .4rem; }
  .pola { background: var(--paper-light); padding: .4rem .4rem 1.3rem; box-shadow: var(--shadow-paper); }
  .pola :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .p1 { transform: rotate(-2.5deg); } .p2 { transform: rotate(2deg) translateY(.8rem); } .p3 { transform: rotate(1.4deg); } .p4 { transform: rotate(-2deg) translateY(.6rem); }
  .p5 { transform: rotate(2.6deg); } .p6 { transform: rotate(-1.4deg) translateY(.8rem); } .p7 { transform: rotate(-2.2deg); } .p8 { transform: rotate(1.8deg) translateY(.5rem); }
  .duo { display: grid; gap: 2rem; }
  .side { padding: 1rem; position: relative; }
  .villa { background: #2A1B16; color: var(--paper-light); transform: rotate(-.6deg); }
  .apt { background: var(--paper-light); box-shadow: var(--shadow-paper); transform: rotate(.6deg); }
  .cap { font-size: 1.05rem; margin-bottom: .7rem; }
  .villa .cap :global(.ph) { box-shadow: none; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  .two :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .two :global(img.wide) { grid-column: 1 / -1; aspect-ratio: 16 / 10; }
  .flip { appearance: none; cursor: pointer; border: 0; font-family: var(--serif); font-size: 1rem; padding: .55rem .9rem; min-height: 44px; border-radius: 3px; transition: transform .2s var(--ease); }
  .flip:hover { transform: translateY(-2px) rotate(-1deg); box-shadow: inset 0 0 0 1.5px var(--ph-ink); }
  .catwrap { padding: 1rem 0 .5rem; }
  .masonry { columns: 2; column-gap: .8rem; }
  .masonry :global(img) { width: 100%; height: auto; margin-bottom: .8rem; break-inside: avoid; }

  /* closing */
  .closing { background: var(--paper-deep); padding: clamp(5rem, 14vw, 10rem) 0 clamp(8rem, 24vw, 16rem); position: relative; text-align: center; }
  .cl { font-size: clamp(1.3rem, 3vw, 1.9rem); max-width: 34rem; margin: 0 auto 1.4rem; line-height: 1.45; }
  .dream { font-family: var(--display); font-style: italic; font-weight: 300; font-size: clamp(2.8rem, 11vw, 8.5rem); line-height: .98; letter-spacing: -.03em; margin: clamp(5rem, 16vw, 11rem) auto 0; max-width: 14ch; color: var(--oxblood); }
  .pull-line { position: absolute; left: 50%; bottom: 0; width: 1.5px; height: clamp(4rem, 12vw, 8rem); background: var(--ink); transform-origin: top; animation: draw 2.6s var(--ease) infinite; }
  @keyframes draw { 0% { transform: scaleY(0); } 60%, 100% { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) { .pull-line { animation: none; } }

  @media (min-width: 700px) {
    .masonry { columns: 3; }
    .duo { grid-template-columns: 1fr 1fr; align-items: start; }
    .polas { grid-template-columns: repeat(4, 1fr); }
    .part-list { grid-template-columns: 1fr 1fr; column-gap: 3rem; }
  }
  @media (min-width: 960px) {
    .open { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; }
    .acc-in { grid-template-columns: 1.1fr .9fr; column-gap: 4rem; align-items: center; }
    .acc-sub { grid-column: 1; grid-row: 2; }
    .defn { grid-column: 1; grid-row: 3; }
    .acc-photo { grid-column: 2; grid-row: 2 / 4; }
    .item { grid-template-columns: 1fr 1.5fr; gap: 3.5rem; align-items: start; }
    .item.spaces, .item.gal, .item.catitem { grid-template-columns: 1fr; }
    .catitem { grid-template-columns: 1fr 1.7fr; align-items: center; }
    .masonry { columns: auto; display: grid; grid-template-columns: 1fr 1.05fr 1fr; grid-template-rows: 15rem 15rem; gap: .9rem; }
    .masonry :global(img) { height: 100%; margin: 0; }
    .masonry :global(.g2) { grid-row: 1 / 3; grid-column: 2; }
    .masonry :global(.g1) { grid-column: 1; grid-row: 1; } .masonry :global(.g4) { grid-column: 1; grid-row: 2; }
    .masonry :global(.g3) { grid-column: 3; grid-row: 1; } .masonry :global(.g5) { grid-column: 3; grid-row: 2; }
    .film-row { justify-content: center; }
    .film-row li { width: 15.5rem; }
    .s2, .s4 { transform: translateY(1.2rem); } .s1 { transform: rotate(-1deg); } .s3 { transform: rotate(1deg); } .s5 { transform: rotate(-1.5deg) translateY(.6rem); }
  }
</style>
