---
import Slot from './Slot.astro';
import Photo from './Photo.astro';
import { ch02, ui, splitDate, type Block, pages, imageMeta, sidePageBody } from '../lib/data';
import { inline, leadSplit, esc, slug, textOf, externalLink } from '../lib/md';

type Sec = { h: string; lvl: 3 | 4; body: Block[] };
const P = ch02.pages;
// split a page into headed sections (h3 / h4); `pre` = blocks before the first heading
function sections(key: string) {
  const pre: Block[] = [], out: Sec[] = [];
  for (const b of P[key] ?? []) {
    if (b.t === 'h3' || b.t === 'h4') out.push({ h: b.text, lvl: b.t === 'h3' ? 3 : 4, body: [] });
    else (out.length ? out[out.length - 1].body : pre).push(b);
  }
  return { pre, secs: out };
}
const ptxt = (bs: Block[]) => bs.filter((b): b is Extract<Block, { t: 'p' }> => b.t === 'p').map((b) => b.text);
const lists = (bs: Block[]) => bs.filter((b): b is Extract<Block, { t: 'ul' }> => b.t === 'ul').map((b) => b.items);
const numTitle = (h: string) => { const m = /^(\d+)\s*[·.]\s*(.*)$/.exec(h); return m ? { n: m[1], t: m[2] } : { n: '', t: h }; };
const colonSplit = (h: string) => { const i = h.indexOf(':'); return i > 0 ? { label: h.slice(0, i).trim(), title: h.slice(i + 1).trim() } : { label: '', title: h }; };

// ---- P1 ----
const p1 = sections('p1');
const p1Name = p1.secs[0]?.h ?? '';
const p1Roles = (lists(p1.secs[0]?.body ?? [])[0] ?? []).map(splitDate);
const p1p = ptxt(p1.secs[0]?.body ?? []);
const p1Foot = p1p[0];

// ---- P2 ----
const p2 = sections('p2');
const p2About = p2.secs[0]?.h ?? '';
const p2BriefH = p2.secs[1]?.h ?? '';
const p2Sub = ptxt(p2.secs[1]?.body ?? [])[0] ?? '';            // the sub head right after "The brief"
const p2Intro = ptxt(p2.secs[1]?.body ?? [])[1] ?? '';
const p2Items = (lists(p2.secs[1]?.body ?? [])[0] ?? []).map((t) => { const { lead, rest } = leadSplit(t); const m = /^(\d+)\.\s*(.*)$/.exec(lead); return { n: m?.[1] ?? '', lead: m?.[2] ?? lead, rest }; });

// ---- P3 ----
const p3 = sections('p3');
const p3Head = numTitle(p3.secs[0]?.h ?? '');
const p3PackH = p3.secs[1]?.h ?? '';
const p3PackP = ptxt(p3.secs[1]?.body ?? []);
const p3Pillars = (lists(p3.secs[1]?.body ?? [])[0] ?? []).map(leadSplit);
const wrap = p3.secs.find((s) => /wrap/i.test(s.h));
const bag = p3.secs.find((s) => /bag/i.test(s.h));
const splitDash = (h: string) => { const i = h.indexOf(' - '); return i > 0 ? { t: h.slice(0, i), sub: h.slice(i + 3) } : { t: h, sub: '' }; };

// ---- P4 ----
const p4 = sections('p4');
const p4Head = colonSplit(p4.secs[0]?.h ?? '');
const p4Items = lists(p4.secs[0]?.body ?? [])[0] ?? [];

// ---- P5 ----
const p5 = sections('p5');
const p5Head = numTitle(p5.secs[0]?.h ?? '');
const p5p = ptxt(p5.secs[0]?.body ?? []);
const p5Image = colonSplit(p5.secs[1]?.h ?? '');
const p5ImageP = ptxt(p5.secs[1]?.body ?? [])[0] ?? '';
const p5ImageItems = lists(p5.secs[1]?.body ?? [])[0] ?? [];
const p5Voice = colonSplit(p5.secs[2]?.h ?? '');
const p5VoiceP = ptxt(p5.secs[2]?.body ?? []);
// "That small gesture became our signature. Customers ... said, “…” “…”" -> sentence + the two quotes
const gesture = p5p[4] ?? '';
const gQuotes = [...gesture.matchAll(/“[^”]+”/g)].map((m) => m[0]);
const gSentence = inline(gesture.replace(/\s*“[^”]+”/g, '').replace(/\s+$/, ''));
const pullPhrase = 'break it, and pull it apart';
const km = /^([\s\S]*?)\*\*([^*]+?):\s*(break it, and pull it apart\.)\*\*\s*([\s\S]*)$/.exec(p5p[2] ?? '');
const kBefore = km ? inline(km[1].trim()) : inline(p5p[2] ?? '');
const kLead = km ? km[2] + ':' : '';
const kKey = km ? km[3] : '';
const kAfter = km ? inline(km[4].trim()) : '';
// the five reels, left to right: picture n goes with link n (Cam Anh, Oct 26 R3: pictures 1 and 3 had been mixed up)
const reelOrder = [1, 2, 3, 4, 5];
// Tết 2025: the two small videos swap their links (R3)
const mochiLink = [0, 2, 1];
const voiceShop = 'a cordial, welcoming and confident baker';
const voiceHtml = inline(p5VoiceP[1] ?? '').replace(esc(voiceShop), `<mark class="pull">${esc(voiceShop)}</mark>`);

// ---- P6 ----
const p6 = sections('p6');
const p6Head = numTitle(p6.secs[0]?.h ?? '');
const p6Seasons = (lists(p6.secs[0]?.body ?? [])[0] ?? []).map(leadSplit);
const p6Small = p6.secs[1]?.h ?? '';
const mochi = p6.secs.find((x) => /mochi/i.test(x.h));
const mochiHead = (() => { const i = (mochi?.h ?? '').indexOf(' · '); return i > 0 ? { y: mochi!.h.slice(0, i), t: mochi!.h.slice(i + 3) } : { y: '', t: mochi?.h ?? '' }; })();
const mochiAll = ptxt(mochi?.body ?? []);
const mochiResultsLabel = mochiAll.find((t) => /^\*\*results/i.test(t)) ?? '';
const mochiP = mochiAll.filter((t) => t !== mochiResultsLabel);
const mochiResults = lists(mochi?.body ?? [])[0] ?? [];
const mochiIntro = mochiP[0] ?? '';                       // the first paragraph sits on the left, under the heading
const mochiRest = mochiP.slice(1);
// "The challenge" gets a thin, hand-drawn red ring (drawn when it scrolls into view)
const ring = '<svg class="ring" viewBox="0 0 120 40" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M8 24 C6 10 40 3 78 5 C108 7 119 17 109 28 C98 38 55 39 25 35 C9 32 2 20 14 12"/></svg>';
const withRing = (h: string) => h.replace('<strong>The challenge</strong>', `<strong class="circled">The challenge${ring}</strong>`);
const L = ch02.links;                                     // video addresses (BUILD NOTE lines in the content file)
const lead = p6.secs.find((x) => /led the way/i.test(x.h))?.h ?? '';     // the conclusion of the three ideas above
const gia = p6.secs.find((x) => /collab/i.test(x.h));
const giaHead = splitDash(gia?.h ?? '');
const giaItems = lists(gia?.body ?? [])[0] ?? [];

// ---- P7 ----
const p7 = sections('p7');
const p7Head = numTitle(p7.secs[0]?.h ?? '');
const p7Body = p7.secs[0]?.body ?? [];
const years: { y: string; name: string; items: string[]; subs: string[][] }[] = [];
for (let i = 0; i < p7Body.length; i++) {
  const b = p7Body[i];
  if (b.t === 'p') {
    const t = b.text.replace(/^\*\*|\*\*$/g, '');
    const j = t.indexOf(' · ');
    const nx = p7Body[i + 1];
    years.push({ y: j > 0 ? t.slice(0, j) : t, name: j > 0 ? t.slice(j + 3) : '', items: nx && nx.t === 'ul' ? nx.items : [], subs: nx && nx.t === 'ul' ? (nx.subs ?? []) : [] });
  }
}

// the three covers open galleries (layouts by Cam Anh, Oct 21): rows of photos that share a height, two columns, or a collage with a scrolling strip
const covers = ['ly-7-1', 'ly-7-2', 'ly-7-3'];
const ar = (id: string) => { const m = imageMeta[id]; return m ? m.width / m.height : 1; };
const galleries: { rows?: string[][]; cols?: string[][]; strip?: string[] }[] = [
  { rows: [['ly-4-2', 'ly-71-a'], ['ly-71-b', 'ly-71-c'], ['ly-71-d', 'ly-71-e'], ['ly-71-f', 'ly-71-g']] },
  { cols: [['ly-72-a', 'ly-7-2', 'ly-72-d', 'ly-72-f', 'ly-72-h'], ['ly-72-b', 'ly-72-c', 'ly-72-e', 'ly-72-g']] },
  { rows: [['ly-73-a', 'ly-73-b'], ['ly-73-c', 'ly-73-d'], ['ly-73-e', 'ly-7-3']], strip: ['ly-73s-1', 'ly-73s-2', 'ly-73s-3', 'ly-73s-4', 'ly-73s-5', 'ly-73s-6', 'ly-73s-7'] },
];
const galleryNote = sidePageBody('Store Opening')[0] ?? '';   // the sentence that used to open as a side page now captions the store gallery

// ---- P8 ----
const p8 = sections('p8');
const p8Raw = p8.secs[0]?.h ?? '';
const p8Num = numTitle(p8Raw);
const p8Parts = p8Num.t.split('/').map((x) => x.trim());
const p8Title = p8Parts[p8Parts.length - 1];            // the big words: "What changed"
const p8Pre = p8Parts.slice(0, -1).join(' / ');          // the small words before it, kept as written
const p8Items = lists(p8.secs[0]?.body ?? [])[0] ?? [];

// ---- P9 ----
const p9 = ptxt(P['p9'] ?? []);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<article id="ch-02" class="c2" aria-labelledby="c2-title">
  <a class="back label" href={`${pages.home}#contents`}>{ui.back}</a>

  <!-- P1: opening spread -->
  <section class="p1">
    <header class="p1-head">
      <p class="p1-num label">{ch02.num}</p>
      <h2 id="c2-title" class="p1-title">{ch02.title}</h2>
      <p class="p1-hint">{ch02.hint}</p>
    </header>
    <h3 class="p1-giant">{p1Name}</h3>
    <div class="p1-right">
      <figure class="p1-slot"><Photo id="ly-1-1" sizes="(min-width: 900px) 30vw, 80vw" loading="eager" /></figure>
      <p class="p1-foot" set:html={inline(p1Foot ?? '')} />
    </div>
    <div class="p1-side">
      <ul class="p1-roles">
        {p1Roles.map((r) => <li><span class="d">{r.date}</span><span class="r" set:html={inline(r.text)} /></li>)}
      </ul>
    </div>
  </section>

  <!-- P2: about + the brief -->
  <section class="p2">
    <div class="p2-about">
      <button type="button" class="sp sp-photo" data-sp={slug(p2About)} data-side="left" aria-haspopup="dialog">
        <span class="k">{p2About}</span>
        <Photo id="ly-2-1" sizes="(min-width: 900px) 40vw, 90vw" />
        <span class="sp-more" aria-hidden="true">→</span>
      </button>
      <p class="p2-sub" set:html={inline(p2Sub)} />
    </div>
    <div class="p2-brief">
      <h3 class="p2-h">{p2BriefH}</h3>
      <p class="p2-intro" set:html={inline(p2Intro)} />
      <ol class="p2-items">
        {p2Items.map((it) => (
          <li><span class="n" aria-hidden="true">{it.n}</span><div><h4 class="il">{it.lead}</h4><p set:html={inline(it.rest)} /></div></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- P3: gift worth owning: packaging, the wrap, the signature bag -->
  <section class="p3">
    <header class="p3-head">
      <p class="p3-num" aria-hidden="true">{p3Head.n}</p>
      <h3 class="p3-title">{p3Head.t}</h3>
    </header>

    <div class="p3-pack">
      <div class="p3-packtext">
        <h4 class="k part part-1">{p3PackH}</h4>
        <p class="p3-want">{p3PackP[0]}</p>
        <ul class="pillars">
          {p3Pillars.map((p, i) => <li class={`pl pl${i + 1}`}><h5>{p.lead}</h5><p set:html={inline(p.rest)} /></li>)}
        </ul>
      </div>
      <div class="p3-t3">
        <p class="p3-renewed" set:html={inline(p3PackP[1] ?? '')} />
        <div class="p3-ba">
          <Photo id="ly-3-1" sizes="(min-width: 900px) 55vw, 90vw" />
          <span class="arrow" aria-hidden="true">→</span>
          <Photo id="ly-3-2" sizes="(min-width: 900px) 55vw, 90vw" />
        </div>
      </div>
    </div>

    {wrap && (
      <div class="p3-wrap">
        <h4 class="h4i">{splitDash(wrap.h).t}<span class="sub">{splitDash(wrap.h).sub}</span></h4>
        <div class="stages">
          <div class="stage s1"><span class="no label">1</span><p set:html={inline(ptxt(wrap.body)[0] ?? '')} /><Photo id="ly-3-3" sizes="(min-width: 900px) 45vw, 90vw" /></div>
          <div class="stage s2"><span class="no label">2</span><p set:html={inline(ptxt(wrap.body)[1] ?? '')} /><Photo id="ly-3-4" sizes="(min-width: 900px) 40vw, 85vw" /></div>
        </div>
      </div>
    )}

  </section>

  <!-- the signature-bag page: the background picture runs behind the whole page (bag story + the Marou line) -->
  <section class="bagpage">
    {bag && (
      <div class="p3-bag">
        <div class="bagtext">
          <h4 class="h4i">{splitDash(bag.h).t}<span class="sub">{splitDash(bag.h).sub}</span></h4>
          <p class="b0" set:html={inline(ptxt(bag.body)[0] ?? '')} />
          <p class="b1" set:html={inline(ptxt(bag.body)[1] ?? '')} />
          <p class="b2" set:html={inline(ptxt(bag.body)[2] ?? '')} />
          <p class="b3" set:html={inline(ptxt(bag.body)[3] ?? '')} />
        </div>
        <div class="bagright">
          <div class="bagpanel">
            <Photo id="ly-bag-1" class="bp1" sizes="(min-width: 900px) 24vw, 40vw" />
            <Photo id="ly-bag-3" class="bp2" sizes="(min-width: 900px) 18vw, 30vw" />
            <Photo id="ly-bag-2" class="bp3" sizes="(min-width: 900px) 18vw, 30vw" />
          </div>
          <div class="seasonal">
            <Photo id="ly-seasonal-2" class="sb1" sizes="(min-width: 900px) 20vw, 30vw" />
            <Photo id="ly-seasonal-front-pink" class="sb2" sizes="(min-width: 900px) 16vw, 25vw" />
            <Photo id="ly-seasonal-1" class="sb3" sizes="(min-width: 900px) 20vw, 30vw" />
            <Photo id="ly-seasonal-front-green" class="sb4" sizes="(min-width: 900px) 16vw, 25vw" />
          </div>
          <p class="seasonal-cap" set:html={inline(ptxt(bag.body)[4] ?? '')} />
        </div>
      </div>
    )}

  <!-- a short page of its own: the Marou line, set to the right -->
  {bag && ptxt(bag.body)[5] && (
    <div class="lux wrap"><p class="reveal" set:html={inline(ptxt(bag.body)[5])} /></div>
  )}
  </section>

  <!-- P4: brand's image, a wall of photos -->
  <section class="p4">
    <div class="wall">
      <div class="wr r1">
        <figure class="a rvl"><button type="button" class="zb" data-lb-group="p4" aria-label={ui['open album']}><Photo id="ly-4-1" sizes="(min-width: 900px) 28vw, 90vw" /></button></figure>
        <div class="p4-text">
          <p class="k part part-2">{p4Head.label}</p>
          <h3 class="p4-title">{p4Head.title}</h3>
          <ul class="p4-items">
            {p4Items.map((t, i) => <li class={`i${i + 1}`}><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span set:html={inline(t)} /></li>)}
          </ul>
        </div>
        <figure class="b rvl"><button type="button" class="zb" data-lb-group="p4" aria-label={ui['open album']}><Photo id="ly-4-2" sizes="(min-width: 900px) 36vw, 45vw" /></button></figure>
        <figure class="c rvl"><button type="button" class="zb" data-lb-group="p4" aria-label={ui['open album']}><Photo id="ly-4-3" sizes="(min-width: 900px) 36vw, 45vw" /></button></figure>
      </div>
      <div class="wr r2">
        <figure class="rvl"><button type="button" class="zb" data-lb-group="p4" aria-label={ui['open album']}><Photo id="ly-4-4" sizes="(min-width: 900px) 46vw, 45vw" /></button></figure>
        <figure class="rvl"><button type="button" class="zb" data-lb-group="p4" aria-label={ui['open album']}><Photo id="ly-4-5" sizes="(min-width: 900px) 30vw, 45vw" /></button></figure>
        <figure class="rvl"><button type="button" class="zb" data-lb-group="p4" aria-label={ui['open album']}><Photo id="ly-4-6" sizes="(min-width: 900px) 22vw, 45vw" /></button></figure>
      </div>
      <div class="wr r3">
        <figure class="rvl"><button type="button" class="zb" data-lb-group="p4" aria-label={ui['open album']}><Photo id="ly-4-7" sizes="(min-width: 900px) 34vw, 45vw" /></button></figure>
        <figure class="rvl"><button type="button" class="zb" data-lb-group="p4" aria-label={ui['open album']}><Photo id="ly-4-8" sizes="(min-width: 900px) 37vw, 45vw" /></button></figure>
        <figure class="rvl"><button type="button" class="zb" data-lb-group="p4" aria-label={ui['open album']}><Photo id="ly-4-9" sizes="(min-width: 900px) 28vw, 45vw" /></button></figure>
      </div>
    </div>
  </section>

  <!-- P5: THE HERO. "Show it the way it's meant to be enjoyed": a mooncake that breaks apart as you scroll -->
  <section class="p5" data-pull>
    <div class="pull-track">
      <div class="stick">
        <p class="h5-num" aria-hidden="true">{p5Head.n}</p>
        <h3 class="h5-title">{p5Head.t}</h3>
        <span class="filling" aria-hidden="true"></span>
        <div class="moon" aria-hidden="true">
          <div class="half hl"><div class="disc"><Photo id="ly-5-break" alt="" sizes="(min-width: 900px) 62svh, 74vw" /></div></div>
          <div class="half hr"><div class="disc"><Photo id="ly-5-break" alt="" sizes="(min-width: 900px) 62svh, 74vw" /></div></div>
        </div>
      </div>
    </div>

    <div class="p5-kitchen wrap">
      <div class="owner"><p set:html={inline(p5p[0] ?? '')} /><p class="owner2" set:html={inline(p5p[1] ?? '')} /></div>
      <div class="kcol">
        <Photo id="ly-5-baker" class="kc1" sizes="(min-width: 900px) 12vw, 40vw" />
        <Photo id="ly-5-racks" class="kc2" sizes="(min-width: 900px) 16vw, 50vw" />
        <video class="lyv kc3" muted loop playsinline preload="none" poster={`${base}img/lyv-pull-poster-960.webp`} data-hd={`${base}video/lyv-pull-hd.mp4`} data-sd={`${base}video/lyv-pull-sd.mp4`} aria-label={imageMeta['ly-5-pull']?.alt ?? ''}></video>
      </div>
      <div class="kt">
        <p set:html={kBefore} />
        {kKey && <p class="key"><span class="key-lead">{kLead}</span><span class="key-phrase">{kKey}</span></p>}
        {kAfter && <p set:html={kAfter} />}
        <p class="shot" set:html={inline(p5p[3] ?? '')} />
      </div>
      <Photo id="ly-5-balls" class="kballs" sizes="(min-width: 900px) 24vw, 70vw" />
    </div>

    <div class="p5-signature">
      <div class="sig-in">
        <p class="gs" set:html={gSentence} />
        {gQuotes.map((q, i) => <p class={`gq gq${i + 1}`}>{q}</p>)}
      </div>
    </div>

    <div class="p5-library wrap">
      <div class="lib-text"><p set:html={inline(p5p[5] ?? '')} /><p set:html={inline(p5p[6] ?? '')} /><p set:html={inline(p5p[7] ?? '')} /></div>
      <div class="reels">
        {reelOrder.map((n, i) => (
          <a class={`reel r${i + 1}`} href={L.reels?.[n - 1] ?? '#'} target="_blank" rel="noopener noreferrer" aria-label={`${ui.reel} ${i + 1} (${ui['new tab']})`}>
            <Photo id={`ly-reel-${n}`} sizes="(min-width: 900px) 14vw, 20vw" />
            <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
            <span class="out" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>

    <div class="p5-two wrap">
      <div class="reg">
        <p class="k part part-2 again"><span class="ret" aria-hidden="true">↺</span>{p5Image.label}</p>
        <h4 class="reg-t">{p5Image.title}</h4>
        <p class="reg-p" set:html={inline(p5ImageP)} />
        <ul class="reg-l">{p5ImageItems.map((t) => <li set:html={inline(t)} />)}</ul>
      </div>
      <Photo id="ly-5-pull" class="reg-a" sizes="(min-width: 900px) 28vw, 90vw" />
      <Photo id="ly-5-still" class="reg-b" sizes="(min-width: 900px) 28vw, 90vw" />
    </div>

    <div class="p5-voice">
      <div class="voice-in wrap">
        <div class="vt">
          <p class="k part part-3">{p5Voice.label}</p>
          <h4 class="vh">{p5Voice.title}</h4>
          <p set:html={inline(p5VoiceP[0] ?? '')} />
          <p class="vsecond" set:html={voiceHtml} />
        </div>
        <p class="vnote" set:html={inline(p5VoiceP[2] ?? '')} />
      </div>
    </div>
  </section>

  <!-- P6: keep the season going -->
  <section class="p6">
    <header class="p6-head wrap">
      <p class="p6-num" aria-hidden="true">{p6Head.n}</p>
      <h3 class="p6-title">{p6Head.t}</h3>
    </header>
    <div class="p6-cards wrap">
      {p6Seasons.map((s, i) => <article class={`sc sc${i + 1}`}><h4>{s.lead}</h4><p set:html={inline(s.rest)} /></article>)}
    </div>
    <p class="p6-strip label">{p6Small}</p>

    <div class="mochi wrap">
      <div class="mo-head"><p class="mo-y">{mochiHead.y}</p><h4 class="mo-t">{mochiHead.t}</h4></div>
      <p class="mo-intro" set:html={inline(mochiIntro)} />
      <div class="mo-p">
        {mochiRest.map((t) => <p set:html={withRing(inline(t))} />)}
      </div>
      <div class="phones">
        {[0, 1, 2].map((k) => (
          <a class="reel" href={L.mochi?.[mochiLink[k]] ?? '#'} target="_blank" rel="noopener noreferrer" aria-label={`${ui.reel} ${k + 1} (${ui['new tab']})`}>
            <Photo id={`ly-mochi-${k + 1}`} sizes="(min-width: 900px) 20vw, 50vw" />
            <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
            <span class="out" aria-hidden="true">↗</span>
          </a>
