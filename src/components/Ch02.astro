  @media (min-width: 900px) { .panels { grid-template-columns: repeat(3, 1fr); } .y2 { padding-top: calc(clamp(2rem, 4vw, 3.5rem) + 4rem); } .y3 { padding-top: calc(clamp(2rem, 4vw, 3.5rem) + 8rem); } .panel { padding-bottom: 5rem; } }

  /* ---------- P8 ---------- */
