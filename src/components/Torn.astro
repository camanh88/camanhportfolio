---
// A torn paper edge as an SVG. Jitter is seeded so the build is deterministic.
interface Props { color?: string; seed?: number; flip?: boolean; height?: number }
const { color = 'var(--paper-deep)', seed = 1, flip = false, height = 22 } = Astro.props;
let s = seed * 9301 + 49297;
const rnd = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
const pts: string[] = [];
const N = 90;
for (let i = 0; i <= N; i++) pts.push(`${(i / N) * 1000},${(6 + rnd() * 12 + (i % 7 === 0 ? rnd() * 5 : 0)).toFixed(1)}`);
const d = `M0,${height} L0,10 L${pts.join(' L')} L1000,${height} Z`;
---
<svg class="torn" viewBox={`0 0 1000 ${height}`} preserveAspectRatio="none" aria-hidden="true" style={`display:block;width:100%;height:${height * 0.9}px;transform:${flip ? 'scaleY(-1)' : 'none'}`}>
  <path d={d} fill={color}></path>
</svg>
