---
import Photo from './Photo.astro';
import { intro, ui } from '../lib/data';
import { inline } from '../lib/md';
const tints = ['var(--forest)', 'var(--teal)', 'var(--oxblood)', 'var(--tomato)'];
const tiles = intro.skills.items.map((it, i) => ({ ...it, id: `skill-${i + 1}`, tint: tints[i % 4], name: it.lead.replace(/:$/, ''), list: it.rest.split(' · ') }));
---
<section id="skills" class="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <h2 id="skills-title" class="title reveal">{intro.skills.title}</h2>
    <ul class="grid">
      {tiles.map((t, i) => (
        <li class="tile reveal" data-tile style={`--tint:${t.tint}`}>
          <Photo id={t.id} sizes="(min-width: 760px) 50vw, 100vw" />
          <div class="inner">
            <h3 id={`sk-h-${i}`} class="name">{t.name}</h3>
            <p class="list">{t.rest}</p>
          </div>
          <span class="plus" aria-hidden="true"></span>
          <button type="button" class="open" aria-haspopup="dialog" aria-labelledby={`sk-x-${i} sk-h-${i}`} data-open={i}><span id={`sk-x-${i}`} class="sr-only">{ui.expand}:</span></button>
        </li>
      ))}
    </ul>
  </div>

  {tiles.map((t, i) => (
    <dialog class="full" data-full={i} aria-labelledby={`sk-fh-${i}`} style={`--tint:${t.tint}`}>
      <Photo id={t.id} sizes="100vw" />
      <button type="button" class="x" aria-label={ui.close}>
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/></svg>
      </button>
      <div class="body">
        <h3 id={`sk-fh-${i}`} class="big">{t.name}</h3>
        <ul class="items">{t.list.map((x) => <li>{x}</li>)}</ul>
      </div>
    </dialog>
  ))}
</section>

<style>
  .skills { background: var(--forest); color: #fff; padding: var(--section) 0; }
  .title { font-size: clamp(2.6rem, 8vw, 7rem); line-height: .95; letter-spacing: -.03em; margin-bottom: clamp(3rem, 8vw, 6rem); }
  .grid { display: grid; gap: 1px; grid-template-columns: 1fr; background: var(--hair-light); }
  .tile { position: relative; isolation: isolate; min-height: clamp(24rem, 62vw, 31rem); overflow: hidden; background: var(--dark); }
  .tile::after { content: ''; position: absolute; inset: 0; background: var(--tint); mix-blend-mode: multiply; opacity: .6; z-index: -1; transition: opacity .8s var(--ease); }
  .tile:hover::after { opacity: .4; }
  .tile :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(.78) saturate(.95); z-index: -2; transition: transform 1.6s var(--ease), filter .8s var(--ease); }
  .tile:hover :global(img) { transform: scale(1.035); filter: brightness(.9) saturate(1); }
  .inner { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(1.5rem, 3vw, 2.5rem); pointer-events: none; }
  .name { font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.02; letter-spacing: -.02em; font-weight: 300; }
  .list { margin-top: 1rem; font-size: .9rem; line-height: 1.6; max-width: 34rem; color: rgb(255 255 255 / .92); }
  .plus { position: absolute; top: 1.5rem; right: 1.5rem; width: 1.5rem; height: 1.5rem; pointer-events: none; opacity: .8; }
  .plus::before, .plus::after { content: ''; position: absolute; background: currentColor; }
  .plus::before { left: 0; right: 0; top: 50%; height: 1px; } .plus::after { top: 0; bottom: 0; left: 50%; width: 1px; }
  .open { position: absolute; inset: 0; width: 100%; background: transparent; border: 0; cursor: zoom-in; }
  .open:focus-visible { outline: 2px solid var(--paper); outline-offset: -6px; }

  /* full-screen view */
  .full { width: 100%; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: var(--tint, var(--forest)); color: #fff; overflow: hidden; opacity: 0; transition: opacity .5s var(--ease); }
  .full.is-open { opacity: 1; }
  .full::backdrop { background: var(--forest); }
  .full > :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(.4) saturate(.9); }
  .full::after { content: ''; position: absolute; inset: 0; background: var(--tint); mix-blend-mode: multiply; opacity: .75; pointer-events: none; }
  .x { position: absolute; top: 1rem; right: 1rem; z-index: 3; width: 3rem; height: 3rem; display: grid; place-items: center; background: transparent; border: 0; cursor: pointer; color: var(--paper); }
  .x:hover { opacity: .65; }
  .body { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 8vw, 8rem); gap: clamp(2rem, 5vw, 4rem); overflow-y: auto; }
  .big { font-size: clamp(2.6rem, 8vw, 7rem); line-height: .95; letter-spacing: -.03em; max-width: 14ch; }
  .items { display: grid; gap: .5rem 3rem; font-family: var(--display); font-size: clamp(1.35rem, 2.6vw, 2.1rem); line-height: 1.25; max-width: 60rem; }
  .items li { padding-top: .6rem; border-top: 1px solid var(--hair-light); }
  @media (min-width: 760px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .items { grid-template-columns: 1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .full, .tile :global(img) { transition: none; } }
</style>

<script>
  const dialogs = [...document.querySelectorAll<HTMLDialogElement>('[data-full]')];
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  let opener: HTMLElement | null = null;
  const close = (d: HTMLDialogElement) => {
    d.classList.remove('is-open');
    const done = () => { d.close(); document.documentElement.classList.remove('sk-open'); opener?.focus(); };
    reduce() ? done() : setTimeout(done, 350);
  };
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => {
    const d = dialogs[Number(b.dataset.open)];
    opener = b; d.showModal(); document.documentElement.classList.add('sk-open');
    requestAnimationFrame(() => d.classList.add('is-open'));
  }));
  dialogs.forEach((d) => {
    d.addEventListener('cancel', (e) => { e.preventDefault(); close(d); });
    d.querySelector('.x')!.addEventListener('click', () => close(d));
    d.addEventListener('click', (e) => { if (e.target === d) close(d); });
  });
</script>
