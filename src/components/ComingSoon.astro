---
import Torn from './Torn.astro';
import { contents, BUILT, ui, backLabel } from '../lib/data';
import { inline } from '../lib/md';
const tone: Record<string, [string, string]> = {
  '03': ['var(--mustard)', 'var(--ink)'], '04': ['var(--blush)', 'var(--ink)'], '05': ['var(--forest)', 'var(--paper-light)'], '06': ['var(--tomato)', 'var(--paper-light)'],
};
const chapters = contents.rows.filter((r) => !r.sub && !BUILT.has(r.num)).map((r) => ({ ...r, subs: contents.rows.filter((s) => s.sub && s.num === r.num), c: tone[r.num]?.[0] ?? 'var(--paper-deep)', t: tone[r.num]?.[1] ?? 'var(--ink)' }));
---
{chapters.map((c, i) => (
  <section id={`ch-${c.num}`} class="cs" style={`--c:${c.c};--t:${c.t}`} aria-labelledby={`ch-${c.num}-title`}>
    {i === 0 && <div class="top"><Torn color="var(--c)" seed={21} /></div>}
    <a class="back mono" href="#contents">{backLabel}</a>
    <div class="wrap inner">
      <span class="n" aria-hidden="true">{c.num}</span>
      <div class="txt">
        <h2 id={`ch-${c.num}-title`} set:html={inline(c.title)} />
        {c.teaser && <p class="te" set:html={inline(c.teaser)} />}
        {c.subs.length > 0 && (
          <ul class="sl">{c.subs.map((s) => <li><span aria-hidden="true">↳</span> {s.title}</li>)}</ul>
        )}
        <p class="tag mono">{ui['coming soon']}</p>
      </div>
    </div>
  </section>
))}

<style>
  .cs { background: var(--c); color: var(--t); position: relative; padding: clamp(2.5rem, 7vw, 4.5rem) 0 clamp(3rem, 8vw, 5rem); overflow-x: clip; }
  .top { position: absolute; left: 0; right: 0; top: 0; transform: translateY(-100%); z-index: 1; }
  .back { position: sticky; top: .75rem; z-index: 30; width: fit-content; margin: 0 max(var(--gutter), calc((100% - var(--wide)) / 2)) 1.5rem auto; padding: .6rem .9rem; min-height: 44px; display: flex; align-items: center; text-decoration: none; background: var(--paper-light); color: var(--ink); border: 1.5px solid var(--ink); border-radius: 3px 3px 12px 3px; box-shadow: 2px 3px 0 var(--ink); font-size: .74rem; }
  .inner { display: grid; gap: .5rem 2rem; align-items: center; grid-template-columns: auto 1fr; }
  .n { font-family: var(--script); font-size: clamp(5.5rem, 22vw, 11rem); line-height: .8; opacity: .95; }
  h2 { font-family: var(--display); font-weight: 300; font-size: clamp(1.8rem, 6vw, 3.2rem); line-height: 1.05; letter-spacing: -.02em; }
  .te { margin-top: .5rem; font-style: italic; font-size: 1.15rem; }
  .sl { margin-top: .8rem; display: grid; gap: .1rem; }
  .tag { display: inline-block; margin-top: 1.1rem; border: 1px solid currentColor; border-radius: 99px; padding: .25rem .8rem; font-size: .7rem; }
  .cs + .cs { border-top: 1.5px dashed color-mix(in srgb, var(--t) 40%, transparent); }
</style>
