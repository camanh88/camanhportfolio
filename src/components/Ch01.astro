---
import ChapterHead from './ChapterHead.astro';
import Timeline from './Timeline.astro';
import { ch01 } from '../lib/data';
import { inline, leadSplit } from '../lib/md';

const exp = ch01.experience!;
const toneFor = (i: number) => (['forest', 'mustard', 'oxblood'] as const)[i] ?? 'forest';
const groups = ch01.sections
  .filter((s) => s.ul.length && s.h !== ch01.skills?.h)
  .map((s, i) => ({
    heading: s === exp ? undefined : s.h,
    level: 4 as const,
    intro: s === exp ? undefined : s.ps[0],
    bars: ch01.bars.filter((b) => b.group === s.h),
    tone: toneFor(i),
  }));
const skillTones = ['teal', 'forest', 'mustard', 'tomato'];
const skills = (ch01.skills?.ps ?? []).map((p, i) => {
  const { lead, rest } = leadSplit(p);
  return { lead: lead.replace(/:$/, ''), colon: /:$/.test(lead), items: rest.split(' · '), tone: skillTones[i % 4] };
});
const how = (ch01.how?.ps ?? []).map((p) => ({ ...leadSplit(p) }));
---
<section id="ch-01" class="chapter" aria-labelledby="ch-01-title">
  <ChapterHead id="ch-01" num={ch01.num} title={ch01.title} teaser={ch01.teaser} />

  <div class="wrap stack">
    <section class="block" aria-labelledby="exp-h">
      <h3 id="exp-h" class="sh">{exp.h}</h3>
      {exp.ps[0] && <p class="spine reveal" set:html={inline(exp.ps[0])} />}
      <Timeline groups={groups} />
    </section>

    {ch01.skills && (
      <section class="block" aria-labelledby="skills-h">
        <h3 id="skills-h" class="sh">{ch01.skills.h}</h3>
        <ul class="skill-grid">
          {skills.map((s) => (
            <li class={`card reveal t-${s.tone}`}>
              <h4 class="card-h">{s.lead}{s.colon && <span class="colon" aria-hidden="true">:</span>}</h4>
              <ul class="chips">
                {s.items.map((it) => <li set:html={inline(it)} />)}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    )}

    {ch01.how && (
      <section class="block" aria-labelledby="how-h">
        <h3 id="how-h" class="sh">{ch01.how.h}</h3>
        <div class="pair">
          {how.map((h, i) => (
            <article class={`duo reveal ${i === 0 ? 'solo' : 'team'}`}>
              <svg class="who" viewBox="0 0 120 56" width="120" height="56" aria-hidden="true" fill="currentColor">
                {i === 0
                  ? <><circle cx="60" cy="14" r="9"/><path d="M42 54c0-17 8-26 18-26s18 9 18 26z"/></>
                  : <><circle cx="24" cy="18" r="7"/><path d="M10 54c0-13 6-20 14-20s14 7 14 20z"/><circle cx="60" cy="12" r="8"/><path d="M45 54c0-16 7-24 15-24s15 8 15 24z"/><circle cx="96" cy="18" r="7"/><path d="M82 54c0-13 6-20 14-20s14 7 14 20z"/></>}
              </svg>
              <h4 class="duo-h" set:html={inline(h.lead.replace(/:$/, ''))} />
              <p set:html={inline(h.rest)} />
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</section>

<style>
  .chapter { background: var(--paper); padding-bottom: clamp(4rem, 10vw, 8rem); }
  .stack { display: grid; gap: clamp(3.5rem, 8vw, 6rem); }
  .sh { font-family: var(--display); font-weight: 300; font-size: clamp(1.9rem, 6vw, 3rem); line-height: 1; letter-spacing: -.02em; margin-bottom: 1.4rem; padding-bottom: .7rem; border-bottom: 1.5px solid var(--ink); display: flex; }
  .spine { font-size: 1.12em; max-width: 36rem; margin-bottom: 2rem; }
  .skill-grid { display: grid; gap: 1.1rem; }
  .card { --c: var(--teal); background: var(--paper-light); border-top: 6px solid var(--c); padding: 1.2rem 1.25rem 1.4rem; box-shadow: 0 1px 0 rgb(30 27 24 / .08), 0 10px 20px -14px rgb(30 27 24 / .4); }
  .t-forest { --c: var(--forest); } .t-mustard { --c: var(--mustard); } .t-tomato { --c: var(--tomato); }
  .card-h { font-family: var(--display); font-weight: 600; font-size: 1.3rem; line-height: 1.2; margin-bottom: .9rem; }
  .colon { opacity: .35; }
  .chips { display: flex; flex-wrap: wrap; gap: .45rem; }
  .chips li { border: 1px solid rgb(30 27 24 / .35); border-radius: 99px; padding: .22rem .75rem .26rem; font-size: .95rem; line-height: 1.35; background: var(--paper); }
  .pair { display: grid; gap: 1.1rem; }
  .duo { padding: 1.5rem 1.4rem 1.7rem; position: relative; }
  .solo { background: var(--teal); color: var(--paper-light); }
  .team { background: var(--forest); color: var(--paper-light); }
  .who { opacity: .85; margin-bottom: 1rem; color: var(--paper); }
  .duo-h { font-family: var(--display); font-weight: 300; font-style: italic; font-size: clamp(1.7rem, 5vw, 2.2rem); line-height: 1.05; margin-bottom: .6rem; }
  @media (min-width: 700px) { .skill-grid { grid-template-columns: 1fr 1fr; } .pair { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .skill-grid { grid-template-columns: repeat(4, 1fr); } .card { padding: 1.3rem 1.2rem 1.5rem; } .duo { padding: 2rem 2rem 2.2rem; } }
</style>
