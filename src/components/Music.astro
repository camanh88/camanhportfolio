---
// Background music: one track for the whole site (Cam Anh, Oct 27). Off by default (browsers do not allow sound without a click).
// Put the track at public/audio/music.mp3; until it is there, nothing is shown. The labels come from content/ui.md.
import { existsSync } from 'node:fs';
import path from 'node:path';
import { ui } from '../lib/data';
const file = ['music.mp3', 'music.m4a'].find((f) => existsSync(path.resolve(process.cwd(), 'public', 'audio', f)));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// no file yet: Cam Anh's chosen track plays through YouTube's own embedded player (content/ui.md, key "music youtube")
const yt = file ? '' : (ui['music youtube'] ?? '').trim();
---
{(file || yt) && (
  <button type="button" class="mu" data-music data-src={file ? `${base}audio/${file}` : ''} data-yt={yt} data-play={ui['music play']} data-pause={ui['music pause']} aria-pressed="false" aria-label={ui['music play']} title={ui['music play']}>
    <span class="mu-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <svg class="mu-off" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 18V6l10-2v12M9 18a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0zm10-2a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
)}
{yt && <div class="mu-card" id="mu-card" hidden><div id="mu-yt"></div></div>}

<style is:global>
  .mu { position: fixed; z-index: 60; right: 4.5rem; bottom: 1rem; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; padding: 0; cursor: pointer; border: 1px solid var(--ink); border-radius: 50%; background: var(--paper); color: var(--ink); transition: background .3s, color .3s, transform .3s var(--ease); }
  .mu:hover, .mu:focus-visible { background: var(--ink); color: var(--paper); }
  .mu .mu-bars { display: none; align-items: flex-end; gap: 2px; height: 1rem; }
  .mu .mu-bars i { display: block; width: 3px; height: 30%; background: currentColor; border-radius: 1px; animation: mubar 1s ease-in-out infinite; }
  .mu .mu-bars i:nth-child(2) { animation-delay: -.3s; } .mu .mu-bars i:nth-child(3) { animation-delay: -.6s; } .mu .mu-bars i:nth-child(4) { animation-delay: -.15s; }
  @keyframes mubar { 0%, 100% { height: 25%; } 50% { height: 100%; } }
  .mu[aria-pressed="true"] .mu-bars { display: flex; }
  .mu[aria-pressed="true"] .mu-off { display: none; }
  .sp-open .mu, .sp-open .mu-card { display: none; }
  .mu-card { position: fixed; z-index: 59; right: 1rem; bottom: 4.6rem; width: 200px; height: 200px; background: #000; box-shadow: 0 .5rem 1.6rem rgb(0 0 0 / .35); }
  .mu-card[hidden] { display: none; }
  .mu-card iframe { display: block; width: 200px; height: 200px; border: 0; }
  @media (prefers-reduced-motion: reduce) { .mu .mu-bars i { animation: none; height: 70%; } }
</style>

<script>
  // One track for the whole site, off by default. Two ways to play it, same button:
  //  - a file (public/audio/music.mp3): an <audio> that is created only when the button is pressed;
  //  - otherwise YouTube's own embedded player (nocookie host, loaded only when the button is pressed), shown as a small 200 x 200 player while the music plays
  //    (YouTube's rules do not allow hiding its player).
  // Fades in and out, loops, pauses while the tab is hidden, remembers on/off and the position across the pages.
  const btn = document.querySelector<HTMLButtonElement>('[data-music]');
  if (btn) {
    const KEY = 'port26-music';
    type Engine = { play(): Promise<boolean>; pause(): void; vol(v?: number): number; time(): number; hide?(): void };
    let eng: Engine | null = null, wanted = false, fade = 0;
    const read = (): { on: boolean; t: number } => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return { on: false, t: 0 }; } };
    const write = () => { try { localStorage.setItem(KEY, JSON.stringify({ on: wanted, t: eng?.time() || read().t || 0 })); } catch { /* storage may be blocked */ } };
    const label = () => { const t = wanted ? btn.dataset.pause! : btn.dataset.play!; btn.setAttribute('aria-pressed', String(wanted)); btn.setAttribute('aria-label', t); btn.title = t; };
    const ramp = (to: number, ms: number, done?: () => void) => {
      if (!eng) return; cancelAnimationFrame(fade);
      const e = eng, from = e.vol(), t0 = performance.now();
      const step = (now: number) => { const k = Math.min(1, (now - t0) / ms); e.vol(from + (to - from) * k); if (k < 1) fade = requestAnimationFrame(step); else done?.(); };
      fade = requestAnimationFrame(step);
    };
    const GAIN = 0.45;

    // ---- engine 1: a sound file ----
    const fileEngine = (src: string): Engine => {
      const a = new Audio(src); a.loop = true; a.preload = 'auto'; a.volume = 0;
      const t = read().t; if (t) a.addEventListener('loadedmetadata', () => { try { a.currentTime = t % (a.duration || t + 1); } catch { /* ignore */ } }, { once: true });
      return { play: () => a.play().then(() => true).catch(() => false), pause: () => a.pause(), vol: (v) => { if (v !== undefined) a.volume = Math.min(1, Math.max(0, v)); return a.volume; }, time: () => a.currentTime };
    };

    // ---- engine 2: YouTube's embedded player ----
    const ytEngine = (id: string): Engine => {
      const card = document.getElementById('mu-card')!;
      let player: any = null, playing = false, volume = 0, apiP: Promise<void> | null = null;
      const api = () => apiP ??= new Promise<void>((res) => {
        if ((window as any).YT?.Player) return res();
        const prev = (window as any).onYouTubeIframeAPIReady;
        (window as any).onYouTubeIframeAPIReady = () => { prev?.(); res(); };
        const sc = document.createElement('script'); sc.src = 'https://www.youtube.com/iframe_api'; document.head.append(sc);
      });
      return {
        play: async () => {
          card.hidden = false;
          await api();
          return new Promise<boolean>((resolve) => {
            let settled = false; const done = (ok: boolean) => { if (!settled) { settled = true; resolve(ok); } };
            setTimeout(() => done(playing), 5000);
            if (player) { player.playVideo(); const w = setInterval(() => { if (playing) { clearInterval(w); done(true); } }, 150); return; }
            const YT = (window as any).YT;
            player = new YT.Player('mu-yt', {
              host: 'https://www.youtube-nocookie.com', width: 200, height: 200, videoId: id,
              playerVars: { autoplay: 1, controls: 1, playsinline: 1, rel: 0, loop: 1, playlist: id, start: Math.floor(read().t || 0) },
              events: {
                onReady: (e: any) => { e.target.setVolume(0); e.target.playVideo(); },
                onStateChange: (e: any) => { playing = e.data === 1; if (playing) done(true); },
                onAutoplayBlocked: () => done(false),
              },
            });
          });
        },
        pause: () => { try { player?.pauseVideo(); } catch { /* ignore */ } },
        vol: (v) => { if (v !== undefined) { volume = Math.min(1, Math.max(0, v)); try { player?.setVolume(Math.round(volume * 100)); } catch { /* ignore */ } } return volume; },
        time: () => { try { return player?.getCurrentTime?.() ?? 0; } catch { return 0; } },
        hide: () => { card.hidden = true; },
      };
    };

    const ensure = () => (eng ??= btn.dataset.src ? fileEngine(btn.dataset.src) : ytEngine(btn.dataset.yt!));
    const start = () => ensure().play().then((ok) => { if (ok) ramp(GAIN, 1800); return ok; });
    const stop = () => ramp(0, 900, () => { eng?.pause(); eng?.hide?.(); });
    btn.addEventListener('click', async () => {
      if (wanted) { wanted = false; stop(); } else { wanted = true; await start(); }
      label(); write();
    });
    // the visitor turned it on on an earlier page: try to carry on; if the browser still wants a click, wait for the first one
    if (read().on) {
      wanted = true; label();
      start().then((ok) => {
        if (ok) return;
        const resume = () => { if (wanted) start(); };
        ['pointerdown', 'keydown', 'touchstart'].forEach((e) => addEventListener(e, resume, { once: true, passive: true }));
      });
    }
    document.addEventListener('visibilitychange', () => {
      if (!eng) return;
      if (document.hidden) { eng.pause(); write(); } else if (wanted) start();
    });
    addEventListener('pagehide', write);
    setInterval(() => { if (eng && wanted) write(); }, 4000);
  }
</script>
