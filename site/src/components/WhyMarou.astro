<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // scroll progress through a sticky track (0..1) -> --p on the track
  const progress = (track: HTMLElement, hold = 0.85) => {
    const r = track.getBoundingClientRect();
    return Math.min(1, Math.max(0, -r.top / ((r.height - innerHeight) * hold)));
  };
  const road = document.querySelector<HTMLElement>('[data-road]');
  const box = document.querySelector<HTMLElement>('[data-box]');
  const svg = document.querySelector<SVGSVGElement>('.hills');
  const jeep = document.querySelector<SVGGElement>('[data-jeep]');
  const txt = document.querySelector<SVGTextElement>('.r-text');
  const tp = document.querySelector<SVGTextPathElement>('[data-tp]');
  const m1 = document.querySelector<SVGRectElement>('[data-m1]');
  const m2 = document.querySelector<SVGRectElement>('[data-m2]');
  const line = document.getElementById('road-line') as unknown as SVGPathElement | null;
  const L = line?.getTotalLength() ?? 0;
  // The scene keeps its proportions at every width: the viewBox shows as much of the 1440-wide road as fits the box.
  let vw = 1440, x0 = 0, k = 1;
  const lenAtX = (x: number) => {
    let lo = 0, hi = L;
    for (let i = 0; i < 22; i++) { const mid = (lo + hi) / 2; if (line!.getPointAtLength(mid).x < x) lo = mid; else hi = mid; }
    return hi;
  };
  const fit = () => {
    if (!svg || !line) return;
    const r = svg.getBoundingClientRect();
    if (!r.width || !r.height) return;
    vw = Math.min(1440, (300 * r.width) / r.height); x0 = (1440 - vw) / 2; k = r.width / vw;
    svg.setAttribute('viewBox', `${x0} 0 ${vw} 300`);
    // the line of text lies along the road, a little above it, starting a fifth into the picture
    const px = Math.min(31, Math.max(16.8, innerWidth * 0.024));
    txt?.setAttribute('font-size', String(px / k));
    document.querySelector('[data-tl]')?.setAttribute('transform', `translate(0,${-(px * 1.7) / k})`);
    tp?.setAttribute('startOffset', String(lenAtX(x0 + vw * 0.2)));
  };
  // p = 0..1: the car drives in from the left edge and stops near the right; the text appears softly behind it
  const place = (p: number) => {
    if (!jeep || !line || !svg) return;
    const carPx = Math.min(150, Math.max(75, innerWidth * 0.085));
    const s = carPx / (120 * k);
    const xs = Math.min(1438, Math.max(2, (x0 - 60 * s) + p * (vw * 0.86 + 60 * s)));
    const a = lenAtX(xs - 12), b = lenAtX(xs + 12);
    const pa = line.getPointAtLength(a), pb = line.getPointAtLength(b), pt = line.getPointAtLength(lenAtX(xs));
    const ang = Math.max(-14, Math.min(14, (Math.atan2(pb.y - pa.y, pb.x - pa.x) * 180) / Math.PI));
    jeep.setAttribute('transform', `translate(${pt.x},${pt.y}) rotate(${ang}) scale(${s})`);
    // reveal everything behind the car, with a soft edge
    const edge = pt.x - 30 * s, feather = 70 / Math.max(.5, k);
    m1?.setAttribute('width', String(Math.max(0, edge - feather)));
    m2?.setAttribute('x', String(Math.max(0, edge - feather)));
    m2?.setAttribute('width', String(feather));
  };
  fit();
  if (reduce) { place(0.62); box?.style.setProperty('--p', '1'); addEventListener('resize', () => { fit(); place(0.62); }); }
  else {
    const update = () => {
      if (road) { const p = progress(road); road.style.setProperty('--p', p.toFixed(4)); place(p); }
      if (box) box.style.setProperty('--p', progress(box, 0.8).toFixed(4));
    };
    let raf = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', () => { fit(); update(); });
    update();
  }
</script>

<script>
  // Values: the statement and the three cards turn up one after another.
  // Wide screens: a tall scene with a sticky stage; the scroll position decides how many have turned up. Phones: each one turns up when it reaches the screen.
  const reduce2 = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = matchMedia('(min-width: 900px)');
  document.querySelectorAll<HTMLElement>('[data-seq]').forEach((track) => {
    const items = [...track.querySelectorAll<HTMLElement>('[data-s]')];
    if (reduce2) { items.forEach((i) => i.classList.add('on')); return; }
    const update = () => {
      if (!wide.matches) return;
      const r = track.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
      items.forEach((it, i) => it.classList.toggle('on', p >= 0.08 + i * (0.72 / items.length)));
    };
    let raf = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting && !wide.matches) { e.target.classList.add('on'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -16% 0px', threshold: 0.12 });
    items.forEach((i) => io.observe(i));
  });

  // Story: the dotted road is drawn downwards as the section scrolls past
  const wm = document.querySelector<SVGPathElement>('[data-wm]');
  const story = document.querySelector<HTMLElement>('.story');
  if (wm && story) {
    const draw = () => {
      const r = story.getBoundingClientRect();
      const p = reduce2 ? 1 : Math.min(1, Math.max(0, (innerHeight * 0.7 - r.top) / (r.height * 0.85)));
      wm.style.strokeDashoffset = String(1 - p);
    };
    addEventListener('scroll', draw, { passive: true }); addEventListener('resize', draw); draw();
  }

  // Vision: appears only after the visitor has scrolled further down
  const late = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); late.unobserve(e.target); } }), { rootMargin: '0px 0px -30% 0px', threshold: 0.2 });
  document.querySelectorAll('[data-late]').forEach((el) => late.observe(el));
</script>

<script>
  // Contact: a gift box on wheels drives from the left edge to the right edge along the hills as the page is scrolled; the words appear behind it (left to right)
  const ct = document.querySelector<HTMLElement>('[data-ct]');
  const car = document.querySelector<SVGSVGElement>('[data-ct-car]');
  const roadEl = document.querySelector<HTMLElement>('.ct-road');
  const hill = document.querySelector<SVGPathElement>('[data-ct-line]');
  if (ct && car && roadEl && hill) {
    const L = hill.getTotalLength();
    const lenAtX = (x: number) => { let lo = 0, hi = L; for (let i = 0; i < 22; i++) { const m = (lo + hi) / 2; if (hill.getPointAtLength(m).x < x) lo = m; else hi = m; } return hi; };
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const place = (q: number) => {
      const w = roadEl.clientWidth, h = roadEl.clientHeight, cw = car.getBoundingClientRect().width || 90;
      const vx = Math.min(1440, Math.max(0, q * 1440));
      const a = hill.getPointAtLength(lenAtX(Math.max(0, vx - 12))), b = hill.getPointAtLength(lenAtX(Math.min(1440, vx + 12))), pt = hill.getPointAtLength(lenAtX(vx));
      const sx = w / 1440, sy = h / 120;
      const ang = Math.max(-14, Math.min(14, (Math.atan2((b.y - a.y) * sy, (b.x - a.x) * sx) * 180) / Math.PI));
      const px = pt.x * sx - cw / 2, py = pt.y * sy - car.getBoundingClientRect().height + 4;
      car.style.transform = `translate(${px}px, ${py}px) rotate(${ang}deg)`;
      ct.style.setProperty('--q', String(Math.min(1.15, Math.max(0, (px + cw * 0.5) / w)).toFixed(4)));
    };
    const update = () => {
      const r = ct.getBoundingClientRect();
      const p = still ? 1 : Math.min(1, Math.max(0, -r.top / ((r.height - innerHeight) * 0.78)));
      place(-0.06 + p * 1.12);
      if (p >= 1) ct.style.setProperty('--q', '1.15');
    };
    let raf = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
