    .soc-collage .mp { position: absolute; margin: 0; }
    .soc-collage .mp :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .soc-collage .mp:nth-child(6) { z-index: 2; }
    .soc-in h4 { margin: .3rem 0 .7rem; }
    .soc-in .gk { font-size: clamp(2.6rem, 5vw, 4.6rem); }
      .g-brunch { grid-template-columns: 1fr; padding-bottom: 0; }
    .close-in { grid-template-columns: 6fr 6fr; column-gap: clamp(2rem, 5vw, 6rem); align-items: start; }
    .close-in { grid-template-columns: repeat(12, 1fr); }
    .c-mid { grid-column: 1 / 7; grid-row: 1; } .c-first { grid-column: 1 / 7; grid-row: 2; margin-top: clamp(1.5rem, 3vw, 3rem); }
    .c-end { grid-column: 8 / 13; grid-row: 1 / 3; align-self: center; }
  }

  /* the Brunch catalogue as a book */
  .bk { border: 0; padding: 0; margin: 0; width: 100%; height: 100%; max-width: none; max-height: none; background: rgb(247 245 240 / .74); color: var(--ink); backdrop-filter: blur(16px) saturate(1.05); -webkit-backdrop-filter: blur(16px) saturate(1.05); overflow: hidden; }
  .bk::backdrop { background: transparent; }
  .bk[open] { display: grid; grid-template-columns: 4.5rem 1fr 4.5rem; align-items: center; justify-items: center; animation: bkin .5s var(--ease); }
  @keyframes bkin { from { opacity: 0; } to { opacity: 1; } }
  .bk-stage { grid-column: 2; width: 100%; height: 100%; display: grid; place-items: center; perspective: 2600px; --ph: min(84svh, 52rem, calc((100vw - 11rem) / 1.24)); --pw: calc(var(--ph) * .6192); }
  .bk-p, .bk-n, .bk-x { appearance: none; border: 0; background: transparent; color: inherit; cursor: pointer; display: grid; place-items: center; width: 3.2rem; height: 3.2rem; }
  .bk-p { grid-column: 1; grid-row: 1; } .bk-n { grid-column: 3; grid-row: 1; }
  .bk-x { position: absolute; right: .9rem; top: .9rem; z-index: 5; }
  .bk-p:hover, .bk-n:hover, .bk-x:hover { color: var(--pink); }
  .bk-p:disabled, .bk-n:disabled { opacity: .22; cursor: default; }
  .bk-count { position: absolute; left: 0; right: 0; bottom: 1rem; text-align: center; font-size: .78rem; letter-spacing: .16em; color: var(--ink-soft); }
  .bk-book { position: relative; width: calc(var(--pw) * 2); height: var(--ph); transform-style: preserve-3d; transition: transform .9s var(--ease); cursor: pointer; }
  .bk-book.single { width: var(--pw); }
  .bk-book :global(.bk-leaf) { position: absolute; left: 50%; top: 0; width: 50%; height: 100%; transform-origin: left center; transform-style: preserve-3d; transition: transform 1s cubic-bezier(.55, .08, .25, 1); }
  .bk-book.single :global(.bk-leaf) { left: 0; width: 100%; }
  .bk-book :global(.bk-leaf.fl) { transform: rotateY(-180deg); }
  .bk-book :global(.bk-face) { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; background: #4a3222; overflow: hidden; box-shadow: 0 .6rem 1.8rem rgb(0 0 0 / .28); }
  .bk-book :global(.bk-face.back) { transform: rotateY(180deg); }
  .bk-book :global(.bk-face img) { display: block; width: 100%; height: 100%; object-fit: cover; user-select: none; -webkit-user-drag: none; }
  .bk-book :global(.bk-face)::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgb(0 0 0 / .22), transparent 9%); }
  .bk-book :global(.bk-face.back)::after { background: linear-gradient(270deg, rgb(0 0 0 / .22), transparent 9%); }
  @media (max-width: 760px) {
    .bk[open] { grid-template-columns: 2.6rem 1fr 2.6rem; }
    .bk-p, .bk-n { width: 2.6rem; }
    .bk-stage { --ph: min(80svh, calc((100vw - 6.5rem) / .6192)); }
  }
  @media (prefers-reduced-motion: reduce) { .bk-leaf, .bk-book { transition: none; } .bk[open] { animation: none; } }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // photos of 01 On social turn up one after another (those that enter the screen together are staggered)
  const soc = [...document.querySelectorAll<HTMLElement>('#k-mono .soc-collage .rvl')];
  if (soc.length) {
    const io = new IntersectionObserver((es) => {
      const hit = es.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement).sort((a, b) => soc.indexOf(a) - soc.indexOf(b));
      hit.forEach((el, i) => { io.unobserve(el); setTimeout(() => el.classList.add('on'), still ? 0 : i * 170); });
    }, { threshold: 0.15, rootMargin: '0px 0px -6% 0px' });
    soc.forEach((el) => io.observe(el));
  }
  // the closing page: the first line, then the other two together
  const lines = [...document.querySelectorAll<HTMLElement>('#k-mono .close-in .wr-in')];
  if (lines.length) {
    const cio = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      cio.disconnect();
      lines.forEach((el, i) => setTimeout(() => el.classList.add('on'), still ? 0 : (i === 0 ? 0 : 1500)));   // "It’s not just…" first; "Here, a customer…" and "And it showed me…" together
    }, { threshold: 0.35 });
    cio.observe(document.querySelector('#k-mono .close-in')!);
  }
  // the guest-card deck: a small widget of its own. Buttons, a swipe / drag, or the arrow keys move through the cards; it never uses the page scroll.
  // The front card opens in the viewer; a click on a card behind it brings that card to the front.
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  if (deck) {
    const cards = [...deck.querySelectorAll<HTMLElement>('.dk-cards li')];
    const count = deck.querySelector<HTMLElement>('.dk-n');
    let f = 0;
    const render = () => {
      cards.forEach((li, i) => {
        const d = i - f;
        if (d < 0) { // already seen: slips away to the left
          li.style.cssText = `--z:${i};--o:0;--x:-70%;--y:0px;--r:-9deg;--s:.94;--pe:none`;
        } else {
          li.style.cssText = `--z:${100 - d};--o:${d > 3 ? 0 : (1 - d * 0.18).toFixed(2)};--x:${d * 3}%;--y:${d * 2.2}rem;--r:${d ? ((i % 2 ? 1 : -1) * d * 1.2).toFixed(1) : 0}deg;--s:${(1 - d * 0.05).toFixed(3)};--pe:${d > 3 ? 'none' : 'auto'}`;
        }
      });
      if (count) count.textContent = `${f + 1} / ${cards.length}`;
    };
    const go = (n: number) => { f = Math.min(cards.length - 1, Math.max(0, n)); render(); };
    deck.querySelector('.dk-next')?.addEventListener('click', () => go(f + 1));
    deck.querySelector('.dk-prev')?.addEventListener('click', () => go(f - 1));
    deck.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); go(f + 1); } if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); go(f - 1); } });
    // a click on a card behind the front one: bring it forward (capture phase, so the viewer does not open)
    cards.forEach((li, i) => li.addEventListener('click', (e) => { if (i !== f) { e.stopPropagation(); e.preventDefault(); go(i); } }, true));
    // swipe / drag sideways
    let x0 = 0, y0 = 0, moved = false, down = false;
    deck.querySelector('.dk-cards')!.addEventListener('pointerdown', (e) => { const p = e as PointerEvent; down = true; moved = false; x0 = p.clientX; y0 = p.clientY; });
    addEventListener('pointerup', (e) => {
      if (!down) return; down = false;
      const dx = (e as PointerEvent).clientX - x0, dy = (e as PointerEvent).clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) { moved = true; go(f + (dx < 0 ? 1 : -1)); }
    });
    deck.addEventListener('click', (e) => { if (moved) { e.stopPropagation(); e.preventDefault(); moved = false; } }, true);
    render();
  }

  // The Brunch catalogue as a book: the cover opens it, the pages turn one by one (buttons, arrow keys, a click on either page, or a swipe).
  // Wide screens show a spread of two pages; narrow screens show one page at a time.
  const bk = document.getElementById('bk') as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLElement>('[data-book]');
  if (bk && opener) {
    const pages: { src: string; alt: string }[] = JSON.parse(bk.dataset.pages || '[]');
    const book = bk.querySelector<HTMLElement>('.bk-book')!;
    const prevB = bk.querySelector<HTMLButtonElement>('.bk-p')!, nextB = bk.querySelector<HTMLButtonElement>('.bk-n')!, count = bk.querySelector<HTMLElement>('.bk-count')!;
    let leaves: HTMLElement[] = [], s = 0, single = false;
    const img = (p: { src: string; alt: string }, eager: boolean) => { const i = document.createElement('img'); i.src = p.src; i.alt = p.alt; i.loading = eager ? 'eager' : 'lazy'; i.decoding = 'async'; i.draggable = false; return i; };
    const face = (cls: string, p?: { src: string; alt: string }) => { const f = document.createElement('div'); f.className = `bk-face ${cls}`; if (p) f.append(img(p, true)); return f; };
    const build = () => {
      single = innerWidth < 760;
      book.classList.toggle('single', single);
      book.replaceChildren(); leaves = [];
      const per = single ? 1 : 2, n = Math.ceil(pages.length / per);
      for (let i = 0; i < n; i++) {
        const leaf = document.createElement('div'); leaf.className = 'bk-leaf';
        leaf.append(face('front', pages[i * per]));
        if (!single) leaf.append(face('back', pages[i * 2 + 1]));
        book.append(leaf); leaves.push(leaf);
      }
    };
    const last = () => leaves.length - 1;   // the last leaf never turns
    const render = (moved = -1) => {
      leaves.forEach((l, i) => {
        l.classList.toggle('fl', i < s);
        l.style.zIndex = String(i === moved ? leaves.length + 5 : (i < s ? i + 1 : leaves.length - i));
      });
      if (moved > -1) setTimeout(() => { leaves.forEach((l, i) => { l.style.zIndex = String(i < s ? i + 1 : leaves.length - i); }); }, 1000);
      book.style.transform = single ? '' : s === 0 ? 'translateX(-25%)' : '';
      prevB.disabled = s === 0; nextB.disabled = s === last();
      const total = pages.length;
      count.textContent = single ? `${s + 1} / ${total}` : s === 0 ? `1 / ${total}` : `${2 * s}–${Math.min(total, 2 * s + 1)} / ${total}`;
    };
    const turn = (d: number) => { const to = Math.min(last(), Math.max(0, s + d)); if (to === s) return; const moved = d > 0 ? s : to; s = to; render(moved); };
    opener.addEventListener('click', () => { build(); s = 0; render(); bk.showModal(); document.documentElement.classList.add('sp-open'); nextB.focus({ preventScroll: true }); });
    const close = () => { bk.close(); document.documentElement.classList.remove('sp-open'); opener.focus(); };
    bk.querySelector('.bk-x')!.addEventListener('click', close);
    prevB.addEventListener('click', () => turn(-1));
    nextB.addEventListener('click', () => turn(1));
    bk.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    bk.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') turn(1); if (e.key === 'ArrowLeft') turn(-1); });
    // a click on the right half turns forward, on the left half back; the empty space around the book closes it
    book.addEventListener('click', (e) => { if (moved) return; const r = book.getBoundingClientRect(); const mid = single ? r.left + r.width / 2 : r.left + r.width / 2; turn(e.clientX >= mid ? 1 : -1); });
    bk.addEventListener('click', (e) => { const t = e.target as HTMLElement; if (t === bk || t.classList.contains('bk-stage')) close(); });
    // swipe
    let x0 = 0, down = false, moved = false;
    book.addEventListener('pointerdown', (e) => { down = true; moved = false; x0 = (e as PointerEvent).clientX; });
    addEventListener('pointerup', (e) => { if (!down) return; down = false; const dx = (e as PointerEvent).clientX - x0; if (Math.abs(dx) > 50) { moved = true; turn(dx < 0 ? 1 : -1); setTimeout(() => (moved = false), 50); } });
    addEventListener('resize', () => { if (bk.open) { const t = s; build(); s = Math.min(t, last()); render(); } });
  }
</script>
